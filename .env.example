# Copy this file to .env and fill in secrets locally. Never commit .env.

# Default KUMA Case/Judge SDK. Either key is accepted; use the one issued to you.
KUMA_API_KEY=

# Agent LLM upstream. Model slug is required; the example below is not a runtime default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional separate model for `agent add -b`; must support strict structured outputs.
# Fallback is OPENROUTER_MODEL; --build-model and build settings model take precedence.
# OPENROUTER_BUILD_MODEL=

# Required by the ReAct and Company Research Agents for web search.
TAVILY_API_KEY=

# Qwen Code (native ACP, separate from the benchmark/Judge model).
# QWEN_API_KEY=
# QWEN_MODEL=qwen3-coder-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# The model is an example, not a default; use an ID available to your API key.
# Custom gateways also need an explicit Chat Completions route in its agent.toml.

# Maximum Case tests running at once, including Cases of the same Agent. Set 4 for four Case workers.
ABB_MAX_PARALLEL_CASES=1
