# Copy this file to .env and fill in secrets locally. Never commit .env.

# Default KUMA Case/Judge SDK. KUMA_API_KEY is the name the KUMA SDK documents.
# ABB also accepts DEFUZEX_API_KEY as an alias, used only when KUMA_API_KEY is empty.
KUMA_API_KEY=

# Agent LLM upstream. OPENROUTER_MODEL is required and has no default: the value
# below is an example. Use a model your account can call.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Required by both bundled Agents (ReAct and Company Research) for web search.
TAVILY_API_KEY=

# Maximum Case tests running at once, including Cases of the same Agent. Set 4 for four Case workers.
ABB_MAX_PARALLEL_CASES=1
