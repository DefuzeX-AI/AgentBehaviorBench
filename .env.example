# Copy to .env. Fill only the sections for the Agents you use.
# This template selects DeepSeek Flash for shared Agents and Exp1/Exp3 oracles.
# Without an explicit provider: OpenRouter -> DeepSeek -> GLM, first non-empty key.
# Applies to replacement-mode Agents and ACP Agents 15-32 and 36 (no [model] needed).
# Provider-constrained Agents keep their own sections below; tool keys stay independent.
# See docs/Model-Selection.md for constraints and explicit provider/model overrides.

# Parallel Case workers
ABB_MAX_PARALLEL_CASES=1
ABB_MAX_PARALLEL_JUDGES=2
ABB_JUDGE_QUEUE_CAPACITY=8

# KUMA evaluation SDK
# API key: https://defuzex.ai/
KUMA_API_KEY=

# 01-folder-mover-agent, 56-company-research-agent, 57-react-agent, 02-ai-hedge-fund-crypto,
# 03-labscript-ai, 04-multi-agent-cad, 05-autoresearch-agents,
# 06-langchain-streamlit-template, 58-curiosity, 07-readwren, 08-tablegpt-agent
# Shared model auto-selection: OpenRouter -> DeepSeek -> GLM (first non-empty key).
# OPENROUTER_API_KEY is also used by: agent add -b
# API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Shared provider selection/configuration (replacement mode, shared ACP, Exp1/Exp3 oracles).
# To use DeepSeek (DS) even when an OpenRouter key is set, select deepseek.
# An agent.toml [model] provider pin takes precedence over this global selection.
# Dedicated native Agent credentials are unaffected by this selection.
ABB_MODEL_PROVIDER=deepseek
# ABB_MODEL_PROVIDERS_CONFIG=/absolute/path/to/model-providers.toml
# ABB_MODEL=your-model-id

# DeepSeek (DS): selected by default in this template.
# Use an official DeepSeek key; an OpenRouter key cannot be used here.
# Model example: deepseek-flash. Enter an ID supported by your account and Agent.
# API key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 56-company-research-agent, 57-react-agent, 58-curiosity (web search)
# API key: https://app.tavily.com/
TAVILY_API_KEY=

# 09-minimax-code: dedicated MiniMax integration; shared keys do not replace this key.
# API key: https://platform.minimax.io/
MINIMAX_API_KEY=

# 10-claude-agent-acp: requires its configured Anthropic Messages endpoint.
# Provider settings: ask your provider administrator.
# Setup: resources/agents/10-claude-agent-acp/README.md
CODEX_API_KEY=
CODEX_API_BASE_URL=
CODEX_MODEL=

# 11-qwen-code: native web_search also requires DashScope Responses and its key.
# API key: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-coder-plus

# GLM: optional shared provider when OpenRouter/DeepSeek keys are empty, or explicitly selected.
# Standard API base: https://open.bigmodel.cn/api/paas/v4
# API key: https://open.bigmodel.cn/
# Model: enter a model ID available to your account.
GLM_API_KEY=
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=
# Optional private service for NVIDIA Biomedical AI-Q Research Agent.
# Generate a random 64-hex-character value; never reuse your NVIDIA API key.
RAG_API_KEY=
AIRA_RAG_URL=http://host.docker.internal:8081/v1

# Optional: extend first-time Docker build and overall preparation budgets.
# ABB_RUNTIME_BUILD_TIMEOUT_SEC=7200
# ABB_RUNTIME_PREPARATION_TIMEOUT_SEC=9000

# Per-Input Agent response copying, including full traces (positive integers).
# These are disk-streaming budgets, separate from SDK/API submission limits.
# ABB_AGENT_RESPONSE_MAX_BYTES=1073741824
# ABB_AGENT_RESPONSE_MAX_FILES=20000
