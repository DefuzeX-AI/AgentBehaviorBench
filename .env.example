# Copy to .env. Fill only the sections for the Agents you use.

# Parallel Case workers
ABB_MAX_PARALLEL_CASES=1
ABB_MAX_PARALLEL_JUDGES=2
ABB_JUDGE_QUEUE_CAPACITY=8

# KUMA evaluation SDK
# API key: https://defuzex.ai/
KUMA_API_KEY=

# 01-folder-mover-agent, 02-company-research-agent, 03-react-agent, 04-ai-hedge-fund-crypto,
# 05-labscript-ai, 06-multi-agent-cad, 07-autoresearch-agents,
# 08-langchain-streamlit-template, 09-curiosity, 10-readwren, 11-tablegpt-agent
# Replacement target auto-selection: OpenRouter -> DeepSeek -> GLM (first non-empty key).
# OPENROUTER_API_KEY is also used by: agent add -b
# API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional replacement target provider selection/configuration.
# ABB_MODEL_PROVIDER=deepseek
# ABB_MODEL_PROVIDERS_CONFIG=/absolute/path/to/model-providers.toml
# ABB_MODEL=your-model-id

# DeepSeek direct API replacement target (model ID available to your account).
# API key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 02-company-research-agent, 03-react-agent, 09-curiosity (web search)
# API key: https://app.tavily.com/
TAVILY_API_KEY=

# 12-minimax-code
# API key: https://platform.minimax.io/
MINIMAX_API_KEY=

# 13-claude-agent-acp
# Provider settings: ask your provider administrator.
# Setup: resources/agents/13-claude-agent-acp/README.md
CODEX_API_KEY=
CODEX_API_BASE_URL=
CODEX_MODEL=

# 14-qwen-code (Qwen via DashScope, standard China API)
# API key: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-coder-plus

# 15-opencode, 16-kilo-code, 17-goose, 18-cline, 19-kimi-cli,
# 20-pi-coding-agent, 21-copilot-cli, 22-openclaw, 23-hermes-agent,
# 24-openhands, 25-deepagents-code
# Also used as the GLM replacement target when higher-priority keys are empty.
# Standard API base: https://open.bigmodel.cn/api/paas/v4
# The Coding Plan endpoint below is retained for the native coding Agents.
# API key: https://open.bigmodel.cn/
# Model: enter a model ID available to your account.
GLM_API_KEY=
GLM_API_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=
# Optional private service for NVIDIA Biomedical AI-Q Research Agent.
# Generate a random 64-hex-character value; never reuse your NVIDIA API key.
RAG_API_KEY=
AIRA_RAG_URL=http://host.docker.internal:8081/v1

# Optional: extend first-time Docker build and overall preparation budgets.
# ABB_RUNTIME_BUILD_TIMEOUT_SEC=7200
# ABB_RUNTIME_PREPARATION_TIMEOUT_SEC=9000
