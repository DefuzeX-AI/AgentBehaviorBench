# Copy to .env. Fill only the sections for the Agents you use.

# Parallel Case workers
ABB_MAX_PARALLEL_CASES=1

# KUMA evaluation SDK
# API key: https://defuzex.ai/
KUMA_API_KEY=

# 01-folder-mover-agent, 02-company-research-agent, 03-react-agent, 04-ai-hedge-fund-crypto,
# 05-labscript-ai, 06-multi-agent-cad, 09-autoresearch-agents,
# 10-langchain-streamlit-template, 11-curiosity, 13-readwren, 14-tablegpt-agent
# Also used by: agent add -b
# API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# 02-company-research-agent, 03-react-agent, 11-curiosity (web search)
# API key: https://app.tavily.com/
TAVILY_API_KEY=

# 16-minimax-code
# API key: https://platform.minimax.io/
MINIMAX_API_KEY=

# 17-claude-agent-acp
# Provider settings: ask your provider administrator.
# Setup: resources/agents/17-claude-agent-acp/README.md
CODEX_API_KEY=
CODEX_API_BASE_URL=
CODEX_MODEL=

# 18-qwen-code (Qwen via DashScope, standard China API)
# API key: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-coder-plus

# 19-opencode, 20-kilo-code, 21-goose, 22-cline, 23-kimi-cli,
# 24-pi-coding-agent, 25-copilot-cli, 26-openclaw, 27-hermes-agent,
# 28-openhands, 29-deepagents-code
# API key: https://open.bigmodel.cn/
# Model: enter a model ID available to your account.
GLM_API_KEY=
GLM_API_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=
