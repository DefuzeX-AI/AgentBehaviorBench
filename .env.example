# Copy this file to .env and fill in secrets locally. Never commit .env.

# Default KUMA Case/Judge SDK. Either key is accepted; use the one issued to you.
KUMA_API_KEY=
# DEFUZEX_API_KEY=

# Agent LLM upstream
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Required by the bundled Company Research Agent for web search.
TAVILY_API_KEY=

# Optional OpenRouter configuration
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=AgentBehaviorBench
