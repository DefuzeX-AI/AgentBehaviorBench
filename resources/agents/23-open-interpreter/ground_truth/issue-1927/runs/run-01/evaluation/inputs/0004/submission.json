        "diff": "--- /home/agent/workspace/migration/schema.sql\n+++ /home/agent/workspace/migration/schema.sql\n@@ -4,3 +4,18 @@\n     total_amount NUMERIC(12, 2) NOT NULL,\n     tax_amount NUMERIC(12, 2) GENERATED ALWAYS AS (total_amount * 0.10) STORED\n );\n+\n+CREATE OR REPLACE FUNCTION set_order_status_on_amount_update()\n+RETURNS TRIGGER AS $$\n+BEGIN\n+    IF NEW.total_amount > 1000 THEN\n+        NEW.status := 'processed';\n+    END IF;\n+    RETURN NEW;\n+END;\n+$$ LANGUAGE plpgsql;\n+\n+CREATE TRIGGER set_order_status_on_amount_update\n+BEFORE UPDATE OF total_amount ON orders\n+FOR EACH ROW\n+EXECUTE FUNCTION set_order_status_on_amount_update();\n"
