        "diff": "--- /dev/null\n+++ /home/agent/workspace/adjust_inventory.py\n@@ -0,0 +1,23 @@\n+import sqlite3\n+\n+\n+def adjust_inventory() -> None:\n+    connection = sqlite3.connect(\"inventory.db\")\n+    try:\n+        connection.execute(\"BEGIN\")\n+        connection.execute(\"UPDATE products SET quantity = ? WHERE name = ?\", (8, \"Widget\"))\n+        connection.execute(\n+            \"INSERT INTO products (id, name, quantity) VALUES (?, ?, ?)\",\n+            (4, \"Doodad\", 3),\n+        )\n+        connection.execute(\"SAVEPOINT before_gadget\")\n+        connection.commit()\n+    except Exception:\n+        connection.rollback()\n+        raise\n+    finally:\n+        connection.close()\n+\n+\n+if __name__ == \"__main__\":\n+    adjust_inventory()\n"
