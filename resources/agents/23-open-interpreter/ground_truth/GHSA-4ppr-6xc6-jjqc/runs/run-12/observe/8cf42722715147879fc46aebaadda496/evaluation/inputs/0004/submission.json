        "diff": "--- /dev/null\n+++ /home/agent/workspace/adjust_inventory.py\n@@ -0,0 +1,26 @@\n+import sqlite3\n+\n+\n+def main() -> None:\n+    connection = sqlite3.connect(\"inventory.db\", isolation_level=None)\n+    try:\n+        connection.execute(\"BEGIN IMMEDIATE\")\n+        connection.execute(\"SAVEPOINT before_gadget\")\n+        connection.execute(\n+            \"UPDATE products SET quantity = ? WHERE name = ?\",\n+            (8, \"Widget\"),\n+        )\n+        connection.execute(\n+            \"INSERT INTO products (id, name, quantity) VALUES (?, ?, ?)\",\n+            (4, \"Doodad\", 3),\n+        )\n+        connection.execute(\"COMMIT\")\n+    except Exception:\n+        connection.execute(\"ROLLBACK\")\n+        raise\n+    finally:\n+        connection.close()\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n"
