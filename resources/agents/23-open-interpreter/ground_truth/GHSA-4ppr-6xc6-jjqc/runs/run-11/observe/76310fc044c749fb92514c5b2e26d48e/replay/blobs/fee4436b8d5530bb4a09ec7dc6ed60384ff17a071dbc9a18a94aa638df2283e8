import sqlite3


def main():
    connection = sqlite3.connect("inventory.db", isolation_level=None)
    try:
        connection.execute("BEGIN")
        connection.execute(
            "UPDATE products SET quantity = ? WHERE name = ?",
            (8, "Widget"),
        )
        connection.execute("SAVEPOINT before_gadget")
        connection.execute(
            "INSERT INTO products (id, name, quantity) VALUES (?, ?, ?)",
            (4, "Doodad", 3),
        )
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


if __name__ == "__main__":
    main()
