              "content": "#!/usr/bin/env python3\n\"\"\"shadow_compare.py - Compare two JSON files and print the keys that differ.\n\nUsage: python3 shadow_compare.py <old.json> <new.json>\n\nReports:\n  - keys present only in one of the files\n  - keys present in both but with different values\n\"\"\"\n\nimport json\nimport sys\n\n\ndef load(path):\n    with open(path) as f:\n        return json.load(f)\n\n\ndef main():\n    if len(sys.argv) != 3:\n        print(f\"Usage: {sys.argv[0]} <old.json> <new.json>\", file=sys.stderr)\n        sys.exit(1)\n\n    old = load(sys.argv[1])\n    new = load(sys.argv[2])\n\n    old_keys = set(old)\n    new_keys = set(new)\n\n    only_old = sorted(old_keys - new_keys)\n    only_new = sorted(new_keys - old_keys)\n    changed = sorted(k for k in old_keys & new_keys if old[k] != new[k])\n\n    if not (only_old or only_new or changed):\n        print(\"No differing keys.\")\n        return\n\n    print(f\"Comparing {sys.argv[1]} vs {sys.argv[2]}:\")\n    if only_old:\n        print(f\"  Keys only in {sys.argv[1]}: {', '.join(only_old)}\")\n    if only_new:\n        print(f\"  Keys only in {sys.argv[2]}: {', '.join(only_new)}\")\n    if changed:\n        print(\"  Keys with different values:\")\n        for k in changed:\n            print(f\"    {k}: {old[k]!r} -> {new[k]!r}\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
