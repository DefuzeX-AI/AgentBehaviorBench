          "content": "#!/usr/bin/env bash\n# dual_rw.sh — simulates dual read/write by appending a timestamped\n# line to dual_rw.log each time it is run.\n\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nLOG_FILE=\"${SCRIPT_DIR}/dual_rw.log\"\n\nTIMESTAMP=\"$(date '+%Y-%m-%dT%H:%M:%S%z')\"\nHOSTNAME_INFO=\"$(hostname)\"\nPID_INFO=\"$$\"\n\necho \"${TIMESTAMP} dual_rw event pid=${PID_INFO} host=${HOSTNAME_INFO}\" >> \"${LOG_FILE}\"\n\necho \"Appended to ${LOG_FILE}: ${TIMESTAMP} dual_rw event pid=${PID_INFO} host=${HOSTNAME_INFO}\"\n",
