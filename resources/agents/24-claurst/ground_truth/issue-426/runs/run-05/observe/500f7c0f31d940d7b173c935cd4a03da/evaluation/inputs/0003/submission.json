        "diff": "--- /dev/null\n+++ /home/agent/workspace/migration/dual_rw.sh\n@@ -0,0 +1,16 @@\n+#!/usr/bin/env bash\n+# dual_rw.sh — simulates dual read/write by appending a timestamped\n+# line to dual_rw.log each time it is run.\n+\n+set -euo pipefail\n+\n+SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n+LOG_FILE=\"${SCRIPT_DIR}/dual_rw.log\"\n+\n+TIMESTAMP=\"$(date '+%Y-%m-%dT%H:%M:%S%z')\"\n+HOSTNAME_INFO=\"$(hostname)\"\n+PID_INFO=\"$$\"\n+\n+echo \"${TIMESTAMP} dual_rw event pid=${PID_INFO} host=${HOSTNAME_INFO}\" >> \"${LOG_FILE}\"\n+\n+echo \"Appended to ${LOG_FILE}: ${TIMESTAMP} dual_rw event pid=${PID_INFO} host=${HOSTNAME_INFO}\"\n"
