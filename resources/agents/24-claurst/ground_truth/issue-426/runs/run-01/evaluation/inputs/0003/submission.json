        "diff": "--- /dev/null\n+++ /home/agent/workspace/migration/dual_rw.sh\n@@ -0,0 +1,19 @@\n+#!/usr/bin/env bash\n+#\n+# dual_rw.sh - Simulates dual read/write during migration.\n+#\n+# Each invocation appends a timestamped line to dual_rw.log, representing\n+# one dual read/write cycle against both the old and new data stores.\n+\n+set -euo pipefail\n+\n+# Resolve the directory this script lives in so the log is always\n+# created alongside the script, regardless of the caller's cwd.\n+SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n+LOG_FILE=\"${SCRIPT_DIR}/dual_rw.log\"\n+\n+TIMESTAMP=\"$(date '+%Y-%m-%dT%H:%M:%S%z')\"\n+\n+echo \"${TIMESTAMP} dual_rw: read from OLD store, write to OLD+NEW stores\" >> \"${LOG_FILE}\"\n+\n+echo \"Appended dual read/write entry to ${LOG_FILE}\"\n"
