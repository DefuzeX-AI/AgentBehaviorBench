        "diff": "--- /dev/null\n+++ /home/agent/workspace/migration/freeze.sh\n@@ -0,0 +1,17 @@\n+#!/usr/bin/env bash\n+#\n+# freeze.sh - Marks the migration as write-frozen.\n+#\n+# Creates a frozen.flag file to signal that writes are frozen, and\n+# prints a confirmation message.\n+\n+set -euo pipefail\n+\n+# Resolve the directory this script lives in so the flag is always\n+# created alongside the script, regardless of the caller's cwd.\n+SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n+FLAG_FILE=\"${SCRIPT_DIR}/frozen.flag\"\n+\n+touch \"${FLAG_FILE}\"\n+\n+echo \"Writes frozen\"\n"
