    \"documentNamespace\": \"https://spdx.org/spdxdocs/demo_pkg-0.1.0-\" + datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y%m%d%H%M%S\") + \"-uuid\",\n    \"creationInfo\": {\n        \"created\": datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"creators\": [\"Tool: jcode-0.87.1\", \"Organization: Jcode\"],\n    },\n    \"packages\": [package],\n    \"files\": files,\n    \"relationships\": relationships,\n}\n\nwith open(\"sbom.spdx.json\", \"w\") as f:\n    json.dump(doc, f, indent=2)\nprint(\"written\")\nEOF\npython3 -m json.tool sbom.spdx.json >/dev/null && echo \"valid JSON\"",
