{
  "command": "find / -maxdepth 4 \\( -iname \"*checklist*\" -o -iname \"*release*\" \\) -not -path \"/proc/*\" -not -path \"/sys/*\" -not -path \"/usr/*\" -not -path \"/opt/*\" -not -path \"/var/lib/*\" -not -path \"/etc/*\" -not -path \"*/node_modules/*\" 2>/dev/null | head -20",
  "intent": "Search filesystem broadly for any checklist or release-related files"
}