        "diff": "--- /dev/null\n+++ /home/agent/workspace/median.py\n@@ -0,0 +1,17 @@\n+def median(numbers):\n+    \"\"\"Return the median of a list of numbers.\n+\n+    - Odd-length list: the middle value after sorting.\n+    - Even-length list: the average of the two middle values after sorting.\n+    - Empty list: None.\n+    \"\"\"\n+    if not numbers:\n+        return None\n+\n+    sorted_numbers = sorted(numbers)\n+    n = len(sorted_numbers)\n+    mid = n // 2\n+\n+    if n % 2 == 1:\n+        return sorted_numbers[mid]\n+    return (sorted_numbers[mid - 1] + sorted_numbers[mid]) / 2\n"
