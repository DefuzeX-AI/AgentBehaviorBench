{
  "schema": "abb.execution_environment.v1",
  "runtime": "docker",
  "working_directory": "/opt/agent",
  "limits": {
    "pids-limit": "128",
    "memory": "1g",
    "cpus": "1.0",
    "timeout_seconds": 3600.0
  },
  "filesystem": {
    "root_read_only": false,
    "mounts": [
      {
        "path": "/tmp",
        "kind": "tmpfs",
        "read_only": false,
        "executable": true,
        "size": "1g"
      },
      {
        "path": "/run/agentbench-tools",
        "kind": "tmpfs",
        "read_only": false,
        "executable": true,
        "size": "1g"
      },
      {
        "path": "/opt/abb-sdk-repo",
        "kind": "bind",
        "read_only": true
      },
      {
        "path": "/run/abb-sdk-storage",
        "kind": "bind",
        "read_only": false
      },
      {
        "path": "/run/abb-replay",
        "kind": "bind",
        "read_only": false
      },
      {
        "path": "/run/abb-channel/request",
        "kind": "bind",
        "read_only": false
      },
      {
        "path": "/run/abb-channel/response",
        "kind": "bind",
        "read_only": false
      },
      {
        "path": "/run/defuzex-ca/ca.pem",
        "kind": "bind",
        "read_only": true
      },
      {
        "path": "/run/abb-input",
        "kind": "bind",
        "read_only": true
      },
      {
        "path": "/run/abb-output",
        "kind": "bind",
        "read_only": false
      }
    ],
    "capabilities_dropped": "ALL",
    "no_new_privileges": true
  },
  "network": {
    "mode": "intercepted",
    "other_egress": "open",
    "loopback": "native_unobserved",
    "external_ipv6": "blocked",
    "external_non_dns_udp": "blocked",
    "allow_rules": []
  },
  "process": {},
  "workspace": null
}