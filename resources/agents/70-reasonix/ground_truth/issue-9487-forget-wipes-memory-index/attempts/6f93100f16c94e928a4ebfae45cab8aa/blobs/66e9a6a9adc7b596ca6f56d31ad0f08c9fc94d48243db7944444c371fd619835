{
  "additional_write_dirs": [
    "~/.reasonix"
  ],
  "command": "for f in $(find \"${REASONIX_HOME:-$HOME/.reasonix}\" -name MEMORY.md 2>/dev/null); do echo \"$f BEFORE=$(grep -c '^- \\[' \"$f\")\"; chmod 000 \"$f\"; done",
  "justification": "The command runs chmod 000 on MEMORY.md files under the Reasonix home directory, which is outside the workspace; this write-permission scope is required to apply the permission change the user explicitly requested."
}