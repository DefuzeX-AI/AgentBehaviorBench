APP_NAME=python-lingjing-ai-server
APP_HOST=0.0.0.0
APP_PORT=9909

# Main business DB. This project uses SQLite only.
DATABASE_URL=sqlite:///./data/lingjing.db

# Realtime stream data DB. Kept separate for easier cleanup and backup.
STREAM_DATABASE_URL=sqlite:///./data/stream.db

AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-your-api-key
AI_CHAT_MODEL=replace-with-your-chat-model
AI_ANALYSIS_MODEL=replace-with-your-analysis-model
AI_API_STYLE=openai
VISION_UPLOAD_BASE_URL=http://127.0.0.1:9909
INTERNAL_AI_TOKEN=replace-with-a-long-random-token
AI_TIMEOUT_SECONDS=180

# WebSocket traffic log (all send/receive frames)
WS_LOG_ENABLED=true
WS_LOG_FILE=logs/websocket.log
WS_LOG_LEVEL=INFO
WS_LOG_MAX_BYTES=52428800
WS_LOG_BACKUP_COUNT=5
WS_LOG_BODY_MAX_CHARS=12000

PROMPT_DIR=app/prompts
UDP_TARGET_HOST=localhost
UDP_TARGET_PORT=9876
UDP_SERVER_PORT=9877
