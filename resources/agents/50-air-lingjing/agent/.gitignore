backend/**/*.log
backend/**/uploads/
backend/**/results/
backend/**/results_online/

# Unreal Engine generated files
unreal/**/Binaries/
unreal/**/DerivedDataCache/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/.vs/
