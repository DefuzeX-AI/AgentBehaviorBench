er_vol = 40    # uL, source_plate -> destination_plate\n    reagent_vol = 10     # uL, reagent_trough -> destination_plate\n    mix_vol = 30         # uL, below the 50 uL final volume\n    mix_reps = 3\n\n    # ------------------------------------------------------------------\n    # Step 1: transfer 40 uL of sample from source column 1 to dest column 1\n    # ------------------------------------------------------------------\n    for row in rows:\n        tip_spot = tip_rack[row + \"1\"]\n        well_src = row + \"1\"\n        well_dst = row + \"1\"\n\n        # Fresh tip for every transfer to avoid cross-contamination\n        await lh.pick_up_tips(tip_spot)\n        await lh.aspirate(source_plate[well_src], vols=[transfer_vol])\n        await lh.dispense(destination_plate[well_dst], vols=[transfer_vol])\n        await lh.drop_tips(tip_spot)\n\n    # ------------------------------------------------------------------\n    # Step 2: add 10 uL of reagent from the trough and mix each well\n    # ------------------------------------------------------------------\n    for row in rows:\n        tip_spot = tip_rack[row + \"2\"]\n        well_dst = row + \"1\"\n\n        await lh.pick_up_tips(tip_spot)\n        # Reservoir A1 of the trough holds the bulk reagent\n        await lh.aspirate(reagent_trough[\"A1\"], vols=[reagent_vol])\n        await lh.dispense(destination_plate[well_dst], vols=[reagent_vol])\n        # Homogenise the 50 uL final volume\n        await lh.mix(destination_plate[well_dst], vols=[mix_vol], repetitions=mix_reps)\n        await lh.drop_tips(tip_spot)\n\n    print(\"PROTOCOL_SUCCESS\")\n\nasync def main():\n    \"\"\"\n    Main execution function that sets up the liquid handler and runs the protocol.\n    \"\"\"\n    # Initialize the liquid handler with a simulation backend\n    lh = LiquidHandler(backend=ChatterBoxBackend(), deck_layout=None)\n    \n    try:\n        # Setup the liquid handler\n        await lh.setup()\n        \n        # Run the