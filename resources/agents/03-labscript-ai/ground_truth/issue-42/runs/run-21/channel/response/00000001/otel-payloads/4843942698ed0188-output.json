ion plate ----\n    for sample_well, replicate_well, tip_pos in zip(\n        sample_wells, replicate_wells, tip_positions\n    ):\n        # Pick up a fresh tip for each transfer\n        await lh.pick_up_tips(tip_rack[tip_pos])\n\n        # Aspirate the sample from the source plate\n        await lh.aspirate(source_plate[sample_well], vols=[transfer_volume])\n\n        # Dispense into the matching well of the destination plate\n        await lh.dispense(destination_plate[replicate_well], vols=[transfer_volume])\n\n        # Return the used tip to its original position\n        await lh.drop_tips(tip_rack[tip_pos])\n\n    print(\"Sample transfer step complete.\")\n\n    # ---- Step 2: Add reagent from reservoir to each destination well ----\n    reagent_volume = 30           # µL of reagent to add\n    for i, well in enumerate(replicate_wells):\n        tip_pos = tip_positions[i]\n\n        await lh.pick_up_tips(tip_rack[tip_pos])\n\n        # Use reservoir well A1 as the reagent source (bulk reagent)\n        await lh.aspirate(reagent_trough[\"A1\"], vols=[reagent_volume])\n        await lh.dispense(destination_plate[well], vols=[reagent_volume])\n\n        # Mix to ensure sample + reagent are combined\n        await lh.mix(\n            destination_plate[well],\n            vols=[transfer_volume + reagent_volume],\n            repetitions=3,\n        )\n\n        await lh.drop_tips(tip_rack[tip_pos])\n\n    print(\"Reagent addition step complete.\")\n\n    # ---- Signal successful completion of the protocol ----\n    print(\"--- PROTOCOL_SUCCESS ---\")\n\nasync def main():\n    \"\"\"\n    Main execution function that sets up the liquid handler and runs the protocol.\n    \"\"\"\n    # Initialize the liquid handler with a simulation backend\n    lh = LiquidHandler(backend=ChatterBoxBackend(), deck_layout=None)\n    \n    try:\n        # Setup the liquid handler\n        await lh.setup()\n        \n        # Run the protocol\n        await protocol(lh)\n        \n