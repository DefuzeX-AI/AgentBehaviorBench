-------------------------------------------------\n    try:\n    from pylabrobot.liquid_handling.backends import LiquidHandlerChatterboxBackend\n    except ImportError:  # very old PyLabRobot where only the legacy name exists\n    from pylabrobot.liquid_handling.backends import ChatterBoxBackend as LiquidHandlerChatterboxBackend\n\n    from pylabrobot.resources import Plate, TipRack, Well\n\n\n    async def protocol(lh: LiquidHandler):\n    \"\"\"\n    Main protocol function for PyLabRobot.\n\n    Args:\n        lh (LiquidHandler): The liquid handler instance for performing operations\n    \"\"\"\n\n    # ==================================================================\n    # EXPERIMENTAL DESIGN: SAMPLING RULE, POWER RULE & STOPPING RULE\n    # ==================================================================\n    import math\n    import random\n\n    # ------------------------------------------------------------------\n    # 1) DESIGN PARAMETERS\n    # ------------------------------------------------------------------\n    ALPHA = 0.05            # Type-I error rate (two-sided test)\n    TARGET_POWER = 0.80     # desired statistical power (1 - beta)\n    EFFECT_SIZE_D = 1.0     # expected effect size (Cohen's d = delta / sigma)\n\n    ALIQUOT_VOL_UL = 40.0   # sample volume per replicate (safe limit for 50 uL tips)\n    DILUENT_VOL_UL = 10.0   # diluent pre-loaded into every destination well\n    MIX_VOL_UL = 30.0       # in-well mixing volume after sample addition\n\n    MAX_TOTAL_DRAWS = 40    # STOPPING RULE: hard safety cap on total source draws\n    TIP_CAPACITY = 96       # 8x12 tip rack\n\n    # Volume sanity checks (must respect 50 uL tip capacity)\n    assert ALIQUOT_VOL_UL <= 40.0, \"Aliquot exceeds safe volume for 50 uL tips\"\n    assert MIX_VOL_UL <= 40.0, \"Mix volume exceeds safe volume for 50 uL tips\"\n\n    # ------------------------------------------------------------------\n    # 2) POWER RULE -> number of replicates per group\n    # ------------------------------------------------------------------\n    _Z = {\n        (0.10, 0.80): 2.49, (0.10, 0.90): 2.81,\n        (0.05, 0.80): 2.80, (0.05, 0.90): 3.24, (0.05, 0.95): 3.60,\n        (0.01, 0.80): 3.42, (0.01, 0.90): 3.86,\n    }\n    if (ALPHA, TARGET_POWER) not in _Z:\n        raise ValueError(f\"Unsupported ALPHA/POWER combination: {(ALPHA, TARGET_POWER)}\")\n    z = _Z[(ALPHA, TARGET_POWER)]\n    n_per_group = math.ceil(2.0 * z ** 2 / EFFECT_SIZE_D ** 2)\n    print(f\"[POWER RULE] alpha={ALPHA}, power={TARGET_POWER}, d={EFFECT_SIZE_D} \"\n          f\"-> n = {n_per_group} replicates per group (total {2 * n_per_group} draws)\")\n\n    # ------------------------------------------------------------------\n    # 3) RESOURCES\n    # ------------------------------------------------------------------\n    tip_rack = lh.get_resource(\"tip_rack_50ul\")\n    source = lh.get_resource(\"source_plate\")\n    dest = lh.get_resource(\"destination_plate\")\n    trough = lh.get_resource(\"reagent_trough\")\n\n    # ------------------------------------------------------------------\n    # 4) SAMPLING RULE -> plate map\n    # ------------------------------------------------------------------\n    _ROWS = \"ABCDEFGH\"\n\n    def _block(plate, cols, n):\n        \"\"\"First n wells (row-major) of the given 1-based columns.\"\"\"\n        wells = [plate[f\"{r}{c}\"] for c in cols for r in _ROWS]\n        return wells[:n]\n\n    def _tip_well(i):\n        \"\"\"Sequential tip position on the 8x12 tip rack.\"\"\"\n        if i >= TIP_CAPACITY:\n            raise RuntimeError(\"Tip rack exhausted\")\n        return f\"{_ROWS[i % 8]}{i // 8 + 1}\"\n\n    src_control = _block(source, [1, 2], n_per_group)\n    src_treated = _block(source, [11, 12], n_per_group)\n\n    random.seed(42)\n    dst_control = _block(dest, [1, 2], n_per_group)\n    dst_treated = _block(dest, [11, 12], n_per_group)\n    random.shuffle(dst_control)\n    random.shuffle(dst_treated)\n\n    # ------------------------------------------------------------------\n    # 5) STOPPING RULE (group-sequential / SPRT style)\n    # ------------------------------------------------------------------\n    ln_stop_hi = math.log((1.0 - TARGET_POWER) / ALPHA)\n    ln_stop_lo = math.log((1.0 - TARGET_POWER) / (1.0 - ALPHA))\n\n    def _read_signal(_well):\n        \"\"\"Measurement hook for the sequential stopping rule.\"\"\"\n        return None\n\n    # ------------------------------------------------------------------\n    # 6) EXECUTION\n    # ------------------------------------------------------------------\n    tip_index = 0\n    llr = 0.0\n    done = {\"control\": 0, \"treated\": 0}\n    stop_reason = None\n\n    try:\n        # ---- Phase 1: pre-load diluent into every planned destination well ----\n        all_dst = dst_control + dst_treated\n        await lh.pick_up_tips(tip_rack[_tip_well(tip_index)])\n        tip_index += 1\n        for well in all_dst:\n            await lh.aspirate(trough[\"A1\"], vols=[DILUENT_VOL_UL])\n            await lh.dispense(well, vols=[DILUENT_VOL_UL])\n        await lh.drop_tips()\n        print(f\"[SAMPLING] Pre-loaded {DILUENT_VOL_UL} uL diluent into \"\n              f\"{len(all_dst)} destination wells\")\n\n        # ---- Phase 2: sequential sampling governed by the stopping rule ----\n        plan = [(\"control\", src_control, dst_control),\n                (\"treated\", src_treated, dst_treated)]\n\n        for group, src_wells, dst_wells in plan:\n            if stop_reason:\n                break\n            for src, dst in zip(src_wells, dst_wells):\n                # ---- STOPPING RULE: evaluated before every draw ----\n                if llr >= ln_stop_hi:\n                    stop_reason = (f\"H1 boundary crossed: LLR {llr:.3f} >= \"\n                                   f\"{ln_stop_hi:.3f} -> stop, reject H0\")\n                    break\n                if llr <= ln_stop_lo:\n                    stop_reason = (f\"H0 boundary crossed: LLR {llr:.3f} <= \"\n                                   f\"{ln_stop_lo:.3f} -> stop, futility (accept H0)\")\n                    break\n                if done[\"control\"] + done[\"treated\"] >= MAX_TOTAL_DRAWS:\n                    stop_reason = (f\"Safety cap reached: {MAX_TOTAL_DRAWS} \"\n                                   f\"total source draws\")\n                    break\n                if tip_index >= TIP_CAPACITY:\n                    stop_reason = \"Tip rack exhausted\"\n                    break\n\n                # ---- SAMPLING RULE: fresh tip per replicate, no carry-over ----\n                await lh.pick_up_tips(tip_rack[_tip_well(tip_index)])\n                tip_index += 1\n                await lh.aspirate(src, vols=[ALIQUOT_VOL_UL])\n                await lh.dispense(dst, vols=[ALIQUOT_VOL_UL])\n                await lh.mix(dst, vols=[MIX_VOL_UL], repeats=3)\n                await lh.drop_tips()\n\n                done[group] += 1\n\n                # Evidence update for the sequential stopping rule\n                delta = _read_signal(dst)\n                if delta is not None:\n                    llr += delta\n\n    except Exception as exc:\n        print(f\"[ERROR] Protocol aborted: {exc}\")\n        try:\n            await lh.drop_tips()  # best-effort tip recovery\n        except Exception:\n            pass\n        raise\n\n    # ------------------------------------------------------------------\n    # 7) SUMMARY\n    # ------------------------------------------------------------------\n    print(\"[STOPPING RULE] Reason:\", stop_reason or\n          f\"planned sample size reached ({done['control']} + {done['treated']} draws)\")\n    print(f\"[SUMMARY] control replicates : {done['control']} (dest cols 1-2, randomised)\")\n    print(f\"[SUMMARY] treated replicates: {done['treated']} (dest cols 11-12, randomised)\")\n    print(f\"[SUMMARY] final LLR: {llr:.3f} \"\n          f\"(continue region: {ln_stop_lo:.3f} .. {ln_stop_hi:.3f})\")\n    print(f\"[SUMMARY] tips consumed: {tip_index}/{TIP_CAPACITY}\")\n    print(\"--- PROTOCOL_SUCCESS ---\")\n\n\n    async def main():\n    \"\"\"\n    Main execution function that sets up the liquid handler and runs the protocol.\n    \"\"\"\n    # FIX: instantiate the renamed backend (LiquidHandlerChatterboxBackend,\n    # not the deprecated ChatterBoxBackend).\n    lh = LiquidHandler(backend=LiquidHandlerChatterboxBackend(), deck_layout=None)\n\n    try:\n        # Setup the liquid handler\n        await lh.setup()\n\n        # Run the protocol\n        await protocol(lh)\n\n        print(\"✅ Protocol execution completed successfully!\")\n\n    except Exception as e:\n        print(f\"❌ Protocol execution failed: {e}\")\n        raise\n    finally:\n        # Always stop the liquid handler to clean up resources\n        try:\n            await lh.stop()\n        except Exception as cleanup_error:\n            print(f\"⚠️ Warning: Failed to clean up liquid handler: {cleanup_error}\")\n\n\n    if __name__ == \"__main__\":\n    print(\"🚀 Starting PyLabRobot Protocol Execution...\")\n    asyncio.run(main())\n    ```\n\n    **Root cause & fix applied:**\n    1. **Backend deprecation (the reported error):** The import `from pylabrobot.liquid_handling.backends import ChatterBoxBackend` and the instantiation `ChatterBoxBackend()` raise the deprecation exception in current PyLabRobot versions. Both were replaced with `LiquidHandlerChatterboxBackend` (exact casing per the error message), with an `ImportError`-guarded fallback to the legacy alias for older installations.\n    2. No changes were needed in the liquid-handling logic itself — pipetting operations, resource lookups (`lh.get_resource`), and `await` usage were all valid; only the backend class used at setup time was the failure point.\n\nasync def main():\n    \"\"\"\n    Main execution function that sets up the liquid handler and runs the protocol.\n    \"\"\"\n    # Initialize the liquid handler with a sim