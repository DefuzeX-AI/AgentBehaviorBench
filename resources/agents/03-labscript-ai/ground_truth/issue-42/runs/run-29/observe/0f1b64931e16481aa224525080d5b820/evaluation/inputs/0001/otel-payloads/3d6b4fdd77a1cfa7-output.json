")\n\n    # === Protocol Parameters ===\n    num_wells = 8          # Serial dilution across 8 wells (A1-A8)\n    transfer_vol = 50      # µL transferred between wells per dilution step\n    diluent_vol = 50       # µL of diluent pre-loaded into receiving wells\n    initial_sample_vol = 100  # µL total sample in well A1 (2x 50 µL aspirations)\n    mix_volume = 50        # µL mixing volume (half of well content)\n    mix_reps = 3           # Number of mix cycles after each dilution\n\n    # Destination wells: A1 through A8 of destination plate\n    dest_wells = [dest[f\"A{i}\"] for i in range(1, num_wells + 1)]\n\n    # Helper to generate sequential tip rack positions (column-major)\n    def get_tip_pos(index):\n        row = index % 8\n        col = index // 8 + 1\n        return f\"{chr(ord('A') + row)}{col}\"\n\n    tip_index = 0  # Track current tip position\n\n    # === STEP 1: Dispense diluent into wells A2-A8 (skip A1) ===\n    await lh.pick_up_tips(tip_rack[get_tip_pos(tip_index)])\n    tip_index += 1\n    for well in dest_wells[1:]:\n        await lh.aspirate(diluent[\"A1\"], vols=[diluent_vol])\n        await lh.dispense(well, vols=[diluent_vol])\n    await lh.drop_tips(tip_rack[get_tip_pos(tip_index - 1)])\n\n    # === STEP 2: Transfer initial sample into well A1 (100 µL total) ===\n    await lh.pick_up_tips(tip_rack[get_tip_pos(tip_index)])\n    tip_index += 1\n    for _ in range(initial_sample_vol // transfer_vol):\n        await lh.aspirate(source[\"A1\"], vols=[transfer_vol])\n        await lh.dispense(dest_wells[0], vols=[transfer_vol])\n    # Mix the initial sample in well A1\n    await lh.mix(dest_wells[0], volumes=mix_volume, repetitions=mix_reps)\n    await lh.drop_tips(tip_rack[get_tip_pos(tip_index - 1)])\n\n    # === STEP 3: Perform 1:2 serial dilution across wells A1 → A8 ===\n    # After each transfer:\n    #   - Source well retains transfer_vol (undiluted remainder)\n    #   - Destination well receives transfer_vol into existing diluent\n   