        state[\"signature\"] = signature\n            state[\"repeats\"] = 1\n        return state[\"repeats\"] >= STAGNATION_LIMIT\n\n    # ------------------------------------------------------------------\n    # Transfer plan: 4 x 50 uL from source column A to destination column A\n    # ------------------------------------------------------------------\n    transfers = [\n        (source_plate[f\"A{i}\"], destination_plate[f\"A{i}\"], 50)\n        for i in range(1, 5)\n    ]\n\n    for idx, (src_well, dst_well, vol) in enumerate(transfers, start=1):\n        transfer_id = f\"T{idx}\"\n        state[\"attempts\"] = 0\n\n        while state[\"attempts\"] < MAX_ATTEMPTS:\n            state[\"attempts\"] += 1\n            state[\"status\"] = \"in_progress\"\n            tips_picked = False\n            try:\n                await lh.pick_up_tips(tip_rack[f\"A{idx}\"])\n                tips_picked = True\n                await lh.aspirate(src_well, vols=[vol])\n                await lh.dispense(dst_well, vols=[vol])\n                await lh.mix(dst_well, vols=[vol], repetitions=3)\n                await lh.drop_tips(tip_rack[f\"A{idx}\"])\n                tips_picked = False\n            except Exception as exc:\n                # Record the failure that defines the current state\n                state[\"last_error\"] = str(exc)\n                state[\"last_error_type\"] = type(exc).__name__\n\n                # Best-effort cleanup so the next attempt starts clean\n                if tips_picked:\n                    try:\n                        await lh.drop_tips()\n                    except Exception:\n                        pass\n                else:\n                    try:\n                        await lh.discard_tips()\n                    except Exception:\n                        pass\n\n                # --- Stagnation gate: stop correcting and report ---\n                if\n\nasync def main():\n    \"\"\"\n    Main execution function that sets up t