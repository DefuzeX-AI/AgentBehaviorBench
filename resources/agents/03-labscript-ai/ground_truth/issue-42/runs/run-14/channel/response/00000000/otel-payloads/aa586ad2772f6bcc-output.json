ined resources from the deck ----\n    tip_rack = lh.get_resource(\"tip_rack_50ul\")\n    source_plate = lh.get_resource(\"source_plate\")\n    destination_plate = lh.get_resource(\"destination_plate\")\n    reagent_trough = lh.get_resource(\"reagent_trough\")\n\n    # ---- Report the identified hardware roles ----\n    print(\"=== HARDWARE INSPECTION ===\")\n    print(f\"Tip rack (transfer device tips): {tip_rack.name} | type = {type(tip_rack).__name__}\")\n    print(f\"Source plate                   : {source_plate.name} | type = {type(source_plate).__name__}\")\n    print(f\"Destination plate              : {destination_plate.name} | type = {type(destination_plate).__name__}\")\n    print(f\"Reagent trough                 : {reagent_trough.name} | type = {type(reagent_trough).__name__}\")\n\n    # Confirm the pipetting head / transfer device is available on the LiquidHandler\n    print(f\"Transfer device (pipetting head): {type(lh).__name__} backend-ready\")\n    print(\"=== END HARDWARE INSPECTION ===\")\n\n    # ============================================================\n    # MINIMAL TRANSFER: source_plate -> destination_plate\n    # ============================================================\n    # Use the 50 uL tip rack with the LiquidHandler's pipette head.\n    # Demonstrates the identified source/destination pair with a\n    # single well-to-well transfer (A1 -> A1, 50 uL).\n    await lh.pick_up_tips(tip_rack[\"A1\"])\n    await lh.aspirate(source_plate[\"A1\"], vols=[50])\n    await lh.dispense(destination_plate[\"A1\"], vols=[50])\n    await lh.drop_tips()\n\n    print(\"--- PROTOCOL_SUCCESS ---\")\n\nasync def main():\n    \"\"\"\n    Main execution function that sets up the liquid handler and runs the protocol.\n    \"\"\"\n    # Initialize the liquid handler with a simulation backend\n    lh = LiquidHandler(backend=ChatterBoxBackend(), deck_layout=None)\n    \n    try:\n        # Setup the liquid handler\n        await lh.setup()\n        \n      