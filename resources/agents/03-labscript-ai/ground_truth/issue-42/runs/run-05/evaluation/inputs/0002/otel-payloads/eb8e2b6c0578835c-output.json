ocol Logic\n\n    ```python\n    async def protocol(lh: LiquidHandler):\n    \"\"\"\n    1:2 serial dilution across 12 columns using available hardware resources.\n    Sample in column 1 of source_plate; dilution series built in destination_plate.\n    \"\"\"\n    # ---- Resources (matching configured deck layout)\n    tips = lh.get_resource(\"tip_rack_50ul\")           # 50 uL tip rack\n    source_plate = lh.get_resource(\"source_plate\")    # sample input (96-well)\n    dest_plate = lh.get_resource(\"destination_plate\") # dilution output (96-well)\n    diluent = lh.get_resource(\"reagent_trough\")       # diluent reservoir\n\n    # ---- Protocol parameters\n    transfer_vol = 25.0                # uL per 1:2 transfer (fits 50 uL tips)\n    diluent_vol = 25.0                 # uL diluent per well\n    columns = list(range(1, 13))       # 1:2 series across 12 columns\n    rows = list(\"ABCDEFGH\")            # 96-well plate: 8 rows\n    mix_reps = 3                       # mixing cycles after each transfer\n    mix_vol = transfer_vol\n\n    # One fresh tip per dilution row (8 rows -> 96 tips available)\n    tip_wells = iter(f\"{r}{c}\" for r in \"ABCDEFGH\" for c in range(1, 13))\n\n    try:\n        for row in rows:\n            tip_well = next(tip_wells)\n            await lh.pick_up_tips(tips[tip_well])\n\n            # 1) Preload columns 2-12 of destination plate with diluent\n            for col in columns[1:]:\n                await lh.aspirate(diluent[\"A1\"], vols=[diluent_vol])\n                await lh.dispense(dest_plate[f\"{row}{col}\"], vols=[diluent_vol])\n\n            # 2) Serial 1:2 transfer: col n -> col n+1, mix after each\n            #    Final relative concentrations: col1 = 1x ... col12 = 1/2048x\n            for col in columns[:-1]:\n                if col == 1:\n                    src = source_plate[f\"{row}{col}\"]   # sample source\n                else:\n                    src = dest_plate[f\"{row}{col}\"]     # intermediate dilution\n