ept json.JSONDecodeError as e:\n        print(f\"ERROR: Failed to parse configuration file '{config_path}': {e}\")\n        return\n\n    # ---------------------------------------------------------------\n    # Step 2: Report general deck information\n    # ---------------------------------------------------------------\n    print(\"=\" * 65)\n    print(\"  PYLABROBOT HARDWARE CONFIGURATION REPORT\")\n    print(f\"  Source: {config_path}\")\n    print(\"=\" * 65)\n    print(f\"  Robot model : {config.get('robot_model', 'N/A')}\")\n    print(f\"  Deck type   : {config.get('deck_type', 'N/A')}\")\n    print(f\"  Deck name   : {config.get('deck_name', 'N/A')}\")\n    print(\n        f\"  Deck size   : {config.get('size_x', '?')} x \"\n        f\"{config.get('size_y', '?')} x {config.get('size_z', '?')} mm\"\n    )\n    print(f\"  Description : {config.get('description', 'N/A')}\")\n    print(\"-\" * 65)\n\n    # ---------------------------------------------------------------\n    # Step 3: Categorize and report each configured deck resource\n    #         (tip racks, plates, troughs/reservoirs, carriers, other)\n    # ---------------------------------------------------------------\n    resources = config.get(\"resources\", {})\n    categories = {\n        \"TIP RACKS\": [],\n        \"PLATES\": [],\n        \"TROUGHS / RESERVOIRS\": [],\n        \"CARRIERS\": [],\n        \"OTHER\": [],\n    }\n\n    for name, details in resources.items():\n        rtype = str(details.get(\"type\", \"\")).upper()\n        lname = name.lower()\n        if \"TIP\" in rtype or \"tip\" in lname:\n            categories[\"TIP RACKS\"].append((name, details))\n        elif \"RESERVOIR\" in rtype or \"trough\" in lname:\n            categories[\"TROUGHS / RESERVOIRS\"].append((name, details))\n        elif \"PLATE\" in lname or \"DW\" in rtype or \"PLATE\" in rtype:\n            categories[\"PLATES\"].append((name, details))\n        elif \"CARRIER\" in rtype or \"carrier\" in lname:\n            categories[\"CARRIERS\"].append((name, details))\n        else:\n            categories[\"OTHER\"].append((name, details))\n\n    print(f\"  AVAILABLE DECK RESOURCES ({len(resources)} total)\")\n    for cat_name, items in categories.items():\n        if not items:\n            continue\n        print(f\"\n  [{cat_name}]\")\n        for name, details in items:\n            loc = details.get(\"location\", {})\n            print(f\"    - {name}\")\n            print(f\"        Type        : {details.get('type', 'N/A')}\")\n            print(\n                f\"        Location    : x={loc.get('x', 'N/A')}, \"\n                f\"y={loc.get('y', 'N/A')}, z={loc.get('z', 'N/A')} mm\"\n            )\n            print(f\"        Description : {details.get('description', 'N/A')}\")\n\n    # ---------------------------------------------------------------\n    # Step 4: Report supported operations\n    # ---------------------------------------------------------------\n    operations = config.get(\"supported_operations\", [])\n    print(\n        f\"\n  SUPPORTED OPERATIONS: \"\n        f\"{', '.join(operations) if operations else 'None listed'}\"\n    )\n\n    # ---------------------------------------------------------------\n    # Step 5: Verify that each configured resource is accessible\n    #         on the live deck via the LiquidHandler\n    # ---------------------------------------------------------------\n    print(\"\n\" + \"-\" * 65)\n    print(\"  LIVE DECK VERIFICATION\")\n    verified = 0\n    for name in resources:\n        try:\n            resource = lh.get_resource(name)\n            rname = getattr(resource, \"name\", name)\n            print(f\"    [OK]      {name} (deck resource: {rname})\")\n            verified += 1\n        except Exception as e:\n            print(f\"    [MISSING] {name} -> {e}\")\n\n    print(f\"\n  Verified {verified}/{len(resources)} configured resources on the deck.\")\n    if verified < len(resources):\n        print(\"  WARNING: Some configured resources were not found on the live deck.\")\n    print(\"=\" * 65)\n\n    print(\"--- PROTOCOL_SUCCESS ---\")\n\nasync def main():\n    \"\"\"\n    Main execution function that sets up the liquid handler and runs the protocol.\n    \"\"\"\n    # Initialize the liquid handler with a simulation backend\n    lh = LiquidHandler(backend=ChatterBoxBackend(), deck_layout=None)\n    \n    try:\n        # Setup the liquid handler\n        await lh.setup()\n        \n        # Run the protocol\n        await protocol(lh)\n        \n        print(\"✅ Protocol execution completed successfully!\")\n        \n    except Exception as e:\n        print(f\"❌ Protocol execution failed: {e}\")\n        raise\n    finally:\n        # Always stop the liquid handler to clean up resources\n        try:\n            await lh.stop()\n        except Exception as cleanup_error:\n            print(f\"⚠️ Warning: Failed to clean up liquid handler: {cleanup_error}\")\n\nif __name__ == \"__main__\":\n    \"\"\"\n    Entry point for running the protocol.\n    \"\"\"\n    print(\"🚀 Starting PyLabRobot Protocol Execution...\")\n    asyncio.run(main())\n\nSimulation: {\"success\": false, \"raw_output\": \"--- PyLabRobot Simulation STDOUT ---\\n\\n--- PyLabRobot Simulation STDERR ---\\nSyntaxError: unterminated string literal (detected at line 109) at line 109\", \"error_details\": \"SyntaxError: unterminated string literal (detected at line 109) at line 109\", \"result_summary\": \"PyLabRobot simulation failed\", \"has_warnings\": false, \"warning_details\": null}"