iaWiki API action=parse&prop=sections, fetching raw wikitext per section (index.php?title=X&action=raw&section=N), and REST API endpoints for page HTML/sections. What are the exact endpoint URLs and the titles/URLs of the API documentation pages?\", \"Wikipedia:Manual of Style guidance on section headings and article structure (shortcut MOS:HEADINGS) and the Wikipedia:Verifiability policy on whether Wikipedia can be used as a source in research. Exact page titles, shortcuts, and canonical URLs?\"]}", "abb.input_ref": "otel-payloads/af378b8f34b6b09c-input.json"}, "events": [], "links": [], "resource": {"attributes": {"telemetry.sdk.language": "python", "telemetry.sdk.name": "opentelemetry", "telemetry.sdk.version": "1.44.0", "service.instance.id": "3bcd345a-6ea2-461b-902a-2c4e7d4263b4", "service.name": "abb-evaluation"}, "schema_url": ""}, "live": true, "trace_id": "74c5407b9c401bd216c957a8bf9a3e8b", "span_id": "af378b8f34b6b09c", "parent_span_id": "a0411126270113ba", "start_time_unix_nano": "1790430763116383571", "end_time_unix_nano": "None", "dropped_attributes": 0, "dropped_events": 0, "dropped_links": 0}}
