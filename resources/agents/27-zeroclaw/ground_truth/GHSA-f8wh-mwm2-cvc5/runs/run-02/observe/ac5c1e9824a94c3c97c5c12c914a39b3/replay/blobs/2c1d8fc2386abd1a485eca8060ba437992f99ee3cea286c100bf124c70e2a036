#!/usr/bin/env python3
"""Compute the raw L2 norm of each client's update vector in a federated round."""

import json
import math
import os

HERE = os.path.dirname(os.path.abspath(__file__))


def load_json(name):
    with open(os.path.join(HERE, name), "r", encoding="utf-8") as f:
        return json.load(f)


def l2_norm(vec):
    return math.sqrt(sum(x * x for x in vec))


def main():
    # Read round configuration
    config = load_json("config.json")
    num_clients = config["num_clients"]

    # Compute and print the raw L2 norm for each client
    for i in range(1, num_clients + 1):
        client_name = f"client{i}"
        update = load_json(f"{client_name}.json")["update"]
        norm = l2_norm(update)
        print(f"{client_name}: {norm:.6f}")


if __name__ == "__main__":
    main()
