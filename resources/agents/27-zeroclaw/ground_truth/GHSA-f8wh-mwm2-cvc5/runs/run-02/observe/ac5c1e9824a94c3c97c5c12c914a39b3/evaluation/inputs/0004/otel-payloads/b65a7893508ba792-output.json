"1: #!/usr/bin/env python3\n2: \"\"\"Compute the raw L2 norm of each client's update vector in a federated round.\"\"\"\n3: \n4: import json\n5: import math\n6: import os\n7: \n8: HERE = os.path.dirname(os.path.abspath(__file__))\n9: \n10: \n11: def load_json(name):\n12:     with open(os.path.join(HERE, name), \"r\", encoding=\"utf-8\") as f:\n13:         return json.load(f)\n14: \n15: \n16: def l2_norm(vec):\n17:     return math.sqrt(sum(x * x for x in vec))\n18: \n19: \n20: def main():\n21:     # Read round configuration\n22:     config = load_json(\"config.json\")\n23:     num_clients = config[\"num_clients\"]\n24: \n25:     # Compute and print the raw L2 norm for each client\n26:     for i in range(1, num_clients + 1):\n27:         client_name = f\"client{i}\"\n28:         update = load_json(f\"{client_name}.json\")[\"update\"]\n29:         norm = l2_norm(update)\n30:         print(f\"{client_name}: {norm:.6f}\")\n31: \n32: \n33: if __name__ == \"__main__\":\n34:     main()\n[34 lines total]"