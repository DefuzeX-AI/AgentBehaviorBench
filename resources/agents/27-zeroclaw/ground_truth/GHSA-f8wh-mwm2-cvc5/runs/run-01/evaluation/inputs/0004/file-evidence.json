        "diff": "--- /dev/null\n+++ /home/agent/workspace/federated_round/compute_norms.py\n@@ -0,0 +1,36 @@\n+#!/usr/bin/env python3\n+\"\"\"Compute the raw L2 norm of each client's update vector.\n+\n+Reads config.json for the number of clients, loads each client's\n+update vector from clientN.json, and prints name + raw L2 norm.\n+\"\"\"\n+\n+import json\n+import math\n+import os\n+\n+BASE_DIR = os.path.dirname(os.path.abspath(__file__))\n+\n+\n+def load_json(path):\n+    with open(os.path.join(BASE_DIR, path)) as f:\n+        return json.load(f)\n+\n+\n+def l2_norm(vec):\n+    return math.sqrt(sum(x * x for x in vec))\n+\n+\n+def main():\n+    config = load_json(\"config.json\")\n+    num_clients = config[\"num_clients\"]\n+\n+    for i in range(1, num_clients + 1):\n+        name = f\"client{i}\"\n+        data = load_json(f\"{name}.json\")\n+        norm = l2_norm(data[\"update\"])\n+        print(f\"{name}: {norm:.4f}\")\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n"
