"1: import re, html.parser\n2: \n3: report = \"report-preview.html\"\n4: src = open(report, encoding=\"utf-8\").read()\n5: \n6: print(\"=== 1. EXTERNAL RESOURCE SCAN (must be zero for offline guarantee) ===\")\n7: forbidden = {\n8:     \"<script\": r\"<script\",\n9:     \"<link\":   r\"<link\\b\",\n10:     \"<img\":    r\"<img\\b\",\n11:     \"<iframe\": r\"<iframe\\b\",\n12:     \"@import\": r\"@import\\b\",\n13:     \"url()\":   r\"url\\s*\\(\",\n14:     \"fetch/XHR/WS\": r\"\\b(fetch\\(|XMLHttpRequest|WebSocket|import\\()\",\n15: }\n16: clean = True\n17: for name, pat in forbidden.items():\n18:     hits = re.findall(pat, src, re.I)\n19:     print(f\"  {name:24s} -> {len(hits)} found\")\n20:     clean &= not hits\n21: \n22: urls = re.findall(r'https?://[^\\s\"<]+', src)\n23: res_urls = [u for u in urls if re.search(r'\\.(css|js|png|jpe?g|svg|woff2?|ico)($|\\?)', u, re.I)]\n24: print(f\"  external URLs total: {len(urls)}  (all plain hyperlinks, none load resources: {len(res_urls)==0})\")\n25: for u in urls:\n26:     print(f\"    - {u}\")\n27: \n28: print(\"\\n=== 2. ANCHOR NAVIGATION (TOC -> section ids) ===\")\n29: hrefs = set(re.findall(r'href=\"#([^\"]+)\"', src))\n30: ids = re.findall(r'\\bid=\"([^\"]+)\"', src)\n31: dupes = sorted({i for i in ids if ids.count(i) > 1})\n32: missing = sorted(hrefs - set(ids))\n33: print(f\"  internal anchors: {len(hrefs)}, ids: {len(set(ids))}, duplicate ids: {dupes if dupes else 'NONE'}\")\n34: print(f\"  unresolved anchors: {missing if missing else 'NONE - every TOC link resolves'}\")\n35: \n36: print(\"\\n=== 3. <meter> RANGE VALIDATION (browser computes gauge width from value/min/max) ===\")\n37: ok = True\n38: for m in re.finditer(r'<meter([^>]*)>', src):\n39:     a = dict(re.findall(r'([\\w-]+)=\"([^\"]*)\"', m.group(1)))\n40:     mn, mx, v = float(a.get('min', 0)), float(a.get('max', 1)), float(a.get('value', 0))\n41:     inrange = mn <= v <= mx\n42:     ok &= inrange\n43:     print(f\"  value={v:5.1f} min={mn:.0f} max={mx:.0f} -> {'OK' if inrange else 'OUT OF RANGE'}\")\n44: print(f\"  all meters within range: {ok}\")\n45: \n46: print(\"\\n=== 4. RAG BADGE CONTRACT (markup <-> CSS <-> machine value) ===\")\n47: used = set(re.findall(r'class=\"(rag rag-\\w+)\"', src))\n48: css = set(re.findall(r'\\.(rag-\\w+)\\s*\\{', src))\n49: print(f\"  used in markup: {sorted(used)}\")\n50: print(f\"  defined in CSS: {sorted(css)}\")\n51: print(f\"  used-but-undefined: {sorted(used - css) if used - css else 'NONE'}\")\n52: pairs = re.findall(r'<data class=\"rag rag-(\\w+)\" value=\"\\w*\">([A-Z ]+)</data>', src)\n53: labelmap = {\"green\": (\"GREEN\",), \"amber\": (\"AMBER\",), \"red\": (\"RED\",)}\n54: bad = []\n55: for cls, lbl in pairs:\n56:     expected = labelmap.get(cls, ())\n57:     if expected and not lbl.startswith(expected):\n58:         bad.append((cls, lbl))\n59: print(f\"  <data value> vs visible label mismatches: {bad if bad else 'NONE'}\")\n60: \n61: print(\"\\n=== 5. TAG BALANCE (well-formedness) ===\")\n62: class Chk(html.parser.HTMLParser):\n63:     VOID = {\"meta\", \"br\", \"hr\", \"img\", \"input\", \"link\"}\n64:     def __init__(self):\n65:         super().__init__(); self.stack = []; self.errs = []\n66:     def handle_starttag(self, tag, attrs):\n67:         if tag not in self.VOID:\n68:             self.stack.append(tag)\n69:     def handle_endtag(self, tag):\n70:         if tag in self.VOID:\n71:             return\n72:         if self.stack and self.stack[-1] == tag:\n73:             self.stack.pop()\n74:         else:\n75:             top = self.stack[-1] if self.stack else \"empty\"\n76:             self.errs.append(f\"mismatched </{tag}> (stack top: {top})\")\n77: c = Chk(); c.feed(src)\n78: print(f\"  unclosed tags: {c.stack if c.stack else 'NONE'}\")\n79: print(f\"  mismatches: {c.errs if c.errs else 'NONE'}\")\n80: \n81: print(\"\\n=== 6. CSS FEATURE FLOOR ===\")\n82: for feat in [\"color-mix\", \"columns:\", \"repeat(auto-fit\", \"@media print\", \":focus-visible\"]:\n83:     print(f\"  '{feat}' present: {feat in src}\")\n84: \n85: print(\"\\n=== 7. TEMPLATE GETS THE SAME PASS ===\")\n86: tpl = open(\"report-template.html\", encoding=\"utf-8\").read()\n87: t_hits = {n: len(re.findall(p, tpl, re.I)) for n, p in forbidden.items()}\n88: print(f\"  template external-resource hits: {t_hits} (all zero: {not any(t_hits.values())})\")\n[88 lines total]"