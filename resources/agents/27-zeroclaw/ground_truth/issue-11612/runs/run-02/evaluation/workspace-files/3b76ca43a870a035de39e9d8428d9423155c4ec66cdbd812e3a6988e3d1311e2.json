{
  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Project Status Report — [PROJECT NAME] — [PERIOD]</title>\n<style>\n/* ============================================================\n   REPORT STYLE SYSTEM — single file · offline · no JS · system fonts\n   Layers: 1 tokens · 2 base · 3 layout · 4 components · 5 utilities · 6 print\n   Rule: editors change layer 1 only; components consume tokens.\n   ============================================================ */\n\n/* ---- 1 · DESIGN TOKENS — every visual decision lives here ---- */\n:root {\n  /* Color roles. Text pairs chosen for WCAG AA; status colors always\n     appear with a text label, never color alone. */\n  --paper:   #ffffff;   /* page background */\n  --ink:     #1a2332;   /* primary text */\n  --muted:   #56677c;   /* secondary text */\n  --line:    #d7dee8;   /* hairlines, table borders */\n  --surface: #f4f6f9;   /* tiles, table header fill */\n  --accent:  #1f4e79;   /* brand: h1, h2 rule, links */\n  --ok:      #2e7d32;   /* status: green / on track */\n  --warn:    #9a5b00;   /* status: amber / at risk */\n  --alert:   #b3261e;   /* status: red / off track */\n  --draft:   #fff8d6;   /* unfilled placeholder */\n\n  /* Type scale — rem only, ~1.22 ratio */\n  --text-2: 1.65rem;    /* h1 */\n  --text-1: 1.15rem;    /* h2 */\n  --text-0: 1rem;       /* body */\n  --text--1: .92rem;    /* tables, dense data */\n  --text--2: .8rem;     /* micro labels, footer */\n\n  /* Space scale — 4px base */\n  --s1: .25rem; --s2: .5rem; --s3: .75rem; --s4: 1rem;\n  --s6: 1.5rem; --s8: 2rem; --s12: 3rem;\n\n  /* Layout constants */\n  --measure: 60rem;     /* line-length ceiling (~75ch) */\n  --leading: 1.5;\n  --radius: .4rem;\n}\n\n/* ---- 2 · BASE — reset + typography defaults ---- */\n* { box-sizing: border-box; }\nbody {\n  font-family: -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  color: var(--ink); background: var(--paper);\n  font-size: var(--text-0); line-height: var(--leading);\n  margin: 0; padding: var(--s8) var(--s4);\n}\nh1, h2, h3 { line-height: 1.25; }\nh1 { font-size: var(--text-2); color: var(--accent); margin: 0 0 var(--s2); }\nh2 { font-size: var(--text-1); margin: var(--s8) 0 var(--s3);\n     border-bottom: 2px solid var(--accent); padding-bottom: var(--s1); }\nh3 { font-size: var(--text-0); margin: var(--s4) 0 var(--s1); }\np, ul, ol, dl, table { margin: 0 0 var(--s3); }\na { color: var(--accent); }\na:hover { text-decoration-thickness: 2px; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n\n/* ---- 3 · LAYOUT — one column, measure-limited, header/main/footer ---- */\nheader, main, footer, nav { max-width: var(--measure); margin-inline: auto; }\nheader { border-bottom: 3px solid var(--accent); padding-bottom: var(--s4); }\nfooter { border-top: 1px solid var(--line); margin-top: var(--s12);\n         padding-top: var(--s3); }\nnav ol { font-size: var(--text--1); columns: 2; gap: var(--s6);\n         padding-left: var(--s4); margin-top: var(--s4); }\n\n/* ---- 4 · COMPONENTS ---- */\n\n/* Metadata list (header): tight two-column label/value grid */\ndl.meta { display: grid; grid-template-columns: max-content 1fr;\n          gap: var(--s1) var(--s4); margin: var(--s4) 0 0; }\ndl.meta dt { font-weight: 600; color: var(--muted); }\ndl.meta dd { margin: 0; }\naddress { font-style: normal; }\n\n/* Status badges — token swap recolors, text label is the source of truth */\n.rag { display: inline-block; min-width: 5.5ch; text-align: center;\n       font-weight: 600; font-size: var(--text--2); color: #fff;\n       padding: var(--s1) var(--s2); border-radius: 1rem; }\n.rag-green { background: var(--ok); }\n.rag-amber { background: var(--warn); }\n.rag-red   { background: var(--alert); }\n\n/* Dashboard tiles: auto-fit grid, 1→n columns, no media queries needed */\n.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));\n         gap: var(--s2); list-style: none; padding: 0; }\n.tiles li { border: 1px solid var(--line); border-radius: var(--radius);\n            background: var(--surface); padding: var(--s2) var(--s3); }\n.tiles h3 { margin: 0; font-size: var(--text--2); text-transform: uppercase;\n            letter-spacing: .04em; color: var(--muted); }\n.tiles p { margin: var(--s1) 0 0; font-weight: 600; }\n\n/* Data tables: full-width hairline grid, tinted header */\ntable { border-collapse: collapse; width: 100%; font-size: var(--text--1); }\ncaption { caption-side: top; text-align: left; font-style: italic;\n          color: var(--muted); padding-bottom: var(--s1);\n          font-size: var(--text--2); }\nth, td { border: 1px solid var(--line); padding: var(--s2) var(--s2);\n         text-align: left; vertical-align: top; }\nthead th { background: var(--surface); }\ntbody tr:nth-child(even) { background: color-mix(in srgb, var(--surface) 55%, white); }\nmeter { width: 100%; height: .9rem; }\n\n/* Emphasis paragraphs (plan-vs-actual, changes, resources) */\np strong { color: var(--accent); }\n\n/* ---- 5 · UTILITIES ---- */\n.lede { color: var(--muted); font-size: var(--text--1); margin: 0; }\n.placeholder { background: var(--draft); outline: 1px dashed var(--warn);\n               padding: 0 var(--s1); }\n\n/* ---- 6 · PRINT — A4/Letter: ink-saver, no split content ---- */\n@media print {\n  body { padding: 0; font-size: 10.5pt; }\n  nav { display: none; }                    /* TOC redundant on paper */\n  section, table, .tiles li { break-inside: avoid; }\n  h2 { break-after: avoid; }\n  a { text-decoration: none; color: inherit; }\n  .placeholder { background: none; outline: none; }\n  tbody tr:nth-child(even) { background: var(--surface); }\n}\n</style>\n</head>\n<body>\n\n<header>\n  <!-- EDIT: project identity -->\n  <h1>[PROJECT NAME] — Status Report</h1>\n  <p class=\"lede\">Report #[N] of [TOTAL] &middot; Period: <time datetime=\"[YYYY-MM-DD]\">[start]</time> to <time datetime=\"[YYYY-MM-DD]\">[end]</time></p>\n  <dl class=\"meta\">\n    <dt>Issued</dt><dd><time datetime=\"[YYYY-MM-DD]\">[issue date]</time></dd>\n    <dt>Author</dt><dd>[name, role] — <address style=\"display:inline\">[email]</address></dd>\n    <dt>Sponsor</dt><dd>[sponsor name]</dd>\n    <dt>Distribution</dt><dd>[audience list]</dd>\n    <dt>Classification</dt><dd>[e.g., Internal]</dd>\n  </dl>\n</header>\n\n<nav aria-label=\"Contents\"><!-- EDIT: optional TOC, delete if unwanted -->\n  <ol>\n    <li><a href=\"#summary\">Executive summary</a></li>\n    <li><a href=\"#dashboard\">Status dashboard</a></li>\n    <li><a href=\"#milestones\">Milestones &amp; timeline</a></li>\n    <li><a href=\"#progress\">Progress this period</a></li>\n    <li><a href=\"#upcoming\">Next period</a></li>\n    <li><a href=\"#risks\">Risks &amp; issues</a></li>\n    <li><a href=\"#decisions\">Decisions needed</a></li>\n    <li><a href=\"#budget\">Budget &amp; resources</a></li>\n    <li><a href=\"#changes\">Change log</a></li>\n    <li><a href=\"#appendix\">Appendix</a></li>\n  </ol>\n</nav>\n\n<main>\n\n  <section id=\"summary\">\n    <h2>1. Executive Summary</h2>\n    <!-- EDIT: 3–5 sentences. Health verdict first, then headline win(s) and headline risk(s). -->\n    <p class=\"placeholder\">[Overall status verdict — one sentence. Key achievement. Key concern. What you need from readers.]</p>\n  </section>\n\n  <section id=\"dashboard\">\n    <h2>2. Status Dashboard</h2>\n    <ul class=\"tiles\">\n      <!-- EDIT: one li per dimension; keep class + value in sync -->\n      <li><h3>Overall</h3><p><data class=\"rag rag-amber\" value=\"amber\">AMBER</data></p></li>\n      <li><h3>Schedule</h3><p><data class=\"rag rag-green\" value=\"green\">GREEN</data></p></li>\n      <li><h3>Scope</h3><p><data class=\"rag rag-green\" value=\"green\">GREEN</data></p></li>\n      <li><h3>Budget</h3><p><data class=\"rag rag-green\" value=\"green\">GREEN</data></p></li>\n      <li><h3>Risk</h3><p><data class=\"rag rag-amber\" value=\"amber\">AMBER</data></p></li>\n      <li><h3>Quality</h3><p><data class=\"rag rag-green\" value=\"green\">GREEN</data></p></li>\n    </ul>\n    <!-- EDIT: one-line justification per non-green rating -->\n    <p class=\"placeholder\">[One-line justification for each non-green rating.]</p>\n  </section>\n\n  <section id=\"milestones\">\n    <h2>3. Milestones &amp; Timeline</h2>\n    <table>\n      <caption>Milestone status vs. baseline plan</caption>\n      <thead>\n        <tr><th scope=\"col\">Milestone</th><th scope=\"col\">Baseline</th><th scope=\"col\">Forecast/Actual</th><th scope=\"col\">Status</th><th scope=\"col\">Complete</th></tr>\n      </thead>\n      <tbody>\n        <!-- EDIT: one row per milestone; meter max=100, value=percent -->\n        <tr><td>[Milestone A]</td><td><time datetime=\"[YYYY-MM-DD]\">[date]</time></td><td><time datetime=\"[YYYY-MM-DD]\">[date]</time></td><td><data class=\"rag rag-green\" value=\"green\">ON TRACK</data></td><td><meter min=\"0\" max=\"100\" value=\"0\">0%</meter></td></tr>\n        <tr><td>[Milestone B]</td><td><time datetime=\"[YYYY-MM-DD]\">[date]</time></td><td><time datetime=\"[YYYY-MM-DD]\">[date]</time></td><td><data class=\"rag rag-amber\" value=\"amber\">AT RISK</data></td><td><meter min=\"0\" max=\"100\" value=\"0\">0%</meter></td></tr>\n      </tbody>\n    </table>\n  </section>\n\n  <section id=\"progress\">\n    <h2>4. Progress This Period</h2>\n    <!-- EDIT: accomplishments as list items; quantify where possible -->\n    <ul>\n      <li class=\"placeholder\">[Accomplishment 1 — deliverable, owner, quantified outcome]</li>\n      <li class=\"placeholder\">[Accomplishment 2]</li>\n    </ul>\n    <!-- EDIT: planned-vs-actual variance note -->\n    <p><strong>Plan vs. actual:</strong> <span class=\"placeholder\">[e.g., 8 of 9 planned items delivered; item X slipped to next period because …]</span></p>\n  </section>\n\n  <section id=\"upcoming\">\n    <h2>5. Next Period</h2>\n    <!-- EDIT: committed work for the coming window -->\n    <ul>\n      <li class=\"placeholder\">[Committed item — target date]</li>\n      <li class=\"placeholder\">[Committed item — target date]</li>\n    </ul>\n  </section>\n\n  <section id=\"risks\">\n    <h2>6. Risks &amp; Issues</h2>\n    <table>\n      <caption>Top risks and issues (severity × likelihood; owner accountable for mitigation)</caption>\n      <thead>\n        <tr><th scope=\"col\">ID</th><th scope=\"col\">Description</th><th scope=\"col\">Severity</th><th scope=\"col\">Likelihood</th><th scope=\"col\">Owner</th><th scope=\"col\">Mitigation / next action</th><th scope=\"col\">Review by</th></tr>\n      </thead>\n      <tbody>\n        <!-- EDIT: one row per risk/issue; RAG- color the Severity cell -->\n        <tr><td>R1</td><td class=\"placeholder\">[Risk description and impact]</td><td><data class=\"rag rag-red\" value=\"red\">HIGH</data></td><td>[H/M/L]</td><td>[owner]</td><td class=\"placeholder\">[mitigation]</td><td><time datetime=\"[YYYY-MM-DD]\">[date]</time></td></tr>\n        <tr><td>I1</td><td class=\"placeholder\">[Issue currently occurring]</td><td><data class=\"rag rag-amber\" value=\"amber\">MED</data></td><td>—</td><td>[owner]</td><td class=\"placeholder\">[resolution action]</td><td><time datetime=\"[YYYY-MM-DD]\">[date]</time></td></tr>\n      </tbody>\n    </table>\n    <!-- EDIT: note changes since last report; delete line if first report -->\n    <p><em>Changes since last report:</em> <span class=\"placeholder\">[new / closed / escalated items]</span></p>\n  </section>\n\n  <section id=\"decisions\">\n    <h2>7. Decisions Needed</h2>\n    <table>\n      <caption>Asks of the sponsor — indecision past the required-by date has a cost</caption>\n      <thead>\n        <tr><th scope=\"col\">Decision</th><th scope=\"col\">Context / options</th><th scope=\"col\">Impact of delay</th><th scope=\"col\">Needed by</th></tr>\n      </thead>\n      <tbody>\n        <!-- EDIT: one row per ask; delete section + TOC entry if none -->\n        <tr><td class=\"placeholder\">[Decision required]</td><td class=\"placeholder\">[Options A/B and recommendation]</td><td class=\"placeholder\">[cost/slip if late]</td><td><time datetime=\"[YYYY-MM-DD]\">[date]</time></td></tr>\n      </tbody>\n    </table>\n  </section>\n\n  <section id=\"budget\">\n    <h2>8. Budget &amp; Resources</h2>\n    <table>\n      <caption>Spend vs. plan (delete section if not tracked)</caption>\n      <thead>\n        <tr><th scope=\"col\">Measure</th><th scope=\"col\">Plan</th><th scope=\"col\">Actual/Forecast</th><th scope=\"col\">Variance</th><th scope=\"col\">Note</th></tr>\n      </thead>\n      <tbody>\n        <tr><td>Spend to date</td><td>[amount]</td><td>[amount]</td><td class=\"placeholder\">[+/-]</td><td class=\"placeholder\">[explanation]</td></tr>\n        <tr><td>Forecast at completion</td><td>[budget]</td><td>[forecast]</td><td class=\"placeholder\">[+/-]</td><td class=\"placeholder\">[driver]</td></tr>\n      </tbody>\n    </table>\n    <!-- EDIT: staffing changes, ramp-up/down -->\n    <p><strong>Resources:</strong> <span class=\"placeholder\">[headcount changes, new joins, gaps]</span></p>\n  </section>\n\n  <section id=\"changes\">\n    <h2>9. Scope &amp; Change Log</h2>\n    <table>\n      <caption>Change requests this period (delete section if none)</caption>\n      <thead>\n        <tr><th scope=\"col\">CR ID</th><th scope=\"col\">Summary</th><th scope=\"col\">Status</th><th scope=\"col\">Schedule impact</th><th scope=\"col\">Cost impact</th></tr>\n      </thead>\n      <tbody>\n        <!-- EDIT: one row per change request -->\n        <tr><td>CR-[n]</td><td class=\"placeholder\">[change summary]</td><td>[Submitted/Approved/Rejected]</td><td class=\"placeholder\">[+days]</td><td class=\"placeholder\">[+amount]</td></tr>\n      </tbody>\n    </table>\n  </section>\n\n  <section id=\"appendix\">\n    <h2>Appendix</h2>\n    <h3>Glossary</h3>\n    <!-- EDIT: define jargon used in this report -->\n    <dl>\n      <dt>[Term]</dt><dd>[Definition]</dd>\n    </dl>\n    <h3>References</h3>\n    <ul>\n      <li><a href=\"[url]\">[Linked document / dashboard]</a></li>\n    </ul>\n  </section>\n\n</main>\n\n<footer>\n  <!-- EDIT: confidentiality + contact -->\n  <p>[Confidentiality statement] &middot; Prepared by [author] &middot; Questions: [email]</p>\n</footer>\n\n</body>\n</html>\n",
  "encoding": "utf-8"
}