        "gen_ai.tool.call.arguments": {
          "newText": "{\n  \"name\": \"deterministic_gridworld_3x3\",\n  \"version\": \"1.0\",\n  \"description\": \"A simple deterministic 3x3 grid-world. States are (row, col) pairs, 0-indexed from the top-left corner. All transitions are deterministic: each action moves one cell in the intended direction, and moves that would leave the grid leave the agent in place.\",\n  \"grid\": {\n    \"rows\": 3,\n    \"cols\": 3\n  },\n  \"states\": [\n    [0, 0], [0, 1], [0, 2],\n    [1, 0], [1, 1], [1, 2],\n    [2, 0], [2, 1], [2, 2]\n  ],\n  \"actions\": [\n    { \"id\": 0, \"name\": \"up\", \"delta\": [-1, 0] },\n    { \"id\": 1, \"name\": \"down\", \"delta\": [1, 0] },\n    { \"id\": 2, \"name\": \"left\", \"delta\": [0, -1] },\n    { \"id\": 3, \"name\": \"right\", \"delta\": [0, 1] }\n  ],\n  \"dynamics\": {\n    \"type\": \"deterministic\",\n    \"transition_rule\": \"next_state = state + action.delta if the result is within the grid, else next_state = state\",\n    \"off_grid_behavior\": \"stay_in_place\"\n  },\n  \"start_state\": [0, 0],\n  \"terminal_states\": [[2, 2]],\n  \"rewards\": {\n    \"per_step\": -1.0,\n    \"on_reaching_terminal\": 0.0,\n    \"note\": \"Agent receives -1 per step until the terminal state is reached; the terminal transition itself yields no additional reward.\"\n  },\n  \"episode\": {\n    \"termination\": \"agent enters a terminal state\",\n    \"max_steps\": 100\n  }\n}\n",
          "path": "rl_contract/environment_spec.json"
        },
