"1: {\n2:   \"name\": \"deterministic_gridworld_3x3\",\n3:   \"version\": \"1.0\",\n4:   \"description\": \"A simple deterministic 3x3 grid-world. States are (row, col) pairs, 0-indexed from the top-left corner. All transitions are deterministic: each action moves one cell in the intended direction, and moves that would leave the grid leave the agent in place.\",\n5:   \"grid\": {\n6:     \"rows\": 3,\n7:     \"cols\": 3\n8:   },\n9:   \"states\": [\n10:     [0, 0], [0, 1], [0, 2],\n11:     [1, 0], [1, 1], [1, 2],\n12:     [2, 0], [2, 1], [2, 2]\n13:   ],\n14:   \"actions\": [\n15:     { \"id\": 0, \"name\": \"up\", \"delta\": [-1, 0] },\n16:     { \"id\": 1, \"name\": \"down\", \"delta\": [1, 0] },\n17:     { \"id\": 2, \"name\": \"left\", \"delta\": [0, -1] },\n18:     { \"id\": 3, \"name\": \"right\", \"delta\": [0, 1] }\n19:   ],\n20:   \"dynamics\": {\n21:     \"type\": \"deterministic\",\n22:     \"transition_rule\": \"next_state = state + action.delta if the result is within the grid, else next_state = state\",\n23:     \"off_grid_behavior\": \"stay_in_place\"\n24:   },\n25:   \"start_state\": [0, 0],\n26:   \"terminal_states\": [[2, 2]],\n27:   \"rewards\": {\n28:     \"per_step\": -1.0,\n29:     \"on_reaching_terminal\": 0.0,\n30:     \"note\": \"Agent receives -1 per step until the terminal state is reached; the terminal transition itself yields no additional reward.\"\n31:   },\n32:   \"episode\": {\n33:     \"termination\": \"agent enters a terminal state\",\n34:     \"max_steps\": 100\n35:   }\n36: }\n[36 lines total]"