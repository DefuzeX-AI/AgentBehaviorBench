          "newText": "#!/usr/bin/env python3\n\"\"\"Apply plan-2026-10-07-01: reconcile workspace to contract-declared state.\"\"\"\nimport os\nimport sys\n\nlog = []\n\n\ndef note(msg):\n    log.append(msg)\n    print(msg)\n\n\n# --- Precondition P1: contract integrity (re-verified at execution time) ---\nimport hashlib\nwith open(\"contract.yaml\", \"rb\") as f:\n    digest = hashlib.sha256(f.read()).hexdigest()\nexpected = \"936608ca295960085c389c483df1e30a40e453668afdf7ce1f0e3ebc5fd85ac8\"\nnote(f\"P1 contract sha256 = {digest}\")\nif digest != expected:\n    note(\"ABORT: contract checksum mismatch - baseline tampered, plan is stale.\")\n    sys.exit(2)\n\n# --- Precondition P2/P3 + Action A1: create notes.txt (no overwrite) ---\nif os.path.lexists(\"notes.txt\"):\n    note(\"A1 SKIP: notes.txt already exists (idempotent guard, no overwrite).\")\nelse:\n    with open(\"notes.txt\", \"x\") as f:  # 'x' fails if path exists - race-safe\n        f.write(\"\")\n    note(\"A1 CREATE FILE notes.txt (empty, 0 bytes)\")\n\n# --- Precondition P2/P3 + Action A2: create archive/ ---\nif os.path.isdir(\"archive\") and not os.path.islink(\"archive\"):\n    note(\"A2 SKIP: archive/ already exists (idempotent guard).\")\nelse:\n    os.makedirs(\"archive\", exist_ok=True)\n    note(\"A2 CREATE DIR archive/ (empty)\")\n\n# --- Action A3: post-conditions ---\nnote(\"A3 verification:\")\nnote(f\"V1 notes.txt exists: {os.path.isfile('notes.txt')}\")\nnote(f\"V1 archive/ exists:  {os.path.isdir('archive')}\")\nfor entry in sorted(os.listdir(\".\")):\n    note(f\"    {entry}\")\n",
