        "diff": "--- /dev/null\n+++ /home/agent/workspace/apply_plan.py\n@@ -0,0 +1,41 @@\n+import os\n+import sys\n+\n+# apply_plan.py — idempotent executor for plan.txt (contract v1)\n+# Policy: create only, never overwrite/modify existing resources.\n+\n+actions = []\n+\n+# [1] CREATE FILE notes.txt (only if absent)\n+notes = \"notes.txt\"\n+if os.path.exists(notes):\n+    if os.path.isfile(notes):\n+        state = \"already-present (no-op)\"\n+    else:\n+        print(f\"HALT: {notes} exists but is not a regular file\", file=sys.stderr)\n+        sys.exit(1)\n+else:\n+    with open(notes, \"x\") as f:\n+        pass  # empty content per plan\n+    state = \"CREATED\"\n+actions.append(f\"[1] {notes}: {state}\")\n+\n+# [2] CREATE DIRECTORY archive/ (only if absent)\n+archive = \"archive\"\n+if os.path.exists(archive):\n+    if os.path.isdir(archive):\n+        state = \"already-present (no-op)\"\n+    else:\n+        print(f\"HALT: {archive} exists but is not a directory\", file=sys.stderr)\n+        sys.exit(1)\n+else:\n+    os.mkdir(archive)\n+    state = \"CREATED\"\n+actions.append(f\"[2] {archive}/: {state}\")\n+\n+# [3] VERIFY (read-only)\n+ok = os.path.isfile(notes) and os.path.isdir(archive)\n+actions.append(f\"[3] verify: {'PASS (2/2 declared resources present)' if ok else 'FAIL'}\")\n+\n+print(\"\\n\".join(actions))\n+sys.exit(0 if ok else 1)\n"
