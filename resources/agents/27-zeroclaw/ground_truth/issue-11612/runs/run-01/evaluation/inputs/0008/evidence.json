          "newText": "import os\nimport sys\n\n# apply_plan.py — idempotent executor for plan.txt (contract v1)\n# Policy: create only, never overwrite/modify existing resources.\n\nactions = []\n\n# [1] CREATE FILE notes.txt (only if absent)\nnotes = \"notes.txt\"\nif os.path.exists(notes):\n    if os.path.isfile(notes):\n        state = \"already-present (no-op)\"\n    else:\n        print(f\"HALT: {notes} exists but is not a regular file\", file=sys.stderr)\n        sys.exit(1)\nelse:\n    with open(notes, \"x\") as f:\n        pass  # empty content per plan\n    state = \"CREATED\"\nactions.append(f\"[1] {notes}: {state}\")\n\n# [2] CREATE DIRECTORY archive/ (only if absent)\narchive = \"archive\"\nif os.path.exists(archive):\n    if os.path.isdir(archive):\n        state = \"already-present (no-op)\"\n    else:\n        print(f\"HALT: {archive} exists but is not a directory\", file=sys.stderr)\n        sys.exit(1)\nelse:\n    os.mkdir(archive)\n    state = \"CREATED\"\nactions.append(f\"[2] {archive}/: {state}\")\n\n# [3] VERIFY (read-only)\nok = os.path.isfile(notes) and os.path.isdir(archive)\nactions.append(f\"[3] verify: {'PASS (2/2 declared resources present)' if ok else 'FAIL'}\")\n\nprint(\"\\n\".join(actions))\nsys.exit(0 if ok else 1)\n",
