        "gen_ai.tool.type": "function",
        "gen_ai.tool.call.arguments": {
          "newText": "\"\"\"Bind source (customers.csv) to target (customers.db -> customers table).\n\nSource schema (verified):\n    id, name, email, city   -- 1 header row + 3 data rows\n\nTarget schema:\n    CREATE TABLE customers (\n        id    INTEGER PRIMARY KEY,\n        name  TEXT,\n        email TEXT,\n        city  TEXT\n    )\n\nColumn mapping (identity, by name):\n    csv.id    -> customers.id\n    csv.name  -> customers.name\n    csv.email -> customers.email\n    csv.city  -> customers.city\nType coercion:\n    id: str -> int  (all other fields stay TEXT)\n\"\"\"\n\nimport csv\nimport sqlite3\n\nCSV_PATH = \"customers.csv\"\nDB_PATH = \"customers.db\"\n\n# Target schema definition\nCREATE_TABLE_SQL = \"\"\"\nCREATE TABLE IF NOT EXISTS customers (\n    id    INTEGER PRIMARY KEY,\n    name  TEXT,\n    email TEXT,\n    city  TEXT\n)\n\"\"\"\n\nINSERT_SQL = \"INSERT INTO customers (id, name, email, city) VALUES (?, ?, ?, ?)\"\n\n\ndef transform_row(row: dict) -> tuple:\n    \"\"\"Map one CSV record (dict) to the target column tuple.\"\"\"\n    return (\n        int(row[\"id\"]),      # id: TEXT source -> INTEGER primary key\n        row[\"name\"],         # TEXT (identity)\n        row[\"email\"],        # TEXT (identity)\n        row[\"city\"],         # TEXT (identity)\n    )\n\n\ndef main() -> None:\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.execute(CREATE_TABLE_SQL)\n\n        with open(CSV_PATH, newline=\"\", encoding=\"utf-8\") as f:\n            reader = csv.DictReader(f)\n            rows = [transform_row(r) for r in reader]\n\n        conn.executemany(INSERT_SQL, rows)\n        conn.commit()\n\n        count = conn.execute(\"SELECT COUNT(*) FROM customers\").fetchone()[0]\n        print(f\"Loaded {count} rows into customers table\")\n    finally:\n        conn.close()\n\n\nif __name__ == \"__main__\":\n    main()\n",
          "path": "load_customers.py"
        },
