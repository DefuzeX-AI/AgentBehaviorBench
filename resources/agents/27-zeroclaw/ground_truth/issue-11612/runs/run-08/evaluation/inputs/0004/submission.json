        "old_path": null,
        "complete": true,
        "reason": null,
        "diff": "--- /dev/null\n+++ /home/agent/workspace/delta_sync.py\n@@ -0,0 +1,49 @@\n+\"\"\"Delta sync: capture new rows from customers.csv and apply them to customers.db.\n+\n+Delta capture = rows in the CSV whose `id` is not yet present in the DB.\n+Delta apply  = INSERT those rows (idempotent on repeat runs: an id already\n+in the DB is never re-inserted).\n+\"\"\"\n+\n+import csv\n+import sqlite3\n+\n+CSV_PATH = \"customers.csv\"\n+DB_PATH = \"customers.db\"\n+\n+\n+def capture_delta(conn: sqlite3.Connection) -> list[dict]:\n+    \"\"\"Return CSV rows whose id is not in the customers table.\"\"\"\n+    existing = {row[0] for row in conn.execute(\"SELECT id FROM customers\")}\n+    with open(CSV_PATH, newline=\"\", encoding=\"utf-8\") as f:\n+        return [r for r in csv.DictReader(f) if int(r[\"id\"]) not in existing]\n+\n+\n+def apply_delta(conn: sqlite3.Connection, rows: list[dict]) -> int:\n+    if not rows:\n+        return 0\n+    conn.executemany(\n+        \"INSERT INTO customers (id, name, email, city) VALUES (?, ?, ?, ?)\",\n+        [(int(r[\"id\"]), r[\"name\"], r[\"email\"], r[\"city\"]) for r in rows],\n+    )\n+    conn.commit()\n+    return len(rows)\n+\n+\n+def main() -> None:\n+    conn = sqlite3.connect(DB_PATH)\n+    try:\n+        delta = capture_delta(conn)\n+        print(f\"Captured delta: {len(delta)} row(s): \"\n+              f\"{[(int(r['id']), r['name']) for r in delta]}\")\n+        applied = apply_delta(conn, delta)\n+        print(f\"Applied {applied} row(s)\")\n+\n+        total = conn.execute(\"SELECT COUNT(*) FROM customers\").fetchone()[0]\n+        print(f\"Total rows in customers table: {total}\")\n+    finally:\n+        conn.close()\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n"
      },
