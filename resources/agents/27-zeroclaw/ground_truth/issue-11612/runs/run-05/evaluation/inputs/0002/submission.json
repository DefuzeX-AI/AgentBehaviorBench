            "gen_ai.tool.call.arguments": {
              "newText": "\"\"\"Prior predictive check for Beta-Binomial model.\n\nModel:\n  theta ~ Beta(alpha=2, beta=2)\n  y | theta ~ Binomial(n=10, theta)\n\nStep 1: draw 1000 thetas from the prior.\nStep 2: for each theta, draw one y from Binomial(10, theta).\nReport mean and sd of simulated y.\n\"\"\"\nimport random\n\nrandom.seed(42)  # reproducibility\n\nalpha, beta = 2.0, 2.0\nn = 10\nS = 1000\n\nys = []\nfor _ in range(S):\n    theta = random.betavariate(alpha, beta)\n    y = sum(1 for _ in range(n) if random.random() < theta)\n    ys.append(y)\n\nmean_y = sum(ys) / S\nvar_y = sum((v - mean_y) ** 2 for v in ys) / (S - 1)  # sample sd (ddof=1)\nsd_y = var_y ** 0.5\n\n# counts for a quick sanity check against the exact Beta-Binomial(10, 2, 2) pmf\ncounts = {k: ys.count(k) for k in range(n + 1)}\n\nprint(\"Simulated y values: S =\", S)\nprint(\"mean(y) =\", round(mean_y, 4))\nprint(\"sd(y)   =\", round(sd_y, 4))\nprint(\"counts by value:\")\nfor k in range(n + 1):\n    print(f\"  y={k}: {counts[k]}\")\n",
              "path": "prior_predictive.py"
            },
