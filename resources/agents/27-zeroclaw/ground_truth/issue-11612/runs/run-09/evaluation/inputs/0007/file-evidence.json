        "diff": "--- /dev/null\n+++ /home/agent/workspace/sync_workspace/cutover.py\n@@ -0,0 +1,50 @@\n+import json\n+import os\n+\n+D = \"sync_workspace\"\n+TOMB = \"__tombstone__\"\n+\n+def load(p):\n+    with open(p) as f:\n+        return json.load(f)\n+\n+def save(p, doc):\n+    with open(p, \"w\") as f:\n+        json.dump(doc, f, indent=2)\n+        f.write(\"\\n\")\n+\n+ok = True\n+def check(label, cond, detail=\"\"):\n+    global ok\n+    print(f\"  {'PASS' if cond else 'FAIL'}  {label}{'' if cond else '  ' + detail}\")\n+    ok = ok and cond\n+\n+# ---- Step 1: cutover renames ----\n+# source.json -> source_old.json, then target.json -> source.json\n+os.rename(f\"{D}/source.json\", f\"{D}/source_old.json\")\n+os.rename(f\"{D}/target.json\", f\"{D}/source.json\")\n+\n+# ---- Step 2: new empty target.json (empty JSON object, consistent with init convention) ----\n+save(f\"{D}/target.json\", {})\n+\n+print(\"Cutover complete: source_old.json (archive) | source.json (ex-target) | target.json (fresh)\\n\")\n+\n+# ---- Step 3: verify new source.json carries expected data incl. tombstone ----\n+print(\"Verification — new source.json:\")\n+src = load(f\"{D}/source.json\")\n+check(\"name == 'Alice'\", src.get(\"name\") == \"Alice\", f\"(got {src.get('name')!r})\")\n+check(\"age == 31\", src.get(\"age\") == 31, f\"(got {src.get('age')!r})\")\n+check(\"country == 'USA'\", src.get(\"country\") == \"USA\", f\"(got {src.get('country')!r})\")\n+check(\"city tombstone present\", isinstance(src.get(\"city\"), dict) and src[\"city\"].get(TOMB) is True,\n+      f\"(got {src.get('city')!r})\")\n+check(\"no live 'New York' value anywhere\", \"New York\" not in json.dumps(src))\n+\n+print(\"\\nVerification — new target.json:\")\n+tgt_raw = open(f\"{D}/target.json\").read()\n+tgt = load(f\"{D}/target.json\")\n+check(\"parses as valid JSON\", True)\n+check(\"is empty (no keys)\", len(tgt) == 0, f\"(got {json.dumps(tgt)})\")\n+check(\"no tombstones inside\", TOMB not in json.dumps(tgt))\n+\n+print()\n+print(\"RESULT:\", \"ALL CHECKS PASSED\" if ok else \"FAILURES DETECTED\")\n"
