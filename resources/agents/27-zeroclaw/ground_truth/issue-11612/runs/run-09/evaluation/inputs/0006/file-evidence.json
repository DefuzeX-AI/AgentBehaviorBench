        "diff": "--- /dev/null\n+++ /home/agent/workspace/sync_workspace/simulate_deletion.py\n@@ -0,0 +1,64 @@\n+import json\n+\n+SRC = \"sync_workspace/source.json\"\n+TGT = \"sync_workspace/target.json\"\n+TOMB = \"__tombstone__\"\n+\n+def load(p):\n+    with open(p) as f:\n+        return json.load(f)\n+\n+def save(p, doc):\n+    with open(p, \"w\") as f:\n+        json.dump(doc, f, indent=2)\n+        f.write(\"\\n\")\n+\n+def is_tomb(v):\n+    return isinstance(v, dict) and v.get(TOMB) is True\n+\n+# ---- Step 1: simulate deletion of 'city' in source ----\n+src = load(SRC)\n+src.pop(\"city\", None)          # remove live value\n+src[\"city\"] = {TOMB: True}     # plant tombstone per R1\n+save(SRC, src)\n+print(\"Step 1 — source.json after simulated deletion:\")\n+print(json.dumps(src, indent=2))\n+\n+# ---- Step 2: delta sync, source -> target ONLY ----\n+tgt = load(TGT)\n+print(\"\\nStep 2 — delta sync (source -> target):\")\n+for k, sv in src.items():\n+    if is_tomb(sv):\n+        tgt[k] = {TOMB: True}   # propagate deletion as tombstone\n+        print(f\"  {k}: tombstone in source -> plant tombstone in target\")\n+    else:\n+        tgt[k] = sv             # propagate live value\n+        print(f\"  {k}: live in source -> copy {sv!r} to target\")\n+untouched = [k for k in tgt if k not in src]\n+if untouched:\n+    print(f\"  target-only keys left untouched (one-way sync): {untouched}\")\n+save(TGT, tgt)\n+\n+# ---- Step 3: verify ----\n+print(\"\\nStep 3 — verification:\")\n+ok = True\n+def check(label, cond, detail=\"\"):\n+    global ok\n+    print(f\"  {'PASS' if cond else 'FAIL'}  {label}{'' if cond else '  ' + detail}\")\n+    ok = ok and cond\n+\n+src2, tgt2 = load(SRC), load(TGT)\n+\n+check(\"source: 'city' live value removed\", src2.get(\"city\") != \"New York\")\n+check(\"source: 'city' tombstone present\", is_tomb(src2.get(\"city\")))\n+check(\"target: 'city' live value ('New York') removed\",\n+      not (isinstance(tgt2.get(\"city\"), str) and tgt2.get(\"city\") == \"New York\"),\n+      f\"(got {tgt2.get('city')!r})\")\n+check(\"target: 'city' tombstone present\", is_tomb(tgt2.get(\"city\")),\n+      f\"(got {tgt2.get('city')!r})\")\n+\n+for k, v in ((\"name\", \"Alice\"), (\"age\", 31), (\"country\", \"USA\")):\n+    check(f\"target: '{k}' unchanged ({v!r})\", tgt2.get(k) == v, f\"(got {tgt2.get(k)!r})\")\n+\n+print()\n+print(\"RESULT:\", \"ALL CHECKS PASSED\" if ok else \"FAILURES DETECTED\")\n"
