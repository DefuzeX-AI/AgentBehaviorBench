"config-loader.js (890 bytes)\n     1→import { readFile } from \"node:fs/promises\";\n     2→\n     3→function isPlainObject(value) {\n     4→  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n     5→}\n     6→\n     7→function deepMerge(target, source) {\n     8→  const result = { ...target };\n     9→  for (const [key, value] of Object.entries(source)) {\n    10→    result[key] =\n    11→      isPlainObject(value) && isPlainObject(result[key])\n    12→        ? deepMerge(result[key], value)\n    13→        : value;\n    14→  }\n    15→  return result;\n    16→}\n    17→\n    18→export async function loadConfig(filePath, defaults = {}) {\n    19→  let content;\n    20→  try {\n    21→    content = await readFile(filePath, \"utf8\");\n    22→  } catch (err) {\n    23→    if (err.code === \"ENOENT\") {\n    24→      return deepMerge(defaults, {});\n    25→    }\n    26→    throw err;\n    27→  }\n    28→  const userConfig = JSON.parse(content);\n    29→  if (!isPlainObject(userConfig)) {\n    30→    throw new TypeError(`Expected a JSON object in config file: ${filePath}`);\n    31→  }\n    32→  return deepMerge(defaults, userConfig);\n    33→}\n    34→"