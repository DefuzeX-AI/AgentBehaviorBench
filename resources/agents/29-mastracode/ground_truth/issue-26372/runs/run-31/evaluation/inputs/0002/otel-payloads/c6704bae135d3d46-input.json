"{\"content\":\"import { test, before, after } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport { mkdtemp, writeFile, rm } from \\\"node:fs/promises\\\";\\nimport { tmpdir } from \\\"node:os\\\";\\nimport { join } from \\\"node:path\\\";\\nimport { loadConfig } from \\\"../config-loader.js\\\";\\n\\nlet dir;\\n\\nbefore(async () => {\\n  dir = await mkdtemp(join(tmpdir(), \\\"config-loader-\\\"));\\n});\\n\\nafter(async () => {\\n  await rm(dir, { recursive: true, force: true });\\n});\\n\\nasync function writeConfig(name, content) {\\n  const file = join(dir, name);\\n  await writeFile(file, content);\\n  return file;\\n}\\n\\ntest(\\\"user values take precedence over defaults\\\", async () => {\\n  const file = await writeConfig(\\n    \\\"flat.json\\\",\\n    JSON.stringify({ port: 8080, host: \\\"example.com\\\" })\\n  );\\n  const config = await loadConfig(file, { port: 3000, debug: true });\\n  assert.deepEqual(config, { port: 8080, host: \\\"example.com\\\", debug: true });\\n});\\n\\ntest(\\\"nested objects are deep merged with user precedence\\\", async () => {\\n  const file = await writeConfig(\\n    \\\"nested.json\\\",\\n    JSON.stringify({ db: { host: \\\"prod-db\\\" } })\\n  );\\n  const config = await loadConfig(file, {\\n    db: { host: \\\"localhost\\\", port: 5432 },\\n    retries: 3,\\n  });\\n  assert.deepEqual(config, {\\n    db: { host: \\\"prod-db\\\", port: 5432 },\\n    retries: 3,\\n  });\\n});\\n\\ntest(\\\"arrays from user config replace defaults\\\", async () => {\\n  const file = await writeConfig(\\n    \\\"arrays.json\\\",\\n    JSON.stringify({ tags: [\\\"prod\\\"] })\\n  );\\n  const config = await loadConfig(file, { tags: [\\\"dev\\\", \\\"test\\\"] });\\n  assert.deepEqual(config, { tags: [\\\"prod\\\"] });\\n});\\n\\ntest(\\\"defaults object is not mutated\\\", async () => {\\n  const file = await writeConfig(\\n    \\\"nomutate.json\\\",\\n    JSON.stringify({ port: 9000 })\\n  );\\n  const defaults = { port: 3000, db: { host: \\\"localhost\\\" } };\\n  await loadConfig(file, defaults);\\n  assert.deepEqual(defaults, { port: 3000, db: { host: \\\"localhost\\\" } });\\n});\\n\\ntest(\\\"invalid JSON is rejected\\\", async () => {\\n  const file = await writeConfig(\\\"bad.json\\\", \\\"{not json\\\");\\n  await assert.rejects(() => loadConfig(file, {}));\\n});\\n\\ntest(\\\"non-object config is rejected\\\", async () => {\\n  const file = await writeConfig(\\\"nonobject.json\\\", '\\\"just a string\\\"');\\n  await assert.rejects(\\n    () => loadConfig(file, {}),\\n    { name: \\\"TypeError\\\" }\\n  );\\n});\\n\",\"path\":\"test/config-loader.test.js\"}"