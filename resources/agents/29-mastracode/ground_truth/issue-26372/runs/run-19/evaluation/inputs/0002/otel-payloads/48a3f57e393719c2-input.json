"{\"content\":\"#!/usr/bin/env bash\\n# Test the compiler: compile each example, assemble/link it, run it, and\\n# compare the exit status (the program's value, mod 256) with the expectation.\\nset -euo pipefail\\ncd \\\"$(dirname \\\"$0\\\")\\\"\\n\\nBUILD=build\\nCOMPILER=src/compiler.py\\npass=0\\nfail=0\\nmkdir -p \\\"$BUILD\\\"\\n\\ncheck() {\\n    local name=\\\"$1\\\" expected=\\\"$2\\\"\\n    local asm=\\\"$BUILD/$name.s\\\" exe=\\\"$BUILD/$name\\\"\\n\\n    if ! python3 \\\"$COMPILER\\\" \\\"examples/$name.k\\\" -o \\\"$asm\\\"; then\\n        echo \\\"FAIL $name: compiler error\\\"\\n        fail=$((fail + 1))\\n        return\\n    fi\\n    if ! gcc -Wall -o \\\"$exe\\\" \\\"$asm\\\"; then\\n        echo \\\"FAIL $name: assembly/link error\\\"\\n        fail=$((fail + 1))\\n        return\\n    fi\\n\\n    local status=0\\n    \\\"$exe\\\" || status=$?\\n    if [ \\\"$status\\\" -eq \\\"$expected\\\" ]; then\\n        echo \\\"PASS $name (exit $status)\\\"\\n        pass=$((pass + 1))\\n    else\\n        echo \\\"FAIL $name: expected exit $expected, got $status\\\"\\n        fail=$((fail + 1))\\n    fi\\n}\\n\\ncheck return42 42    # return 42;\\ncheck arith 14       # return 2 + 3 * 4;      (precedence)\\ncheck parens 9       # return (1 + 2) * 3;    (grouping)\\ncheck sub 5          # return 10 - 3 - 2;     (left-associative)\\ncheck division 12    # return 84 / 7;         (integer division)\\ncheck unary 252      # return -4;             (exit statuses are mod 256)\\n\\n# Negative test: invalid source must be rejected with a nonzero exit.\\nif python3 \\\"$COMPILER\\\" examples/bad.k -o \\\"$BUILD/bad.s\\\" 2>\\\"$BUILD/bad.err\\\"; then\\n    echo \\\"FAIL bad.k: compiler accepted invalid input\\\"\\n    fail=$((fail + 1))\\nelse\\n    echo \\\"PASS bad.k (rejected: $(cat \\\"$BUILD/bad.err\\\"))\\\"\\n    pass=$((pass + 1))\\nfi\\n\\necho\\necho \\\"$pass passed, $fail failed\\\"\\n[ \\\"$fail\\\" -eq 0 ]\\n\",\"path\":\"test.sh\"}"