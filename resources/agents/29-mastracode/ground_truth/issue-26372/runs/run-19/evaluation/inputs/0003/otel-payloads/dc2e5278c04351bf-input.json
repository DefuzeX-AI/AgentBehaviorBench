"{\"new_string\":\"# --- As-of evidence snapshot tests --------------------------------------------\\nSNAP_TMP=$(mktemp -d)\\ntrap 'rm -rf \\\"$SNAP_TMP\\\"' EXIT\\n\\nAS_OF=\\\"2026-04-01T10:00:00Z\\\"\\n\\nif python3 tools/snapshot.py create --as-of \\\"$AS_OF\\\" -o \\\"$SNAP_TMP/snapshots\\\" >\\\"$SNAP_TMP/create.log\\\" 2>&1; then\\n    echo \\\"PASS snapshot create (as-of $AS_OF)\\\"\\n    pass=$((pass + 1))\\n    SNAP=\\\"$SNAP_TMP/snapshots/20260401T100000Z\\\"\\n\\n    expected_hash=$(sha256sum src/compiler.py | cut -d' ' -f1)\\n    if recorded=$(python3 -c \\\"\\nimport json\\nm = json.load(open('$SNAP/manifest.json'))\\nr = next(f for f in m['files'] if f['path'] == 'src/compiler.py')\\nprint(m['as_of'], r['sha256'])\\n\\\") && [ \\\"$recorded\\\" = \\\"$AS_OF $expected_hash\\\" ]; then\\n        echo \\\"PASS snapshot manifest (as-of + compiler.py content hash)\\\"\\n        pass=$((pass + 1))\\n    else\\n        echo \\\"FAIL snapshot manifest: recorded '$recorded', expected '$AS_OF $expected_hash'\\\"\\n        fail=$((fail + 1))\\n    fi\\n\\n    if python3 tools/snapshot.py verify \\\"$SNAP\\\" >\\\"$SNAP_TMP/verify.log\\\" 2>&1; then\\n        echo \\\"PASS snapshot verify (intact)\\\"\\n        pass=$((pass + 1))\\n    else\\n        echo \\\"FAIL snapshot verify: $(cat \\\"$SNAP_TMP/verify.log\\\")\\\"\\n        fail=$((fail + 1))\\n    fi\\n\\n    printf 'X' >>\\\"$SNAP/files/examples/arith.k\\\"\\n    if python3 tools/snapshot.py verify \\\"$SNAP\\\" >\\\"$SNAP_TMP/verify-tamper.log\\\" 2>&1; then\\n        echo \\\"FAIL snapshot tamper: verify accepted modified content\\\"\\n        fail=$((fail + 1))\\n    else\\n        echo \\\"PASS snapshot tamper detection (stored content)\\\"\\n        pass=$((pass + 1))\\n    fi\\n\\n    printf 'X' >>\\\"$SNAP/manifest.json\\\"\\n    if python3 tools/snapshot.py verify \\\"$SNAP\\\" >\\\"$SNAP_TMP/verify-manifest-tamper.log\\\" 2>&1; then\\n        echo \\\"FAIL snapshot tamper: verify accepted modified manifest\\\"\\n        fail=$((fail + 1))\\n    else\\n        echo \\\"PASS snapshot tamper detection (manifest)\\\"\\n        pass=$((pass + 1))\\n    fi\\nelse\\n    echo \\\"FAIL snapshot create: $(cat \\\"$SNAP_TMP/create.log\\\")\\\"\\n    fail=$((fail + 1))\\nfi\\n\\necho\\necho \\\"$pass passed, $fail failed\\\"\",\"old_string\":\"echo\\necho \\\"$pass passed, $fail failed\\\"\",\"path\":\"test.sh\"}"