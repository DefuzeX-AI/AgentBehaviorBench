"build.sh (508 bytes)\n     1→#!/usr/bin/env bash\n     2→# Build the compiler toolchain: bytecode-compile the compiler and prepare build/.\n     3→set -euo pipefail\n     4→cd \"$(dirname \"$0\")\"\n     5→\n     6→command -v gcc >/dev/null || {\n     7→    echo \"error: gcc is required to assemble and link test programs\" >&2\n     8→    exit 1\n     9→}\n    10→\n    11→mkdir -p build\n    12→\n    13→# Bytecode-compile so syntax/import errors surface here rather than at test time.\n    14→PYTHONPYCACHEPREFIX=build/pycache python3 -m py_compile src/compiler.py\n    15→chmod +x src/compiler.py test.sh\n    16→\n    17→echo \"Build OK (compiler: src/compiler.py)\"\n    18→"