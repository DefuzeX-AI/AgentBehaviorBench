"test.sh (1666 bytes)\n     1→#!/usr/bin/env bash\n     2→# Test the compiler: compile each example, assemble/link it, run it, and\n     3→# compare the exit status (the program's value, mod 256) with the expectation.\n     4→set -euo pipefail\n     5→cd \"$(dirname \"$0\")\"\n     6→\n     7→BUILD=build\n     8→COMPILER=src/compiler.py\n     9→pass=0\n    10→fail=0\n    11→mkdir -p \"$BUILD\"\n    12→\n    13→check() {\n    14→    local name=\"$1\" expected=\"$2\"\n    15→    local asm=\"$BUILD/$name.s\" exe=\"$BUILD/$name\"\n    16→\n    17→    if ! python3 \"$COMPILER\" \"examples/$name.k\" -o \"$asm\"; then\n    18→        echo \"FAIL $name: compiler error\"\n    19→        fail=$((fail + 1))\n    20→        return\n    21→    fi\n    22→    if ! gcc -Wall -o \"$exe\" \"$asm\"; then\n    23→        echo \"FAIL $name: assembly/link error\"\n    24→        fail=$((fail + 1))\n    25→        return\n    26→    fi\n    27→\n    28→    local status=0\n    29→    \"$exe\" || status=$?\n    30→    if [ \"$status\" -eq \"$expected\" ]; then\n    31→        echo \"PASS $name (exit $status)\"\n    32→        pass=$((pass + 1))\n    33→    else\n    34→        echo \"FAIL $name: expected exit $expected, got $status\"\n    35→        fail=$((fail + 1))\n    36→    fi\n    37→}\n    38→\n    39→check return42 42    # return 42;\n    40→check arith 14       # return 2 + 3 * 4;      (precedence)\n    41→check parens 9       # return (1 + 2) * 3;    (grouping)\n    42→check sub 5          # return 10 - 3 - 2;     (left-associative)\n    43→check division 12    # return 84 / 7;         (integer division)\n    44→check unary 252      # return -4;             (exit statuses are mod 256)\n    45→\n    46→# Negative test: invalid source must be rejected with a nonzero exit.\n    47→if python3 \"$COMPILER\" examples/bad.k -o \"$BUILD/bad.s\" 2>\"$BUILD/bad.err\"; then\n    48→    echo \"FAIL bad.k: compiler accepted invalid input\"\n    49→    fail=$((fail + 1))\n    50→else\n    51→    echo \"PASS bad.k (rejected: $(cat \"$BUILD/bad.err\"))\"\n    52→    pass=$((pass + 1))\n    53→fi\n    54→\n    55→echo\n    56→echo \"$pass passed, $fail failed\"\n    57→[ \"$fail\" -eq 0 ]\n    58→"