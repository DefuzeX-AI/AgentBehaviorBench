"{\"content\":\"\\\"\\\"\\\"Bounded model checking for the FSM defined in model.py.\\n\\nExplores every state reachable from the initial states within k steps\\n(step 0 is the initial state, step i is after i transitions) and reports\\nwhether any bad state - i.e. any violation of the safety property - is\\nreachable. On a violation the counterexample trace is written to\\ncounterexample.txt, otherwise result.txt is written.\\n\\nUsage:\\n    python checker.py K\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport sys\\nfrom pathlib import Path\\n\\nfrom model import BAD, INITIAL, NEXT, State\\n\\n\\ndef bmc(k: int) -> tuple[list[int], tuple[int, State, list[State]] | None]:\\n    \\\"\\\"\\\"Explore all states reachable within k steps.\\n\\n    Returns the number of new states found at each step 0..k and, if the\\n    safety property is violated, a counterexample (step, bad_state, trace)\\n    where trace is a path from an initial state to the bad state;\\n    otherwise None.\\n    \\\"\\\"\\\"\\n    seen: set[State] = set()\\n    parent: dict[State, State] = {}\\n    counts: list[int] = []\\n    counterexample = None\\n    frontier: list[State] = []\\n    for step in range(k + 1):\\n        if step == 0:\\n            new = set(INITIAL)\\n        else:\\n            new = set()\\n            for state in frontier:\\n                for succ in NEXT[state]:\\n                    if succ not in seen and succ not in new:\\n                        new.add(succ)\\n                        parent[succ] = state\\n        seen |= new\\n        counts.append(len(new))\\n        frontier = sorted(new, key=repr)\\n        if counterexample is None:\\n            bad = new & BAD\\n            if bad:\\n                bad_state = min(bad, key=repr)\\n                counterexample = (step, bad_state, _trace(bad_state, parent))\\n    return counts, counterexample\\n\\n\\ndef _trace(state: State, parent: dict[State, State]) -> list[State]:\\n    \\\"\\\"\\\"Path from an initial state to `state` via first-discovery parents.\\\"\\\"\\\"\\n    path = [state]\\n    while state in parent:\\n        state = parent[state]\\n        path.append(state)\\n    path.reverse()\\n    return path\\n\\n\\ndef _fmt(state: State) -> str:\\n    return \\\"(\\\" + \\\", \\\".join(phase.name for phase in state) + \\\")\\\"\\n\\n\\ndef main(argv: list[str] | None = None) -> int:\\n    parser = argparse.ArgumentParser(\\n        description=\\\"Bounded model checking of the FSM in model.py.\\\"\\n    )\\n    parser.add_argument(\\\"k\\\", type=int, help=\\\"explore up to this many steps\\\")\\n    args = parser.parse_args(argv)\\n    if args.k < 0:\\n        parser.error(\\\"k must be non-negative\\\")\\n\\n    counts, counterexample = bmc(args.k)\\n    for step, count in enumerate(counts):\\n        print(f\\\"step {step}: {count} new state(s)\\\")\\n    total = sum(counts)\\n    if counterexample is None:\\n        message = f\\\"No counterexample found within bound {args.k}\\\"\\n        print(f\\\"{message} ({total} states explored)\\\")\\n        Path(\\\"result.txt\\\").write_text(message + \\\"\\\\n\\\")\\n        return 0\\n    step, _, trace = counterexample\\n    print(f\\\"UNSAFE: bad state reachable at step {step} of {args.k}\\\")\\n    lines = [f\\\"step {i}: {_fmt(state)}\\\" for i, state in enumerate(trace)]\\n    for line in lines:\\n        print(line)\\n    Path(\\\"counterexample.txt\\\").write_text(\\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\")\\n    return 1\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\"path\":\"bmc/checker.py\"}"