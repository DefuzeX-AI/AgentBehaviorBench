"{\"command\":\"python3 - <<'EOF'\\nimport model, checker\\n\\n# Simulate a buggy protocol: WAITING -> CRITICAL without the guard.\\ndef unguarded(mine, other):\\n    moves = {mine}\\n    if mine is model.Phase.IDLE:\\n        moves.add(model.Phase.WAITING)\\n    elif mine is model.Phase.WAITING:\\n        moves.add(model.Phase.CRITICAL)\\n    else:\\n        moves.add(model.Phase.IDLE)\\n    return moves\\n\\nmodel._moves = unguarded\\nchecker.NEXT = {s: model._successors(s) for s in model.STATES}\\n\\ncounts, v = checker.bmc(3)\\nassert v is None, v\\ncounts, v = checker.bmc(4)\\nassert v is not None and v[0] == 4, v\\nprint(\\\"OK: violation first detected at step\\\", v[0], \\\"with\\\", len(v[1]), \\\"bad state(s)\\\")\\nEOF\\necho \\\"exit=$?\\\"\",\"cwd\":\"/home/agent/workspace/bmc\"}"