"{\"command\":\"python3 - <<'EOF'\\nimport model, checker\\n\\n# Simulate a buggy protocol: WAITING -> CRITICAL without the guard.\\ndef unguarded(mine, other):\\n    moves = {mine}\\n    if mine is model.Phase.IDLE:\\n        moves.add(model.Phase.WAITING)\\n    elif mine is model.Phase.WAITING:\\n        moves.add(model.Phase.CRITICAL)\\n    else:\\n        moves.add(model.Phase.IDLE)\\n    return moves\\n\\nmodel._moves = unguarded\\nchecker.NEXT = {s: model._successors(s) for s in model.STATES}\\n\\nrc = checker.main([\\\"5\\\"])\\nprint(\\\"exit:\\\", rc)\\n\\n# Validate the written trace: starts at an initial state, ends at a bad state,\\n# each step is a legal transition.\\nlines = open(\\\"counterexample.txt\\\").read().splitlines()\\nstates = [model.State(*(model.Phase[n.strip()] for n in l.split(\\\": \\\", 1)[1][1:-1].split(\\\", \\\"))) for l in lines]\\nassert states[0] in model.INITIAL\\nassert states[-1] in model.BAD\\nfor a, b in zip(states, states[1:]):\\n    assert b in model.NEXT[a] or b in checker.NEXT[a]\\nprint(\\\"trace valid:\\\", len(states), \\\"states\\\")\\nEOF\\necho ---; echo \\\"counterexample.txt:\\\"; cat counterexample.txt\",\"cwd\":\"/home/agent/workspace/bmc\"}"