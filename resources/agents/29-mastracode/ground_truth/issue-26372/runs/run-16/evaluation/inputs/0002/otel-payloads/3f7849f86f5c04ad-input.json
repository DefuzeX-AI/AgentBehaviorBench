"{\"content\":\"\\\"\\\"\\\"A finite state machine model for bounded model checking.\\n\\nThe model is a mutual-exclusion protocol for two processes. Each process\\nmoves through the phases IDLE, WAITING, CRITICAL and may also stall in\\nits current phase. The processes interleave: exactly one process advances\\nin each step.\\n\\nSafety property: the two processes are never in their critical sections\\nat the same time. The property is expressed as the set BAD of states in\\nwhich it is violated.\\n\\\"\\\"\\\"\\n\\nfrom enum import Enum, auto\\nfrom itertools import product\\n\\n\\nclass Phase(Enum):\\n    IDLE = auto()\\n    WAITING = auto()\\n    CRITICAL = auto()\\n\\n\\n# A state records the phase of each process (process 1, process 2).\\nState = tuple[Phase, Phase]\\n\\n# Finite set of states: 3 phases per process gives 9 states.\\nSTATES: frozenset[State] = frozenset(product(Phase, repeat=2))\\n\\n# Set of initial states: both processes start out idle.\\nINITIAL: frozenset[State] = frozenset({(Phase.IDLE, Phase.IDLE)})\\n\\n# Safety property as a set of bad states: violated exactly when both\\n# processes are inside their critical sections simultaneously.\\nBAD: frozenset[State] = frozenset(\\n    s for s in STATES if s[0] is Phase.CRITICAL and s[1] is Phase.CRITICAL\\n)\\n\\n\\ndef _moves(mine: Phase, other: Phase) -> set[Phase]:\\n    \\\"\\\"\\\"Phases `mine` may occupy after one step, given `other`'s phase.\\\"\\\"\\\"\\n    moves = {mine}  # a process may always stall\\n    if mine is Phase.IDLE:\\n        moves.add(Phase.WAITING)  # request the resource\\n    elif mine is Phase.WAITING:\\n        if other is not Phase.CRITICAL:  # enter only if the resource is free\\n            moves.add(Phase.CRITICAL)\\n    elif mine is Phase.CRITICAL:\\n        moves.add(Phase.IDLE)  # release the resource\\n    return moves\\n\\n\\ndef _successors(state: State) -> frozenset[State]:\\n    \\\"\\\"\\\"One-step successors: process 1 advances while process 2 stalls,\\n    or process 2 advances while process 1 stalls.\\\"\\\"\\\"\\n    first, second = state\\n    return frozenset(\\n        {(new, second) for new in _moves(first, second)}\\n        | {(first, new) for new in _moves(second, first)}\\n    )\\n\\n\\n# Next-state relation: maps each state to the states reachable in one step.\\nNEXT: dict[State, frozenset[State]] = {s: _successors(s) for s in STATES}\\n\\n\\ndef reachable() -> set[State]:\\n    \\\"\\\"\\\"States reachable from INITIAL via the NEXT relation.\\\"\\\"\\\"\\n    seen = set(INITIAL)\\n    frontier = list(INITIAL)\\n    while frontier:\\n        fresh = {succ for s in frontier for succ in NEXT[s]} - seen\\n        seen |= fresh\\n        frontier = list(fresh)\\n    return seen\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    # Sanity checks: the relation refers only to real states and is total\\n    # (every state has at least one successor).\\n    for state, successors in NEXT.items():\\n        assert state in STATES\\n        assert successors\\n        assert successors <= STATES\\n    assert INITIAL <= STATES\\n    assert BAD <= STATES\\n\\n    # The protocol is safe: no bad state is reachable from the initial states.\\n    seen = reachable()\\n    assert not seen & BAD\\n\\n    print(f\\\"states:         {len(STATES)}\\\")\\n    print(f\\\"initial states: {len(INITIAL)}\\\")\\n    print(f\\\"reachable:      {len(seen)}\\\")\\n    print(f\\\"bad states:     {len(BAD)} (none reachable - property holds)\\\")\\n\",\"path\":\"bmc/model.py\"}"