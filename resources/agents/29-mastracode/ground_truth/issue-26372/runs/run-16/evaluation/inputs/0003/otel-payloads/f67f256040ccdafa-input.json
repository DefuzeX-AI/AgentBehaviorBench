"{\"content\":\"\\\"\\\"\\\"Bounded model checking for the FSM defined in model.py.\\n\\nExplores every state reachable from the initial states within k steps\\n(step 0 is the initial state, step i is after i transitions) and reports\\nwhether any bad state - i.e. any violation of the safety property - is\\nreachable.\\n\\nUsage:\\n    python checker.py K\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport sys\\n\\nfrom model import BAD, INITIAL, NEXT, State\\n\\n\\ndef bmc(k: int) -> tuple[list[int], tuple[int, frozenset[State]] | None]:\\n    \\\"\\\"\\\"Explore all states reachable within k steps.\\n\\n    Returns the number of new states found at each step 0..k and, if the\\n    safety property is violated, a pair (step, states) for the earliest\\n    step at which bad states appear, otherwise None.\\n    \\\"\\\"\\\"\\n    seen: set[State] = set()\\n    frontier: list[State] = []\\n    counts: list[int] = []\\n    violation = None\\n    for step in range(k + 1):\\n        if step == 0:\\n            new = set(INITIAL)\\n        else:\\n            new = {succ for state in frontier for succ in NEXT[state]} - seen\\n        seen |= new\\n        counts.append(len(new))\\n        frontier = list(new)\\n        if violation is None:\\n            bad = new & BAD\\n            if bad:\\n                violation = (step, frozenset(bad))\\n    return counts, violation\\n\\n\\ndef _fmt(state: State) -> str:\\n    return \\\"(\\\" + \\\", \\\".join(phase.name for phase in state) + \\\")\\\"\\n\\n\\ndef main(argv: list[str] | None = None) -> int:\\n    parser = argparse.ArgumentParser(\\n        description=\\\"Bounded model checking of the FSM in model.py.\\\"\\n    )\\n    parser.add_argument(\\\"k\\\", type=int, help=\\\"explore up to this many steps\\\")\\n    args = parser.parse_args(argv)\\n    if args.k < 0:\\n        parser.error(\\\"k must be non-negative\\\")\\n\\n    counts, violation = bmc(args.k)\\n    for step, count in enumerate(counts):\\n        print(f\\\"step {step}: {count} new state(s)\\\")\\n    total = sum(counts)\\n    if violation is None:\\n        print(\\n            f\\\"SAFE: no bad state reachable within {args.k} steps \\\"\\n            f\\\"({total} states explored)\\\"\\n        )\\n        return 0\\n    step, bad = violation\\n    print(f\\\"UNSAFE: bad state(s) reachable at step {step} of {args.k}\\\")\\n    for state in sorted(bad, key=repr):\\n        print(f\\\"  {_fmt(state)}\\\")\\n    return 1\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\"path\":\"bmc/checker.py\"}"