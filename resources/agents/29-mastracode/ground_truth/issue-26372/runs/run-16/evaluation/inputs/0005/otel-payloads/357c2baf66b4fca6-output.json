"bmc/checker.py (2255 bytes)\n     1→\"\"\"Bounded model checking for the FSM defined in model.py.\n     2→\n     3→Explores every state reachable from the initial states within k steps\n     4→(step 0 is the initial state, step i is after i transitions) and reports\n     5→whether any bad state - i.e. any violation of the safety property - is\n     6→reachable.\n     7→\n     8→Usage:\n     9→    python checker.py K\n    10→\"\"\"\n    11→\n    12→import argparse\n    13→import sys\n    14→\n    15→from model import BAD, INITIAL, NEXT, State\n    16→\n    17→\n    18→def bmc(k: int) -> tuple[list[int], tuple[int, frozenset[State]] | None]:\n    19→    \"\"\"Explore all states reachable within k steps.\n    20→\n    21→    Returns the number of new states found at each step 0..k and, if the\n    22→    safety property is violated, a pair (step, states) for the earliest\n    23→    step at which bad states appear, otherwise None.\n    24→    \"\"\"\n    25→    seen: set[State] = set()\n    26→    frontier: list[State] = []\n    27→    counts: list[int] = []\n    28→    violation = None\n    29→    for step in range(k + 1):\n    30→        if step == 0:\n    31→            new = set(INITIAL)\n    32→        else:\n    33→            new = {succ for state in frontier for succ in NEXT[state]} - seen\n    34→        seen |= new\n    35→        counts.append(len(new))\n    36→        frontier = list(new)\n    37→        if violation is None:\n    38→            bad = new & BAD\n    39→            if bad:\n    40→                violation = (step, frozenset(bad))\n    41→    return counts, violation\n    42→\n    43→\n    44→def _fmt(state: State) -> str:\n    45→    return \"(\" + \", \".join(phase.name for phase in state) + \")\"\n    46→\n    47→\n    48→def main(argv: list[str] | None = None) -> int:\n    49→    parser = argparse.ArgumentParser(\n    50→        description=\"Bounded model checking of the FSM in model.py.\"\n    51→    )\n    52→    parser.add_argument(\"k\", type=int, help=\"explore up to this many steps\")\n    53→    args = parser.parse_args(argv)\n    54→    if args.k < 0:\n    55→        parser.error(\"k must be non-negative\")\n    56→\n    57→    counts, violation = bmc(args.k)\n    58→    for step, count in enumerate(counts):\n    59→        print(f\"step {step}: {count} new state(s)\")\n    60→    total = sum(counts)\n    61→    if violation is None:\n    62→        print(\n    63→            f\"SAFE: no bad state reachable within {args.k} steps \"\n    64→            f\"({total} states explored)\"\n    65→        )\n    66→        return 0\n    67→    step, bad = violation\n    68→    print(f\"UNSAFE: bad state(s) reachable at step {step} of {args.k}\")\n    69→    for state in sorted(bad, key=repr):\n    70→        print(f\"  {_fmt(state)}\")\n    71→    return 1\n    72→\n    73→\n    74→if __name__ == \"__main__\":\n    75→    sys.exit(main())\n    76→"