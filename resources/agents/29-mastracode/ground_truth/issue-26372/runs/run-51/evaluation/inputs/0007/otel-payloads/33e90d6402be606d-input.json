"{\"command\":\"cd /tmp/auditsrc && PYTHONPATH=/tmp/audittools python -m pip_audit --local --skip-editable --format json 2>/dev/null > /tmp/audit_local.json; python - <<'EOF'\\nimport json\\nd = json.load(open(\\\"/tmp/audit_local.json\\\"))\\nfor dep in d:\\n    if dep.get(\\\"vulns\\\"):\\n        name = dep[\\\"name\\\"]; ver = dep[\\\"version\\\"]\\n        print(f\\\"== {name} {ver}\\\")\\n        seen = set()\\n        for v in dep[\\\"vulns\\\"]:\\n            key = (v[\\\"id\\\"], tuple(v.get(\\\"fix_versions\\\", [])))\\n            if key in seen: continue\\n            seen.add(key)\\n            print(f\\\"   {v['id']}  fixed in: {', '.join(v.get('fix_versions') or ['n/a'])}  aliases: {','.join(v.get('aliases') or ['-'])}\\\")\\nEOF\",\"timeout\":300}"