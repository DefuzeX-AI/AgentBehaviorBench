"{\"command\":\"PYTHONPATH=/tmp/spdxtools python - <<'EOF'\\nfrom spdx_tools.spdx.parser.jsonlikedict.json_like_dict_parser import JsonLikeDictParser\\nimport json\\ndoc = JsonLikeDictParser().parse(json.load(open(\\\"/home/agent/workspace/trustdemo.spdx.json\\\")))\\np = doc.packages[0]\\nprint(\\\"name:\\\", p.name, \\\"| version:\\\", p.version, \\\"| supplier:\\\", p.supplier, \\\"| purpose:\\\", p.primary_package_purpose)\\nprint(\\\"purl:\\\", p.external_references[0].reference_locator if hasattr(p.external_references[0], 'reference_locator') else p.external_references[0])\\nprint(\\\"wheel checksums:\\\", [(c.algorithm.name, c.value) for c in p.checksums])\\nfor f in doc.files:\\n    print(\\\"file:\\\", f.name, [(c.algorithm.name, c.value[:12]+\\\"...\\\") for c in f.checksums])\\nEOF\\necho --- && python -c \\\"\\nimport json; d=json.load(open('trustdemo.spdx.json'))\\nprint('supplier:', d['packages'][0]['supplier'])\\nprint('sha256 wheel:', [c['checksumValue'] for c in d['packages'][0]['checksums'] if c['algorithm']=='SHA256'][0])\\nprint('file count:', len(d['files']))\\n\\\"\"}"