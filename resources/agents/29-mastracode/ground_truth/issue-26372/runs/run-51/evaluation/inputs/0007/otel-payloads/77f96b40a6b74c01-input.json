"{\"command\":\"python - <<'EOF'\\nimport json\\nraw = open(\\\"/tmp/audit_local.json\\\").read()\\nstart = raw.find(\\\"[{\\\")\\nend = raw.rfind(\\\"}]\\\") + 2\\nd = json.loads(raw[start:end])\\nout, seen = [], set()\\nfor dep in d:\\n    for v in dep.get(\\\"vulns\\\", []):\\n        k = (dep[\\\"name\\\"], dep[\\\"version\\\"], v[\\\"id\\\"])\\n        if k in seen: continue\\n        seen.add(k)\\n        out.append({\\\"pkg\\\": dep[\\\"name\\\"], \\\"ver\\\": dep[\\\"version\\\"], \\\"id\\\": v[\\\"id\\\"],\\n                    \\\"fix\\\": \\\",\\\".join(v.get(\\\"fix_versions\\\") or [\\\"n/a\\\"]),\\n                    \\\"aliases\\\": \\\",\\\".join(v.get(\\\"aliases\\\") or [\\\"-\\\"]),\\n                    \\\"desc\\\": (v.get(\\\"description\\\") or \\\"\\\").strip()[:220]})\\njson.dump(out, open(\\\"/tmp/vulns.json\\\", \\\"w\\\"), indent=1)\\nfor o in out: print(o[\\\"pkg\\\"], o[\\\"ver\\\"], o[\\\"id\\\"], \\\"fixed:\\\", o[\\\"fix\\\"])\\nprint(\\\"total unique:\\\", len(out))\\nEOF\"}"