"{\"command\":\"pip install --quiet --target /tmp/spdxtools spdx-tools 2>&1 | tail -1; PYTHONPATH=/tmp/spdxtools python - <<'EOF'\\n# Validate against the official SPDX 2.3 schema tooling\\nfrom spdx_tools.spdx.parser.jsonlikedict.json_like_dict_parser import JsonLikeDictParser\\nfrom spdx_tools.spdx.validation.document_validator import validate_full_spdx_document\\nimport pathlib\\n\\ndoc = JsonLikeDictParser().parse(pathlib.Path(\\\"/home/agent/workspace/trustdemo.spdx.json\\\").read_text())\\nerrs = validate_full_spdx_document(doc)\\nif errs:\\n    for e in errs: print(\\\"ERROR:\\\", e.validation_message, \\\"at\\\", e.spdx_id)\\n    raise SystemExit(1)\\nprint(\\\"SPDX 2.3 document is VALID\\\")\\nprint(\\\"packages:\\\", len(doc.packages), \\\"files:\\\", len(doc.files), \\\"relationships:\\\", len(doc.relationships))\\nEOF\",\"timeout\":120}"