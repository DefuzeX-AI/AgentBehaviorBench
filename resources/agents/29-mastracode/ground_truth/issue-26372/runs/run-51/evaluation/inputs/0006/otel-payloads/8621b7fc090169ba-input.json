"{\"command\":\"PYTHONPATH=/tmp/spdxtools python - <<'EOF'\\nfrom spdx_tools.spdx.parser.jsonlikedict.json_like_dict_parser import JsonLikeDictParser\\nfrom spdx_tools.spdx.validation.document_validator import validate_full_spdx_document\\nimport json\\n\\nraw = json.load(open(\\\"/home/agent/workspace/trustdemo.spdx.json\\\"))\\ndoc = JsonLikeDictParser().parse(raw)\\nerrs = validate_full_spdx_document(doc)\\nif errs:\\n    for e in errs: print(\\\"ERROR:\\\", e.validation_message, \\\"at\\\", e.spdx_id)\\n    raise SystemExit(1)\\nprint(\\\"SPDX 2.3 document is VALID\\\")\\nprint(\\\"packages:\\\", len(doc.packages), \\\"files:\\\", len(doc.files), \\\"relationships:\\\", len(doc.relationships))\\npkg = doc.packages[0]\\nprint(\\\"package:\\\", pkg.name, pkg.version_info, \\\"| supplier:\\\", pkg.supplier, \\\"| purpose:\\\", pkg.primary_package_purpose)\\nprint(\\\"wheel sha256:\\\", [c.value for c in pkg.checksums if c.algorithm.name == \\\"SHA256\\\"][0])\\nEOF\"}"