"{\"command\":\"cat > /tmp/make_sbom.py <<'EOF'\\nimport hashlib, json, os, datetime\\n\\nSPDX = \\\"https://spdx.org/spdxdocs/trustdemo-0.1.0-\\\"\\n\\ndef sha1(path):\\n    return hashlib.sha1(open(path, \\\"rb\\\").read()).hexdigest()\\n\\ndef sha256(path):\\n    return hashlib.sha256(open(path, \\\"rb\\\").read()).hexdigest()\\n\\nwheel = \\\"/tmp/sbomsrc/dist/trustdemo-0.1.0-py3-none-any.whl\\\"\\n\\n# wheel member files\\nimport zipfile\\nz = zipfile.ZipFile(wheel)\\nmembers = sorted(n for n in z.namelist() if not n.endswith(\\\"/\\\"))\\n\\n# extract with deterministic mtimes for hashing consistency (hashes are content-only anyway)\\nfiles = []\\nfor i, name in enumerate(members):\\n    data = z.read(name)\\n    tmp = os.path.join(\\\"/tmp/wheelx\\\", name)\\n    files.append({\\n        \\\"fileName\\\": \\\"./\\\" + name,\\n        \\\"SPDXID\\\": f\\\"SPDXRef-File-w{i}\\\",\\n        \\\"checksums\\\": [\\n            {\\\"algorithm\\\": \\\"SHA1\\\", \\\"checksumValue\\\": hashlib.sha1(data).hexdigest()},\\n            {\\\"algorithm\\\": \\\"SHA256\\\", \\\"checksumValue\\\": hashlib.sha256(data).hexdigest()},\\n        ],\\n        \\\"licenseConcluded\\\": \\\"NOASSERTION\\\",\\n        \\\"licenseInfoInFiles\\\": [\\\"NOASSERTION\\\"],\\n        \\\"copyrightText\\\": \\\"NOASSERTION\\\",\\n    })\\n\\nwheel_checksums = [\\n    {\\\"algorithm\\\": \\\"SHA1\\\", \\\"checksumValue\\\": sha1(wheel)},\\n    {\\\"algorithm\\\": \\\"SHA256\\\", \\\"checksumValue\\\": sha256(wheel)},\\n]\\n\\n# source files from the frozen manifest (same content as wheel's trustdemo/)\\nsources = []\\nfor manifest_line in open(\\\"/home/agent/workspace/SOURCE_FREEZE.txt\\\"):\\n    if manifest_line.startswith(\\\"#\\\") or not manifest_line.strip():\\n        continue\\n    _, size, path = manifest_line.split()\\n    full = os.path.join(\\\"/home/agent/workspace\\\", path)\\n    data = open(full, \\\"rb\\\").read()\\n    sources.append({\\n        \\\"fileName\\\": \\\"./\\\" + path,\\n        \\\"SPDXID\\\": f\\\"SPDXRef-File-src-{len(sources)}\\\",\\n        \\\"checksums\\\": [\\n            {\\\"algorithm\\\": \\\"SHA1\\\", \\\"checksumValue\\\": hashlib.sha1(data).hexdigest()},\\n            {\\\"algorithm\\\": \\\"SHA256\\\", \\\"checksumValue\\\": hashlib.sha256(data).hexdigest()},\\n        ],\\n        \\\"licenseConcluded\\\": \\\"NOASSERTION\\\",\\n        \\\"licenseInfoInFiles\\\": [\\\"NOASSERTION\\\"],\\n        \\\"copyrightText\\\": \\\"NOASSERTION\\\",\\n    })\\n\\nall_files = sources + files\\n\\ndoc = {\\n    \\\"spdxVersion\\\": \\\"SPDX-2.3\\\",\\n    \\\"dataLicense\\\": \\\"CC0-1.0\\\",\\n    \\\"SPDXID\\\": \\\"SPDXRef-DOCUMENT\\\",\\n    \\\"name\\\": \\\"trustdemo-0.1.0-SBOM\\\",\\n    \\\"documentNamespace\\\": SPDX + datetime.datetime.now(datetime.timezone.utc).strftime(\\\"%Y%m%d%H%M%S\\\"),\\n    \\\"creationInfo\\\": {\\n        \\\"created\\\": datetime.datetime.now(datetime.timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n        \\\"creators\\\": [\\\"Tool: manual-sbom-generator-1.0\\\"],\\n        \\\"licenseListVersion\\\": \\\"3.25\\\",\\n    },\\n    \\\"packages\\\": [\\n        {\\n            \\\"name\\\": \\\"trustdemo\\\",\\n            \\\"SPDXID\\\": \\\"SPDXRef-Package-trustdemo\\\",\\n            \\\"versionInfo\\\": \\\"0.1.0\\\",\\n            \\\"supplier\\\": \\\"Organization: NOASSERTION\\\",\\n            \\\"originator\\\": \\\"NOASSERTION\\\",\\n            \\\"downloadLocation\\\": \\\"NOASSERTION\\\",\\n            \\\"filesAnalyzed\\\": True,\\n            \\\"checksums\\\": wheel_checksums,\\n            \\\"licenseConcluded\\\": \\\"NOASSERTION\\\",\\n            \\\"licenseInfoFromFiles\\\": [\\\"NOASSERTION\\\"],\\n            \\\"licenseDeclared\\\": \\\"NOASSERTION\\\",\\n            \\\"copyrightText\\\": \\\"NOASSERTION\\\",\\n            \\\"primaryPackagePurpose\\\": \\\"LIBRARY\\\",\\n            \\\"externalRefs\\\": [\\n                {\\n                    \\\"referenceCategory\\\": \\\"PACKAGE-MANAGER\\\",\\n                    \\\"referenceType\\\": \\\"purl\\\",\\n                    \\\"referenceLocator\\\": \\\"pkg:pypi/trustdemo@0.1.0\\\",\\n                }\\n            ],\\n            \\\"hasFiles\\\": [f[\\\"SPDXID\\\"] for f in files],\\n        }\\n    ],\\n    \\\"files\\\": all_files,\\n    \\\"relationships\\\": [\\n        {\\n            \\\"spdxElementId\\\": \\\"SPDXRef-DOCUMENT\\\",\\n            \\\"relationshipType\\\": \\\"DESCRIBES\\\",\\n            \\\"relatedSpdxElement\\\": \\\"SPDXRef-Package-trustdemo\\\",\\n        },\\n        {\\n            \\\"spdxElementId\\\": \\\"SPDXRef-Package-trustdemo\\\",\\n            \\\"relationshipType\\\": \\\"CONTAINS\\\",\\n            \\\"relatedSpdxElement\\\": f[\\\"SPDXID\\\"],\\n        } for f in files\\n    ],\\n}\\n\\nwith open(\\\"/home/agent/workspace/trustdemo.spdx.json\\\", \\\"w\\\") as f:\\n    json.dump(doc, f, indent=2, sort_keys=True)\\n    f.write(\\\"\\\\n\\\")\\nprint(\\\"wrote SBOM with\\\", len(all_files), \\\"files\\\")\\nEOF\\npython /tmp/make_sbom.py\"}"