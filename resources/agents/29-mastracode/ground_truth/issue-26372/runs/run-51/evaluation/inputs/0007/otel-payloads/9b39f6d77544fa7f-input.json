"{\"command\":\"python - <<'EOF'\\nimport json, re\\nraw = open(\\\"/tmp/audit_local.json\\\").read()\\n# strip pip-audit's spinner noise: JSON array starts at the last top-level '[' at line start\\nm = raw[raw.rfind(\\\"\\\\n[\\\"):] if \\\"\\\\n[\\\" in raw else raw[raw.find(\\\"[\\\"):]\\nd = json.loads(m[m.find(\\\"[\\\"):m.rfind(\\\"]\\\")+1])\\nout = []\\nfor dep in d:\\n    if dep.get(\\\"vulns\\\"):\\n        seen = set()\\n        for v in dep[\\\"vulns\\\"]:\\n            k = (dep[\\\"name\\\"], dep[\\\"version\\\"], v[\\\"id\\\"])\\n            if k in seen: continue\\n            seen.add(k)\\n            out.append((dep[\\\"name\\\"], dep[\\\"version\\\"], v[\\\"id\\\"], \\\",\\\".join(v.get(\\\"fix_versions\\\") or [\\\"n/a\\\"]), \\\",\\\".join(v.get(\\\"aliases\\\") or [\\\"-\\\"])))\\nfor o in sorted(out): print(o)\\njson.dump(out, open(\\\"/tmp/vulns.json\\\",\\\"w\\\"))\\nprint(\\\"total unique:\\\", len(out))\\nEOF\"}"