"{\"command\":\"set -e\\nSRC=/home/agent/workspace\\nexport SDE=1700000000\\nfor i in 1 2; do\\n  D=/tmp/repro$i\\n  rm -rf $D && mkdir -p $D\\n  cp -r $SRC/pyproject.toml $SRC/trustdemo $D/\\n  touch -d @$SDE $D/pyproject.toml $D/trustdemo/__init__.py\\n  echo \\\"setuptools==84.0.0\\\" > $D/constraints.txt\\n  (cd $D && SOURCE_DATE_EPOCH=$SDE PIP_CONSTRAINT=constraints.txt PYTHONPATH=/tmp/buildtools python -m build --wheel > build.log 2>&1)\\n  echo \\\"--- repro$i ---\\\"; tail -3 $D/build.log\\n  sha256sum $D/dist/*.whl\\ndone\\ncmp /tmp/repro1/dist/*.whl /tmp/repro2/dist/*.whl && echo \\\"BYTE-IDENTICAL\\\" || echo \\\"DIFFER\\\"\",\"timeout\":300}"