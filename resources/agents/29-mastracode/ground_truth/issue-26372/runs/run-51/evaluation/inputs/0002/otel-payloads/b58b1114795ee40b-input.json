"{\"command\":\"python - <<'EOF'\\nimport hashlib, os\\n\\nexclude_dirs = {\\\"__pycache__\\\"}\\nout = []\\nfiles = []\\nfor root, dirs, names in os.walk(\\\".\\\"):\\n    dirs[:] = [d for d in dirs if d not in exclude_dirs]\\n    for n in names:\\n        p = os.path.normpath(os.path.join(root, n))\\n        if p in (\\\"SOURCE_FREEZE.txt\\\",) or p.startswith(\\\"dist/\\\") or p.startswith(\\\"build/\\\"):\\n            continue\\n        files.append(p)\\n\\nfiles.sort()\\nfor p in files:\\n    data = open(p, \\\"rb\\\").read()\\n    h = hashlib.sha256(data).hexdigest()\\n    out.append(f\\\"{h}  {os.path.getsize(p):>8}  {p}\\\")\\n\\nwith open(\\\"SOURCE_FREEZE.txt\\\", \\\"w\\\") as f:\\n    f.write(\\\"# SOURCE_FREEZE.txt — trustdemo source inputs\\\\n\\\")\\n    f.write(\\\"# SHA-256  size(bytes)  path\\\\n\\\")\\n    f.write(\\\"\\\\n\\\".join(out) + \\\"\\\\n\\\")\\n\\nprint(\\\"\\\\n\\\".join(out))\\nEOF\"}"