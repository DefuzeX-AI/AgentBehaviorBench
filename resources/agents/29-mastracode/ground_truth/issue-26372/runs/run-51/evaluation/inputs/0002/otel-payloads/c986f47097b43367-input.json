"{\"command\":\"python - <<'EOF'\\n# Independent verification: recompute all hashes and sizes, compare against SOURCE_FREEZE.txt\\nimport hashlib, os, re\\n\\nlines = [l for l in open(\\\"SOURCE_FREEZE.txt\\\") if l.strip() and not l.startswith(\\\"#\\\")]\\nassert len(lines) == 2, f\\\"expected 2 entries, got {len(lines)}\\\"\\nfor l in lines:\\n    h, size, path = l.split()\\n    data = open(path, \\\"rb\\\").read()\\n    assert hashlib.sha256(data).hexdigest() == h, f\\\"hash mismatch: {path}\\\"\\n    assert os.path.getsize(path) == int(size), f\\\"size mismatch: {path}\\\"\\n    print(\\\"OK\\\", path)\\nprint(\\\"SOURCE_FREEZE.txt verified\\\")\\nEOF\"}"