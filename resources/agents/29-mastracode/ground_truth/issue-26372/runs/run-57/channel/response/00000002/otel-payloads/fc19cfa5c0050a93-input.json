"{\"command\":\"python - <<'EOF'\\n# Substantiate the domain-precision obligation: int subclasses overriding __add__\\nclass Bad(int):\\n    def __add__(self, other):\\n        return 0\\n\\nx = Bad(5)\\nprint(\\\"Bad(5) + 1 =\\\", x + 1)          # breaks the naive property\\nprint(\\\"isinstance(x, int):\\\", isinstance(x, int))\\n\\n# bool is an int subclass that does NOT override __add__\\nprint(\\\"True + 1 =\\\", True + 1)\\n\\n# int is immutable: its arithmetic slots cannot be monkeypatched\\ntry:\\n    int.__add__ = lambda a, b: 0\\nexcept TypeError as e:\\n    print(\\\"monkeypatch blocked:\\\", e)\\nEOF\"}"