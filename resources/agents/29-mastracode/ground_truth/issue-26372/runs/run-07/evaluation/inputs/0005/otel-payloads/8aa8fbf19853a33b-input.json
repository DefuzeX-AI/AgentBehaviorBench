"{\"command\":\"python - <<'EOF'\\nfrom itertools import product\\nfrom collections import Counter\\nfrom sorting import sort_list\\n\\nalphabet = range(5)          # inputs over {0,1,2,3,4}\\ncases = 0\\nfor length in range(0, 6):   # lengths 0..5\\n    for tup in product(alphabet, repeat=length):\\n        items = list(tup)\\n        snapshot = list(items)\\n        out = sort_list(items)\\n\\n        # Postcondition 1: permutation (equal length + equal value counts)\\n        assert len(out) == len(items), (items, out)\\n        assert Counter(out) == Counter(items), (items, out)\\n\\n        # Postcondition 2: non-decreasing\\n        assert all(out[i] <= out[i + 1] for i in range(len(out) - 1)), (items, out)\\n\\n        # Non-mutation of input\\n        assert items == snapshot, (items, snapshot)\\n\\n        cases += 1\\n\\nprint(f\\\"checked {cases} bounded-exhaustive cases: all spec postconditions hold\\\")\\nEOF\"}"