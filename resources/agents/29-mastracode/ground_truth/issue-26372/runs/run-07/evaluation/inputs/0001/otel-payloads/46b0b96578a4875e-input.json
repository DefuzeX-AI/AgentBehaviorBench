"{\"content\":\"def sort_list(items):\\n    \\\"\\\"\\\"Sort a list of integers in ascending order using insertion sort.\\\"\\\"\\\"\\n    result = list(items)\\n    for i in range(1, len(result)):\\n        key = result[i]\\n        j = i - 1\\n        while j >= 0 and result[j] > key:\\n            result[j + 1] = result[j]\\n            j -= 1\\n        result[j + 1] = key\\n    return result\\n\",\"path\":\"sorting.py\"}"