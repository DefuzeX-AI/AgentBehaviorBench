{"schema": "abb.observe.event.v1", "source": "otel-payload", "run_id": "run_101e5e2bb52040aa9da016c6f35c2554", "timestamp": "2026-09-25T03:29:52.740921+00:00", "event": "acp.session_update", "data": {"name": "acp.session_update", "payload": {"session_id": "5ebc71f3-e047-4cfe-9d62-5039bc3c1287", "update": {"toolCallId": "call_d9ed2bf81a3448e19209b30b", "title": "write_file", "kind": "edit", "status": "in_progress", "rawInput": "{\"content\":\"def sort_list(items):\\n    \\\"\\\"\\\"Sort a list of integers in ascending order using insertion sort.\\\"\\\"\\\"\\n    result = list(items)\\n    for i in range(1, len(result)):\\n        key = result[i]\\n        j = i - 1\\n        while j >= 0 and result[j] > key:\\n            result[j + 1] = result[j]\\n            j -= 1\\n        result[j + 1] = key\\n    return result\\n\",\"path\":\"sorting.py\"}", "sessionUpdate": "tool_call"}}, "span_event": false, "case_id": "case_deefea2312e942a38bbb76b68fafb84c", "input_id": "step-1", "invocation_id": "c7126c2c770c4be0a112204d64d8c278", "agent_id": "mastracode"}}
