ion"}, "schema_url": ""}, "live": false, "trace_id": "8a77cb57cccb05c9a7f0d919beeb5cb6", "span_id": "46b0b96578a4875e", "parent_span_id": "019c1cca430f60c3", "start_time_unix_nano": "1790306992741358997", "end_time_unix_nano": "1790306992757725238", "dropped_attributes": 0, "dropped_events": 0, "dropped_links": 0}}
