"{\"command\":\"python - <<'EOF'\\nfrom expr_eval import evaluate\\n\\n# §11 valid inputs — exact results\\nvalid = {\\n    \\\"1 + 2 * 3\\\": 7, \\\"(1 + 2) * 3\\\": 9, \\\"10 - 4 - 3\\\": 3, \\\"2 * (3 + 4) - 5\\\": 9,\\n    \\\"100\\\": 100, \\\"0\\\": 0, \\\"007\\\": 7, \\\" 42 \\\": 42, \\\"-3 + 5\\\": 2, \\\"1 - -2\\\": 3,\\n    \\\"--5\\\": 5, \\\"-+5\\\": -5, \\\"2 * -3\\\": -6, \\\"-(2 + 3)\\\": -5, \\\"((2))\\\": 2,\\n    \\\"2*3+4*5\\\": 26, \\\"( 1 + 2 ) * ( 3 - 4 )\\\": -3, \\\"(((1+2)*(3+4)))\\\": 21,\\n}\\nfor s, want in valid.items():\\n    got = evaluate(s)\\n    assert got == want, f\\\"{s!r}: want {want}, got {got}\\\"\\n\\n# §11 invalid inputs — ValueError\\nfor s in [\\\"\\\", \\\"   \\\", \\\"1 +\\\", \\\"*\\\", \\\"()\\\", \\\"(1+2\\\", \\\"1)\\\", \\\"1 2\\\", \\\"1 + * 2\\\",\\n          \\\"1 & 2\\\", \\\"a+b\\\", \\\"٣ + 1\\\"]:\\n    try:\\n        evaluate(s)\\n    except ValueError:\\n        pass\\n    else:\\n        raise AssertionError(f\\\"{s!r}: expected ValueError\\\")\\n\\n# §9 C4: indicative messages match reference implementation\\nchecks = [(\\\"1 & 2\\\", \\\"Invalid character '&' at position 2\\\"),\\n          (\\\"(1+2\\\", \\\"Missing closing parenthesis\\\"),\\n          (\\\"1 +\\\", \\\"Unexpected end of expression\\\"),\\n          (\\\"1 + * 2\\\", \\\"Unexpected token '*'\\\"),\\n          (\\\"1 2\\\", \\\"Unexpected token 2\\\")]\\nfor s, msg in checks:\\n    try:\\n        evaluate(s)\\n    except ValueError as e:\\n        assert str(e) == msg, f\\\"{s!r}: message {str(e)!r} != {msg!r}\\\"\\n\\n# §10 P8: precedence/associativity identities at string level\\nimport random\\nrandom.seed(0)\\nfor _ in range(200):\\n    a, b, c = (random.randint(-99, 99) for _ in range(3))\\n    A, B, C = str(a), str(b), str(c)\\n    assert evaluate(f\\\"{A} + {B} * {C}\\\") == a + b * c\\n    assert evaluate(f\\\"({A} + {B}) * {C}\\\") == (a + b) * c\\n    assert evaluate(f\\\"{A} - {B} - {C}\\\") == (a - b) - c\\n    assert evaluate(f\\\"{A} * {B} * {C}\\\") == (a * b) * c\\n    assert evaluate(f\\\"{A} + {B} + {C}\\\") == (a + b) + c\\n    assert evaluate(f\\\"-{A} * {B}\\\") == (-a) * b if a >= 0 or True else 0\\n    assert evaluate(f\\\"{A} * -{B}\\\") == a * (-b) if b >= 0 else a * (-b)\\n    assert evaluate(f\\\"-({A} + {B})\\\") == -(a + b)\\n    assert evaluate(f\\\"--{abs(a)}\\\") == abs(a)\\n\\n# §10 P7: algebraic laws via the AST-level API (eval over ℤ)\\nfrom expr_eval import _tokenize, _Parser\\ndef ev(s): return evaluate(s)\\nfor _ in range(100):\\n    a, b, c = (random.randint(-999, 999) for _ in range(3))\\n    assert ev(f\\\"({a}+{b})\\\") == ev(f\\\"({b}+{a})\\\")                          # comm +\\n    assert ev(f\\\"(({a}+{b})+{c})\\\") == ev(f\\\"({a}+({b}+{c}))\\\")              # assoc +\\n    assert ev(f\\\"({a}+0)\\\") == a                                            # unit +\\n    assert ev(f\\\"({a}*{b})\\\") == ev(f\\\"({b}*{a})\\\")                          # comm *\\n    assert ev(f\\\"(({a}*{b})*{c})\\\") == ev(f\\\"({a}*({b}*{c}))\\\")              # assoc *\\n    assert ev(f\\\"({a}*({b}+{c}))\\\") == ev(f\\\"({a}*{b}+{a}*{c})\\\")            # distrib\\n    assert ev(f\\\"--{abs(a)}\\\") == abs(a)                                    # neg neg\\n    assert ev(f\\\"-({a}+{b})\\\") == ev(f\\\"(-{abs(a)}+(-{abs(b)}))\\\")           # neg add\\n    assert ev(f\\\"({a}-{b})\\\") == ev(f\\\"({a}+(-{abs(b)}))\\\")                  # sub/neg\\n\\n# §10 P9: lexing corners\\nassert evaluate(\\\"000000\\\") == 0\\nassert evaluate(\\\"00009\\\") == 9\\n\\nprint(\\\"spec conformance: all checks passed\\\")\\nEOF\"}"