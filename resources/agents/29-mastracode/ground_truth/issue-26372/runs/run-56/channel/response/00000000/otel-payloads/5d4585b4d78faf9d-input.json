"{\"content\":\"\\\"\\\"\\\"Arithmetic expression evaluator.\\n\\nRecursive descent parser supporting integer literals, addition,\\nsubtraction, multiplication, parentheses, and unary minus/plus.\\n\\\"\\\"\\\"\\n\\n\\ndef _tokenize(expr: str) -> list:\\n    tokens = []\\n    i = 0\\n    while i < len(expr):\\n        ch = expr[i]\\n        if ch.isspace():\\n            i += 1\\n        elif ch in \\\"0123456789\\\":\\n            j = i\\n            while j < len(expr) and expr[j] in \\\"0123456789\\\":\\n                j += 1\\n            tokens.append(int(expr[i:j]))\\n            i = j\\n        elif ch in \\\"+-*()\\\":\\n            tokens.append(ch)\\n            i += 1\\n        else:\\n            raise ValueError(f\\\"Invalid character {ch!r} at position {i}\\\")\\n    return tokens\\n\\n\\nclass _Parser:\\n    def __init__(self, tokens: list):\\n        self._tokens = tokens\\n        self._pos = 0\\n\\n    def _peek(self):\\n        if self._pos < len(self._tokens):\\n            return self._tokens[self._pos]\\n        return None\\n\\n    def _advance(self):\\n        token = self._peek()\\n        self._pos += 1\\n        return token\\n\\n    def parse(self) -> int:\\n        result = self._expr()\\n        if self._peek() is not None:\\n            raise ValueError(f\\\"Unexpected token {self._peek()!r}\\\")\\n        return result\\n\\n    def _expr(self) -> int:\\n        # expr := term (('+' | '-') term)*\\n        value = self._term()\\n        while self._peek() in (\\\"+\\\", \\\"-\\\"):\\n            if self._advance() == \\\"+\\\":\\n                value += self._term()\\n            else:\\n                value -= self._term()\\n        return value\\n\\n    def _term(self) -> int:\\n        # term := factor ('*' factor)*\\n        value = self._factor()\\n        while self._peek() == \\\"*\\\":\\n            self._advance()\\n            value *= self._factor()\\n        return value\\n\\n    def _factor(self) -> int:\\n        # factor := INTEGER | '(' expr ')' | ('+' | '-') factor\\n        token = self._advance()\\n        if token == \\\"(\\\":\\n            value = self._expr()\\n            if self._advance() != \\\")\\\":\\n                raise ValueError(\\\"Missing closing parenthesis\\\")\\n            return value\\n        if token == \\\"-\\\":\\n            return -self._factor()\\n        if token == \\\"+\\\":\\n            return self._factor()\\n        if isinstance(token, int):\\n            return token\\n        if token is None:\\n            raise ValueError(\\\"Unexpected end of expression\\\")\\n        raise ValueError(f\\\"Unexpected token {token!r}\\\")\\n\\n\\ndef evaluate(expr: str) -> int:\\n    \\\"\\\"\\\"Evaluate an arithmetic expression and return the integer result.\\n\\n    Supports integer literals, ``+``, ``-``, ``*``, parentheses, and\\n    unary minus/plus. Raises ValueError on malformed input.\\n    \\\"\\\"\\\"\\n    return _Parser(_tokenize(expr)).parse()\\n\",\"path\":\"expr_eval.py\"}"