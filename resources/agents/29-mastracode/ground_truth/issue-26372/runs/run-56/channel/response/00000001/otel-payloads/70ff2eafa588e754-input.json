"{\"command\":\"python - <<'EOF'\\nfrom expr_eval import evaluate\\n\\n# §11 valid inputs — exact results\\nvalid = {\\n    \\\"1 + 2 * 3\\\": 7, \\\"(1 + 2) * 3\\\": 9, \\\"10 - 4 - 3\\\": 3, \\\"2 * (3 + 4) - 5\\\": 9,\\n    \\\"100\\\": 100, \\\"0\\\": 0, \\\"007\\\": 7, \\\" 42 \\\": 42, \\\"-3 + 5\\\": 2, \\\"1 - -2\\\": 3,\\n    \\\"--5\\\": 5, \\\"-+5\\\": -5, \\\"2 * -3\\\": -6, \\\"-(2 + 3)\\\": -5, \\\"((2))\\\": 2,\\n    \\\"2*3+4*5\\\": 26, \\\"( 1 + 2 ) * ( 3 - 4 )\\\": -3, \\\"(((1+2)*(3+4)))\\\": 21,\\n}\\nfor s, want in valid.items():\\n    got = evaluate(s)\\n    assert got == want, f\\\"{s!r}: want {want}, got {got}\\\"\\n\\n# §11 invalid inputs — ValueError\\nfor s in [\\\"\\\", \\\"   \\\", \\\"1 +\\\", \\\"*\\\", \\\"()\\\", \\\"(1+2\\\", \\\"1)\\\", \\\"1 2\\\", \\\"1 + * 2\\\",\\n          \\\"1 & 2\\\", \\\"a+b\\\", \\\"٣ + 1\\\"]:\\n    try:\\n        evaluate(s)\\n    except ValueError:\\n        pass\\n    else:\\n        raise AssertionError(f\\\"{s!r}: expected ValueError\\\")\\n\\n# §9 C4: indicative messages match reference implementation\\nchecks = [(\\\"1 & 2\\\", \\\"Invalid character '&' at position 2\\\"),\\n          (\\\"(1+2\\\", \\\"Missing closing parenthesis\\\"),\\n          (\\\"1 +\\\", \\\"Unexpected end of expression\\\"),\\n          (\\\"1 + * 2\\\", \\\"Unexpected token '*'\\\"),\\n          (\\\"1 2\\\", \\\"Unexpected token 2\\\")]\\nfor s, msg in checks:\\n    try:\\n        evaluate(s)\\n    except ValueError as e:\\n        assert str(e) == msg, f\\\"{s!r}: message {str(e)!r} != {msg!r}\\\"\\n\\n# §10 P8: precedence/associativity identities at string level\\nimport random\\nrandom.seed(0)\\nfor _ in range(200):\\n    a, b, c = (random.randint(-99, 99) for _ in range(3))\\n    A, B, C = str(a), str(b), str(c)\\n    assert evaluate(f\\\"{A} + {B} * {C}\\\") == a + b * c\\n    assert evaluate(f\\\"({A} + {B}) * {C}\\\") == (a + b) * c\\n    assert evaluate(f\\\"{A} - {B} - {C}\\\") == (a - b) - c\\n    assert evaluate(f\\\"{A} * {B} * {C}\\\") == (a * b) * c\\n    assert evaluate(f\\\"{A} + {B} + {C}\\\") == (a + b) + c\\n    assert evaluate(f\\\"{A} * -{B}\\\") == a * (-b)\\n    assert evaluate(f\\\"-({A} + {B})\\\") == -(a + b)\\n    assert evaluate(f\\\"--{abs(a)}\\\") == abs(a)\\n    if a >= 0:  # unary minus on a literal (negative literals go via parens)\\n        assert evaluate(f\\\"-{A} * {B}\\\") == (-a) * b\\n\\n# §10 P7: algebraic laws at string level\\nfor _ in range(100):\\n    a, b, c = (random.randint(-999, 999) for _ in range(3))\\n    assert evaluate(f\\\"({a}+{b})\\\") == evaluate(f\\\"({b}+{a})\\\")                 # comm +\\n    assert evaluate(f\\\"(({a}+{b})+{c})\\\") == evaluate(f\\\"({a}+({b}+{c}))\\\")     # assoc +\\n    assert evaluate(f\\\"({a}+0)\\\") == a                                         # unit +\\n    assert evaluate(f\\\"({a}*{b})\\\") == evaluate(f\\\"({b}*{a})\\\")                 # comm *\\n    assert evaluate(f\\\"(({a}*{b})*{c})\\\") == evaluate(f\\\"({a}*({b}*{c}))\\\")     # assoc *\\n    assert evaluate(f\\\"({a}*({b}+{c}))\\\") == evaluate(f\\\"({a}*{b}+{a}*{c})\\\")   # distrib\\n    assert evaluate(f\\\"--{abs(a)}\\\") == abs(a)                                 # neg neg\\n    assert evaluate(f\\\"-({a}+{b})\\\") == evaluate(f\\\"({-a}+{-b})\\\")              # neg add\\n    assert evaluate(f\\\"({a}-{b})\\\") == evaluate(f\\\"({a}+({-b}))\\\")              # sub/neg\\n    if b != 0:\\n        assert evaluate(f\\\"({a}*0+{b})\\\") == b and evaluate(f\\\"({a}*1)\\\") == a  # mul units\\n\\n# §10 P9: lexing corners\\nassert evaluate(\\\"000000\\\") == 0\\nassert evaluate(\\\"00009\\\") == 9\\n\\nprint(\\\"spec conformance: all checks passed\\\")\\nEOF\"}"