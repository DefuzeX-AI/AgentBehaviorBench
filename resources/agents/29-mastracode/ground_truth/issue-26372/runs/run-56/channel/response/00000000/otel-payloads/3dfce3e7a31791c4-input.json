"{\"command\":\"python - <<'EOF'\\nfrom expr_eval import evaluate\\n\\ncases = [\\n    (\\\"1 + 2 * 3\\\", 7),\\n    (\\\"(1 + 2) * 3\\\", 9),\\n    (\\\"10 - 4 - 3\\\", 3),\\n    (\\\"2 * (3 + 4) - 5\\\", 9),\\n    (\\\"100\\\", 100),\\n    (\\\"-3 + 5\\\", 2),\\n    (\\\"1 - -2\\\", 3),\\n    (\\\"((2))\\\", 2),\\n    (\\\"2*3+4*5\\\", 26),\\n    (\\\" ( 1 + 2 ) * ( 3 - 4 ) \\\", -3),\\n    (\\\"7\\\", 7),\\n    (\\\"(((1+2)*(3+4)))\\\", 21),\\n]\\nfor expr, expected in cases:\\n    got = evaluate(expr)\\n    assert got == expected, f\\\"{expr!r}: expected {expected}, got {got}\\\"\\n\\nfor bad in [\\\"\\\", \\\"   \\\", \\\"1 +\\\", \\\"(1+2\\\", \\\"1 & 2\\\", \\\"1 2\\\", \\\"*\\\", \\\"1 + * 2\\\", \\\"1)\\\", \\\"a+b\\\"]:\\n    try:\\n        evaluate(bad)\\n    except ValueError:\\n        pass\\n    else:\\n        raise AssertionError(f\\\"expected ValueError for {bad!r}\\\")\\n\\nprint(\\\"all tests passed\\\")\\nEOF\"}"