"{\"content\":\"\\\"\\\"\\\"A minimal proof checker for the equational theory of `arith.add` / `arith.multiply`.\\n\\nIt verifies conjectures over the free term algebra of the integers with the\\ntwo operations `+` and `*` and the usual ring/semiring axioms, by reducing\\nboth sides of a conjecture to a canonical multivariate-polynomial normal\\nform (integer coefficients, monomials sorted by total degree, then\\nlexicographically by exponent tuple) and comparing the normal forms.\\n\\nThis is the classical AC-normalisation (\\\"Buchberger-free\\\") approach for the\\ntheory of commutative semirings: two polynomials are provably equal from the\\nsemiring axioms (commutativity, associativity, distributivity, identity\\nelements) **iff** their canonical normal forms coincide.  Soundness therefore\\nholds both ways: equal normal forms prove the conjecture; distinct normal\\nforms are a genuine counterexample witness (the semiring axioms cannot prove\\nthem equal, and any concrete integer instantiation of the variables that\\ndiffers numerically certifies the conjecture is false over the integers).\\n\\nNo third-party dependencies; only the Python standard library is used.\\n\\nUsage\\n-----\\n    python3 proof_check.py goals.py\\n\\nwhere `goals.py` is a Python file defining the names\\n`IDENTITIES`, `COMMUTATIVITY`, `ASSOCIATIVITY`, `DISTRIBUTIVITY`\\n(lists of conjectures) and the optional auxiliary goal lists, e.g.\\n`EXTRA_GOALS`.  Each conjecture is a Python lambda on the free variables\\n`a, b, c` built with `+`, `*`, integer literals and no other operations.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport importlib.util\\nimport sys\\nfrom collections import defaultdict\\nfrom fractions import Fraction\\nfrom typing import Dict, List, Tuple\\n\\nVar = str\\nMonomial = Tuple[Tuple[Var, int], ...]  # sorted (var, exponent) pairs, exponent > 0\\nPoly = Dict[Monomial, Fraction]  # monomial -> nonzero rational coefficient\\n\\n# ---------------------------------------------------------------------------\\n# Term representation\\n# ---------------------------------------------------------------------------\\n\\n\\nclass Term:\\n    \\\"\\\"\\\"An immutable algebraic term: a variable, a literal, a sum or a product.\\\"\\\"\\\"\\n\\n    __slots__ = (\\\"kind\\\", \\\"children\\\", \\\"name\\\", \\\"value\\\")\\n\\n    def __init__(self, kind, children=(), name=None, value=None):\\n        self.kind = kind  # \\\"var\\\" | \\\"lit\\\" | \\\"add\\\" | \\\"mul\\\"\\n        self.children = tuple(children)\\n        self.name = name\\n        self.value = value\\n\\n    @staticmethod\\n    def var(name: str) -> \\\"Term\\\":\\n        return Term(\\\"var\\\", name=name)\\n\\n    @staticmethod\\n    def lit(value) -> \\\"Term\\\":\\n        assert isinstance(value, int), \\\"literals must be integers\\\"\\n        return Term(\\\"lit\\\", value=value)\\n\\n    @staticmethod\\n    def add(*children) -> \\\"Term\\\":\\n        assert len(children) == 2, \\\"add is binary\\\"\\n        return Term(\\\"add\\\", children)\\n\\n    @staticmethod\\n    def mul(*children) -> \\\"Term\\\":\\n        assert len(children) == 2, \\\"mul is binary\\\"\\n        return Term(\\\"mul\\\", children)\\n\\n    # -- pretty printing ----------------------------------------------------\\n\\n    def _prec(self):\\n        return {\\\"add\\\": 1, \\\"mul\\\": 2}.get(self.kind, 3)\\n\\n    def __str__(self):\\n        if self.kind == \\\"var\\\":\\n            return self.name\\n        if self.kind == \\\"lit\\\":\\n            return str(self.value)\\n        op = \\\"+\\\" if self.kind == \\\"add\\\" else \\\"*\\\"\\n        parts = []\\n        for ch in self.children:\\n            s = str(ch)\\n            parts.append(f\\\"({s})\\\" if ch._prec() < self._prec() else s)\\n        return f\\\" {op} \\\".join(parts)\\n\\n\\n# ---------------------------------------------------------------------------\\n# Parsing Python lambda conjectures into terms\\n# ---------------------------------------------------------------------------\\n\\n\\ndef _parse(func) -> Tuple[frozenset, Term]:\\n    \\\"\\\"\\\"Parse a lambda over variables named in its signature into a Term.\\n\\n    The lambda body may only use +, *, integer literals and parentheses.\\n    \\\"\\\"\\\"\\n    import ast\\n\\n    if not getattr(func, \\\"__code__\\\", None) or func.__code__.co_argcount != len(\\n        func.__code__.co_varnames\\n    ):\\n        raise ValueError(\\\"conjecture lambda must not use *args/**kwargs\\\")\\n    names = func.__code__.co_varnames[: func.__code__.co_argcount]\\n    if any(not isinstance(n, str) or not n.isidentifier() for n in names):\\n        raise ValueError(\\\"conjecture parameters must be identifiers\\\")\\n\\n    tree = ast.parse(inspect_source(func)).body[0]\\n    body = tree.body\\n    assert len(body) == 1, \\\"lambda body must be a single expression\\\"\\n    expr = body[0].value\\n    term = _build(expr, set(names))\\n    return frozenset(names), term\\n\\n\\ndef inspect_source(func) -> str:\\n    import textwrap\\n\\n    src = textwrap.dedent(inspect.getsource(func))\\n    start = src.index(\\\"lambda\\\")\\n    return src[start:].rstrip().rstrip(\\\",\\\").strip()\\n\\n\\ndef _build(node, names) -> Term:\\n    import ast\\n\\n    if isinstance(node, ast.Expression):\\n        return _build(node.body, names)\\n    if isinstance(node, ast.BinOp):\\n        if isinstance(node.op, ast.Add):\\n            return Term.add(_build(node.left, names), _build(node.right, names))\\n        if isinstance(node.op, ast.Mult):\\n            return Term.mul(_build(node.left, names), _build(node.right, names))\\n        raise ValueError(f\\\"unsupported operator {ast.dump(node.op)}\\\")\\n    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.USub):\\n        operand = _build(node.operand, names)\\n        return Term.mul(Term.lit(-1), operand)\\n    if isinstance(node, ast.Name):\\n        assert node.id in names, f\\\"unknown variable {node.id!r}\\\"\\n        return Term.var(node.id)\\n    if isinstance(node, ast.Constant):\\n        assert isinstance(node.value, int), \\\"only integer literals allowed\\\"\\n        return Term.lit(node.value)\\n    raise ValueError(f\\\"unsupported syntax: {ast.dump(node)}\\\")\\n\\n\\n# ---------------------------------------------------------------------------\\n# Canonical normal form: integer polynomial in the free variables\\n# ---------------------------------------------------------------------------\\n\\n\\ndef to_poly(t: Term) -> Poly:\\n    \\\"\\\"\\\"Reduce a term to its canonical polynomial normal form.\\n\\n    This performs AC-normalisation: `+` and `*` are treated as associative\\n    and commutative (children sorted), `*` distributes over `+`, and literals\\n    are folded into integer coefficients.  Two terms are provably equal from\\n    the semiring axioms iff their normal forms are identical.\\n    \\\"\\\"\\\"\\n    if t.kind == \\\"lit\\\":\\n        return {(): Fraction(t.value)} if t.value != 0 else {}\\n    if t.kind == \\\"var\\\":\\n        return {((t.name, 1),): Fraction(1)}\\n    if t.kind == \\\"add\\\":\\n        acc: Poly = defaultdict(Fraction)\\n        for ch in t.children:\\n            for mono, coef in to_poly(ch).items():\\n                acc[mono] += coef\\n        return _clean(dict(acc))\\n    if t.kind == \\\"mul\\\":\\n        result: Poly = {(): Fraction(1)}\\n        for ch in t.children:\\n            sub = to_poly(ch)\\n            nxt: Poly = defaultdict(Fraction)\\n            for m1, c1 in result.items():\\n                for m2, c2 in sub.items():\\n                    nxt[_mono_mul(m1, m2)] += c1 * c2\\n            result = dict(nxt)\\n        return _clean(result)\\n    raise AssertionError(f\\\"unknown term kind {t.kind!r}\\\")\\n\\n\\ndef _mono_mul(m1: Monomial, m2: Monomial) -> Monomial:\\n    exps: Dict[Var, int] = {}\\n    for v, e in m1:\\n        exps[v] = exps.get(v, 0) + e\\n    for v, e in m2:\\n        exps[v] = exps.get(v, 0) + e\\n    return tuple(sorted((v, e) for v, e in exps.items() if e > 0))\\n\\n\\ndef _clean(p: Poly) -> Poly:\\n    return {m: c for m, c in p.items() if c != 0}\\n\\n\\ndef poly_str(p: Poly) -> str:\\n    if not p:\\n        return \\\"0\\\"\\n    def mono_str(m: Monomial, coef) -> str:\\n        parts = []\\n        for v, e in m:\\n            parts.append(v if e == 1 else f\\\"{v}^{e}\\\")\\n        core = \\\"*\\\".join(parts)\\n        return core if coef == 1 else f\\\"{coef}*{core}\\\"\\n\\n    items = sorted(p.items(), key=lambda kv: (-sum(e for _, e in kv[0]), kv[0]))\\n    out = []\\n    for i, (m, c) in enumerate(items):\\n        s = mono_str(m, c)\\n        if i == 0:\\n            out.append(s if c > 0 else s)\\n        else:\\n            out.append(f\\\" + {s}\\\" if c > 0 else f\\\" - {mono_str(m, -c)}\\\")\\n    return \\\"\\\".join(out)\\n\\n\\n# ---------------------------------------------------------------------------\\n# Concrete evaluation (for counterexample witnesses)\\n# ---------------------------------------------------------------------------\\n\\n\\ndef eval_term(t: Term, env: Dict[Var, int]) -> int:\\n    if t.kind == \\\"lit\\\":\\n        return t.value\\n    if t.kind == \\\"var\\\":\\n        return env[t.name]\\n    if t.kind == \\\"add\\\":\\n        return eval_term(t.children[0], env) + eval_term(t.children[1], env)\\n    if t.kind == \\\"mul\\\":\\n        return eval_term(t.children[0], env) * eval_term(t.children[1], env)\\n    raise AssertionError\\n\\n\\n# ---------------------------------------------------------------------------\\n# The checker\\n# ---------------------------------------------------------------------------\\n\\n\\nclass ProofResult:\\n    __slots__ = (\\\"name\\\", \\\"ok\\\", \\\"lhs\\\", \\\"rhs\\\", \\\"lhs_nf\\\", \\\"rhs_nf\\\", \\\"witness\\\")\\n\\n    def __init__(self, name, ok, lhs, rhs, lhs_nf, rhs_nf, witness=None):\\n        self.name = name\\n        self.ok = ok\\n        self.lhs = lhs\\n        self.rhs = rhs\\n        self.lhs_nf = lhs_nf\\n        self.rhs_nf = rhs_nf\\n        self.witness = witness\\n\\n    def __str__(self):\\n        status = \\\"PROVED\\\" if self.ok else \\\"FAILED\\\"\\n        s = f\\\"[{status}] {self.name}: {self.lhs} == {self.rhs}\\\"\\n        if not self.ok:\\n            s += f\\\"\\\\n    lhs normal form: {self.lhs_nf}\\\"\\n            s += f\\\"\\\\n    rhs normal form: {self.rhs_nf}\\\"\\n            if self.witness is not None:\\n                s += f\\\"\\\\n    counterexample binding: {self.witness}\\\"\\n        return s\\n\\n\\ndef _term_of_lambda(func):\\n    names, body = _parse(func)\\n    return names, body\\n\\n\\ndef check(name: str, conjecture) -> ProofResult:\\n    \\\"\\\"\\\"Check one conjecture `lambda a, b, ...: <lhs> == <rhs>`.\\n\\n    A conjecture holds iff both sides have the same polynomial normal form.\\n    \\\"\\\"\\\"\\n    import ast\\n\\n    names, func_body = _parse_lambda_full(conjecture)\\n    cmp_node = func_body\\n    assert isinstance(cmp_node, ast.Compare) and len(cmp_node.ops) == 1 and isinstance(\\n        cmp_node.ops[0], ast.Eq\\n    ), \\\"conjecture body must be of the form <expr> == <expr>\\\"\\n    lhs = _build(cmp_node.left, set(names))\\n    rhs = _build(cmp_node.comparators[0], set(names))\\n    lhs_nf = to_poly(lhs)\\n    rhs_nf = to_poly(rhs)\\n    ok = lhs_nf == rhs_nf\\n    witness = None\\n    if not ok:\\n        env = {}\\n        for i, v in enumerate(sorted(names)):\\n            env[v] = [2, 3, 5, 7][i % 4]\\n        if eval_term(lhs, env) == eval_term(rhs, env):\\n            # try a couple more deterministic bindings to find a witness\\n            for combo in [(1, 1, 1, 1), (0, 1, 2, 3), (3, 1, 4, 1), (2, 2, 3, 3)]:\\n                env = {v: combo[i % 4] for i, v in enumerate(sorted(names))}\\n                if eval_term(lhs, env) != eval_term(rhs, env):\\n                    break\\n        if eval_term(lhs, env) != eval_term(rhs, env):\\n            witness = env\\n    return ProofResult(\\n        name, ok, str(lhs), str(rhs), poly_str(lhs_nf), poly_str(rhs_nf), witness\\n    )\\n\\n\\ndef _parse_lambda_full(func):\\n    import ast\\n    import textwrap\\n\\n    src = textwrap.dedent(inspect.getsource(func)).strip()\\n    start = src.index(\\\"lambda\\\")\\n    end = src.find(\\\"==\\\")\\n    assert end > start, \\\"conjecture must contain '=='\\\"\\n    # cut at the last '=' of '=='\\n    end += 2\\n    header = src[start:end]\\n    tree = ast.parse(f\\\"({header})\\\", mode=\\\"eval\\\")\\n    lam = tree.body\\n    assert isinstance(lam, ast.Lambda), \\\"expected a lambda\\\"\\n    names = [a.arg for a in lam.args.args]\\n    cmp_node = lam.body\\n    return names, cmp_node\\n\\n\\ndef check_goals(filename: str, groups) -> bool:\\n    \\\"\\\"\\\"Check the named groups of conjectures in `filename`; print a report.\\\"\\\"\\\"\\n    spec = importlib.util.spec_from_file_location(\\\"goals\\\", filename)\\n    goals = importlib.util.module_from_spec(spec)\\n    spec.loader.exec_module(goals)\\n\\n    all_ok = True\\n    for group in groups:\\n        items = getattr(goals, group, None)\\n        if items is None:\\n            continue\\n        print(f\\\"== {group} ==\\\")\\n        for i, conj in enumerate(items, 1):\\n            res = check(f\\\"{group}[{i}]\\\", conj)\\n            all_ok &= res.ok\\n            print(res)\\n        print()\\n    return all_ok\\n\\n\\ndef main(argv: List[str]) -> int:\\n    if len(argv) != 2:\\n        print(__doc__)\\n        return 2\\n    groups = [\\n        \\\"IDENTITIES\\\",\\n        \\\"COMMUTATIVITY\\\",\\n        \\\"ASSOCIATIVITY\\\",\\n        \\\"DISTRIBUTIVITY\\\",\\n        \\\"EXTRA_GOALS\\\",\\n    ]\\n    ok = check_goals(argv[1], groups)\\n    print(\\\"ALL PROOFS VERIFIED\\\" if ok else \\\"PROOF CHECK FAILED\\\")\\n    return 0 if ok else 1\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main(sys.argv))\\n\",\"path\":\"proof_check.py\"}"