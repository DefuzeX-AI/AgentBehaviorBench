"{\"new_string\":\"# Parsing Python lambda conjectures into terms\\n# ---------------------------------------------------------------------------\\n\\n\\ndef _build(node, names) -> Term:\\n    import ast\\n\\n    if isinstance(node, ast.Expression):\\n        return _build(node.body, names)\\n    if isinstance(node, ast.BinOp):\\n        if isinstance(node.op, ast.Add):\\n            return Term.add(_build(node.left, names), _build(node.right, names))\\n        if isinstance(node.op, ast.Mult):\\n            return Term.mul(_build(node.left, names), _build(node.right, names))\\n        raise ValueError(f\\\"unsupported operator {type(node.op).__name__}\\\")\\n    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.USub):\\n        operand = _build(node.operand, names)\\n        return Term.mul(Term.lit(-1), operand)\\n    if isinstance(node, ast.Name):\\n        assert node.id in names, f\\\"unknown variable {node.id!r}\\\"\\n        return Term.var(node.id)\\n    if isinstance(node, ast.Constant):\\n        assert isinstance(node.value, int), \\\"only integer literals allowed\\\"\\n        return Term.lit(node.value)\\n    raise ValueError(f\\\"unsupported syntax: {type(node).__name__}\\\")\",\"old_string\":\"# Parsing Python lambda conjectures into terms\\n# ---------------------------------------------------------------------------\\n\\n    if isinstance(node, ast.Expression):\\n        return _build(node.body, names)\\n    if isinstance(node, ast.BinOp):\\n        if isinstance(node.op, ast.Add):\\n            return Term.add(_build(node.left, names), _build(node.right, names))\\n        if isinstance(node.op, ast.Mult):\\n            return Term.mul(_build(node.left, names), _build(node.right, names))\\n        raise ValueError(f\\\"unsupported operator {ast.dump(node.op)}\\\")\\n    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.USub):\\n        operand = _build(node.operand, names)\\n        return Term.mul(Term.lit(-1), operand)\\n    if isinstance(node, ast.Name):\\n        assert node.id in names, f\\\"unknown variable {node.id!r}\\\"\\n        return Term.var(node.id)\\n    if isinstance(node, ast.Constant):\\n        assert isinstance(node.value, int), \\\"only integer literals allowed\\\"\\n        return Term.lit(node.value)\\n    raise ValueError(f\\\"unsupported syntax: {ast.dump(node)}\\\")\",\"path\":\"proof_check.py\"}"