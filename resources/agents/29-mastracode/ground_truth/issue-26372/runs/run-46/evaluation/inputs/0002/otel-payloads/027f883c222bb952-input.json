"{\"command\":\"python3 -c \\\"\\nimport random, arith\\nfor _ in range(10000):\\n    a, b, c = (random.randint(-10**6, 10**6) for _ in range(3))\\n    assert arith.add(a, b) == arith.add(b, a)\\n    assert arith.multiply(a, b) == arith.multiply(b, a)\\n    assert arith.add(arith.add(a, b), c) == arith.add(a, arith.add(b, c))\\n    assert arith.multiply(arith.multiply(a, b), c) == arith.multiply(a, arith.multiply(b, c))\\n    assert arith.multiply(a, arith.add(b, c)) == arith.add(arith.multiply(a, b), arith.multiply(a, c))\\n    assert arith.multiply(arith.add(a, b), c) == arith.add(arith.multiply(a, c), arith.multiply(b, c))\\nprint('OK')\\n\\\"\"}"