"{\"new_string\":\"# ---------------------------------------------------------------------------\\n# Parsing Python lambda conjectures into terms\\n# ---------------------------------------------------------------------------\",\"old_string\":\"# ---------------------------------------------------------------------------\\n# Parsing Python lambda conjectures into terms\\n# ---------------------------------------------------------------------------\\n\\n\\ndef _parse(func) -> Tuple[frozenset, Term]:\\n    \\\"\\\"\\\"Parse a lambda over variables named in its signature into a Term.\\n\\n    The lambda body may only use +, *, integer literals and parentheses.\\n    \\\"\\\"\\\"\\n    import ast\\n\\n    if not getattr(func, \\\"__code__\\\", None) or func.__code__.co_argcount != len(\\n        func.__code__.co_varnames\\n    ):\\n        raise ValueError(\\\"conjecture lambda must not use *args/**kwargs\\\")\\n    names = func.__code__.co_varnames[: func.__code__.co_argcount]\\n    if any(not isinstance(n, str) or not n.isidentifier() for n in names):\\n        raise ValueError(\\\"conjecture parameters must be identifiers\\\")\\n\\n    tree = ast.parse(inspect_source(func)).body[0]\\n    body = tree.body\\n    assert len(body) == 1, \\\"lambda body must be a single expression\\\"\\n    expr = body[0].value\\n    term = _build(expr, set(names))\\n    return frozenset(names), term\\n\\n\\ndef inspect_source(func) -> str:\\n    import textwrap\\n\\n    src = textwrap.dedent(inspect.getsource(func))\\n    start = src.index(\\\"lambda\\\")\\n    return src[start:].rstrip().rstrip(\\\",\\\").strip()\\n\\n\\ndef _build(node, names) -> Term:\\n    import ast\",\"path\":\"proof_check.py\"}"