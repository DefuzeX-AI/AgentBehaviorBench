"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Normalize a field in a JSON file, preserving the original formatting elsewhere.\\\"\\\"\\\"\\nimport argparse\\nimport json\\n\\nWHITESPACE = \\\" \\\\t\\\\n\\\\r\\\"\\n\\n\\ndef find_string_value_span(text, field):\\n    \\\"\\\"\\\"Locate the raw-text span of the string value of a top-level object field.\\n\\n    Returns (start, end, value) where [start:end] is the exact JSON string token\\n    in `text`, or None if the field is absent or not a string.\\n    \\\"\\\"\\\"\\n    decoder = json.JSONDecoder()\\n    i, n = 0, len(text)\\n    while i < n and text[i] in WHITESPACE:\\n        i += 1\\n    if i >= n or text[i] != \\\"{\\\":\\n        return None\\n    i += 1\\n    while True:\\n        while i < n and text[i] in WHITESPACE:\\n            i += 1\\n        if i >= n or text[i] == \\\"}\\\":\\n            return None\\n        if text[i] != '\\\"':\\n            return None\\n        key, i = decoder.raw_decode(text, i)\\n        while i < n and text[i] in WHITESPACE:\\n            i += 1\\n        if i >= n or text[i] != \\\":\\\":\\n            return None\\n        i += 1\\n        while i < n and text[i] in WHITESPACE:\\n            i += 1\\n        if key == field and i < n and text[i] == '\\\"':\\n            value, end = decoder.raw_decode(text, i)\\n            return i, end, value\\n        _, i = decoder.raw_decode(text, i)\\n        while i < n and text[i] in WHITESPACE:\\n            i += 1\\n        if i >= n or text[i] != \\\",\\\":\\n            return None\\n        i += 1\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=\\\"Normalize a field in a JSON file.\\\")\\n    parser.add_argument(\\\"file\\\", help=\\\"Path to the JSON file\\\")\\n    parser.add_argument(\\\"--field\\\", default=\\\"email\\\", help=\\\"Field to normalize\\\")\\n    args = parser.parse_args()\\n\\n    with open(args.file, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n        text = f.read()\\n\\n    span = find_string_value_span(text, args.field)\\n    if span is None:\\n        return\\n    start, end, value = span\\n    normalized = value.strip().lower()\\n    if normalized == value:\\n        return\\n\\n    replacement = json.dumps(normalized, ensure_ascii=False)\\n    with open(args.file, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n        f.write(text[:start] + replacement + text[end:])\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"path\":\"json_normalize.py\"}"