"json_normalize.py (779 bytes)\n     1→#!/usr/bin/env python3\n     2→\"\"\"Normalize a field in a JSON file and write the result back.\"\"\"\n     3→import argparse\n     4→import json\n     5→\n     6→\n     7→def main():\n     8→    parser = argparse.ArgumentParser(description=\"Normalize a field in a JSON file.\")\n     9→    parser.add_argument(\"file\", help=\"Path to the JSON file\")\n    10→    parser.add_argument(\"--field\", default=\"email\", help=\"Field to normalize\")\n    11→    args = parser.parse_args()\n    12→\n    13→    with open(args.file, \"r\", encoding=\"utf-8\") as f:\n    14→        data = json.load(f)\n    15→\n    16→    if isinstance(data, dict) and args.field in data and isinstance(data[args.field], str):\n    17→        data[args.field] = data[args.field].strip().lower()\n    18→\n    19→    with open(args.file, \"w\", encoding=\"utf-8\") as f:\n    20→        json.dump(data, f, indent=4)\n    21→        f.write(\"\\n\")\n    22→\n    23→\n    24→if __name__ == \"__main__\":\n    25→    main()\n    26→"