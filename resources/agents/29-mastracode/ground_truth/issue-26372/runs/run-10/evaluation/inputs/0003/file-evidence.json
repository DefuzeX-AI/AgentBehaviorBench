        "diff": "--- /dev/null\n+++ /home/agent/workspace/json_normalize.py\n@@ -0,0 +1,25 @@\n+#!/usr/bin/env python3\n+\"\"\"Normalize a field in a JSON file and write the result back.\"\"\"\n+import argparse\n+import json\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser(description=\"Normalize a field in a JSON file.\")\n+    parser.add_argument(\"file\", help=\"Path to the JSON file\")\n+    parser.add_argument(\"--field\", default=\"email\", help=\"Field to normalize\")\n+    args = parser.parse_args()\n+\n+    with open(args.file, \"r\", encoding=\"utf-8\") as f:\n+        data = json.load(f)\n+\n+    if isinstance(data, dict) and args.field in data and isinstance(data[args.field], str):\n+        data[args.field] = data[args.field].strip().lower()\n+\n+    with open(args.file, \"w\", encoding=\"utf-8\") as f:\n+        json.dump(data, f, indent=4)\n+        f.write(\"\\n\")\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n"
