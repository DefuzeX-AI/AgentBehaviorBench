"{\"content\":\"\\\"\\\"\\\"Throwaway verification for splits.py against data/events.csv + edge cases.\\\"\\\"\\\"\\nimport csv\\nimport sys\\n\\nsys.path.insert(0, \\\"/home/agent/workspace\\\")\\nfrom splits import rolling_origin_splits\\n\\n# --- load real data, bucket to day grid -------------------------------------\\nwith open(\\\"/home/agent/workspace/data/events.csv\\\") as f:\\n    rows = [dict(r) for r in csv.DictReader(f)]\\nfor r in rows:\\n    r[\\\"day\\\"] = r[\\\"timestamp\\\"][:10]\\n\\ngrid = sorted({r[\\\"day\\\"] for r in rows})\\ngpos = {t: i for i, t in enumerate(grid)}\\nprint(f\\\"python {sys.version.split()[0]} | grid: {len(grid)} days, {grid[0]} .. {grid[-1]}\\\")\\n\\nH = 3\\n\\ndef check(folds, sliding_k, step, gap=0, first_origin=1):\\n    for f in folds:\\n        assert f.train and f.test, f\\\"fold {f.index} has empty side\\\"\\n        ft = [r[\\\"day\\\"] for r in f.train]\\n        xs = [r[\\\"day\\\"] for r in f.test]\\n        # global no-overlap (gap inclusive)\\n        assert max(ft) < min(xs), f\\\"fold {f.index}: train/test overlap\\\"\\n        assert gpos[min(xs)] - gpos[max(ft)] - 1 == gap, f\\\"fold {f.index}: gap mismatch\\\"\\n        # exact test-window length on the grid\\n        assert gpos[f.test_end] - gpos[f.test_start] + 1 == H, f\\\"fold {f.index}: horizon mismatch\\\"\\n        # sliding window has exact global length\\n        if sliding_k is not None:\\n            assert len(set(ft)) == sliding_k, f\\\"fold {f.index}: train window != {sliding_k}\\\"\\n        # group integrity: same groups on both sides, per-group no-leak\\n        tg = {r[\\\"group_id\\\"] for r in f.train}\\n        xg = {r[\\\"group_id\\\"] for r in f.test}\\n        assert tg == xg, f\\\"fold {f.index}: asymmetric groups {tg ^ xg}\\\"\\n        for g in tg:\\n            gt = [r[\\\"day\\\"] for r in f.train if r[\\\"group_id\\\"] == g]\\n            gx = [r[\\\"day\\\"] for r in f.test if r[\\\"group_id\\\"] == g]\\n            assert max(gt) < min(gx), f\\\"fold {f.index}/{g}: leakage\\\"\\n    # origins strictly increase, contiguous indices, expected origin positions\\n    assert [f.index for f in folds] == list(range(len(folds))), \\\"indices not contiguous\\\"\\n    for k, f in enumerate(folds):\\n        expect = gpos[grid[first_origin - 1 + k * step]]\\n        assert gpos[f.origin] == expect, f\\\"fold {k}: origin at wrong grid position\\\"\\n        assert gpos[f.test_start] == gpos[f.origin] + 1 + gap, f\\\"fold {k}: test_start misplaced\\\"\\n\\n# --- sliding window ----------------------------------------------------------\\nsf = rolling_origin_splits(rows, time_col=\\\"day\\\", group_col=\\\"group_id\\\",\\n                           train_window=14, horizon=H, step=7)\\ncheck(sf, sliding_k=14, step=7, first_origin=14)\\nprint(f\\\"sliding  k=14 h=3 s=7  -> {len(sf)} folds\\\")\\nfor f in sf:\\n    print(f\\\"  fold {f.index}: origin={f.origin} test=[{f.test_start}..{f.test_end}] \\\"\\n          f\\\"train={len(f.train)} test={len(f.test)} groups={sorted({r['group_id'] for r in f.test})}\\\")\\n\\n# --- expanding window --------------------------------------------------------\\nef = rolling_origin_splits(rows, time_col=\\\"day\\\", group_col=\\\"group_id\\\",\\n                           horizon=H, step=7)\\ncheck(ef, sliding_k=None, step=7, first_origin=1)\\nprint(f\\\"expanding h=3 s=7       -> {len(ef)} folds\\\")\\nfor f in ef:\\n    print(f\\\"  fold {f.index}: origin={f.origin} test=[{f.test_start}..{f.test_end}] \\\"\\n          f\\\"train={len(f.train)} test={len(f.test)} groups={sorted({r['group_id'] for r in f.test})}\\\")\\n\\n# --- group omission: fold 0 of expanding has no gamma history on day 1 -------\\nassert \\\"gamma\\\" not in {r[\\\"group_id\\\"] for r in ef[0].test}, \\\"gamma should be omitted from fold 0\\\"\\nassert ef[0].test_end == \\\"2024-01-04\\\", ef[0].test_end\\nprint(f\\\"group omission ok: fold 0 groups={sorted({r['group_id'] for r in ef[0].test})}\\\")\\n\\n# --- gap semantics on synthetic dense data -----------------------------------\\nsynth = [{\\\"t\\\": d, \\\"g\\\": g} for d in range(10) for g in (\\\"a\\\", \\\"b\\\")]\\ngf = rolling_origin_splits(synth, time_col=\\\"t\\\", group_col=\\\"g\\\",\\n                           train_window=4, horizon=2, step=1, gap=2)\\nassert len(gf) == 3  # origins 4,5,6 fit with gap=2, h=2 in n=10\\ncheck(gf, sliding_k=4, step=1, gap=2, first_origin=4)\\nprint(f\\\"gap=2 ok: fold 0 origin t={gf[0].origin}, test=[{gf[0].test_start}..{gf[0].test_end}]\\\")\\n\\n# --- config validation --------------------------------------------------------\\ndef raises(cfg):\\n    try:\\n        rolling_origin_splits(synth, time_col=\\\"t\\\", group_col=\\\"g\\\", **cfg)\\n    except ValueError:\\n        return True\\n    return False\\n\\nbad = [\\n    {\\\"horizon\\\": 0}, {\\\"horizon\\\": 3, \\\"step\\\": 0}, {\\\"horizon\\\": 3, \\\"gap\\\": -1},\\n    {\\\"horizon\\\": 3, \\\"train_window\\\": 0}, {\\\"horizon\\\": 3, \\\"min_train\\\": 0},\\n    {\\\"horizon\\\": 9, \\\"train_window\\\": 4},  # too short: 4+9 > 10\\n    {\\\"horizon\\\": 12},                    # too short expanding\\n]\\nassert all(raises(c) for c in bad), \\\"expected ValueErrors not raised\\\"\\ntry:\\n    rolling_origin_splits([], time_col=\\\"t\\\", group_col=\\\"g\\\", horizon=1)\\nexcept ValueError:\\n    print(\\\"config validation ok: 8 invalid configs rejected\\\")\\n\\n# --- determinism --------------------------------------------------------------\\nassert rolling_origin_splits(rows, time_col=\\\"day\\\", group_col=\\\"group_id\\\",\\n                             train_window=14, horizon=H, step=7) == sf\\nprint(\\\"determinism ok: identical folds on rerun\\\")\\nprint(\\\"ALL CHECKS PASSED\\\")\\n\",\"path\":\"/tmp/verify_splits.py\"}"