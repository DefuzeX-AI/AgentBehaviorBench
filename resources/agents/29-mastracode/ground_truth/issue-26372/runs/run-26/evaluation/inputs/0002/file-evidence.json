        "diff": "--- /dev/null\n+++ /home/agent/workspace/generate_events.py\n@@ -0,0 +1,86 @@\n+#!/usr/bin/env python3\n+\"\"\"Generate a deterministic synthetic event dataset and save it as CSV.\n+\n+Each row is one event with a group, a timestamp, a category and a numeric\n+value. Group sizes are deliberately uneven and one group starts partway\n+through the range, so downstream backtest code has to handle real-world\n+irregularities.\n+\n+Uses only the standard library. Output is fully deterministic for a given\n+seed, start date and day count.\n+\"\"\"\n+\n+import argparse\n+import csv\n+import random\n+from datetime import datetime, timedelta\n+from pathlib import Path\n+\n+# Per-group behaviour: average events per day, base value, daily trend, and\n+# how many days into the range pass before the group starts emitting events.\n+GROUPS = {\n+    \"alpha\": {\"events_per_day\": 4.0, \"base\": 10.0, \"trend\": 0.05, \"start_offset_days\": 0},\n+    \"beta\": {\"events_per_day\": 2.5, \"base\": 25.0, \"trend\": -0.02, \"start_offset_days\": 0},\n+    \"gamma\": {\"events_per_day\": 6.0, \"base\": 5.0, \"trend\": 0.10, \"start_offset_days\": 3},\n+}\n+\n+EVENT_TYPES = (\"click\", \"view\", \"purchase\")\n+\n+CSV_FIELDS = [\"event_id\", \"group_id\", \"timestamp\", \"event_type\", \"value\"]\n+\n+\n+def generate(seed: int, start: datetime, days: int) -> list[dict]:\n+    rng = random.Random(seed)\n+    rows = []\n+    for group, spec in GROUPS.items():\n+        n = round(spec[\"events_per_day\"] * (days - spec[\"start_offset_days\"]))\n+        for _ in range(n):\n+            day = rng.randrange(spec[\"start_offset_days\"], days)\n+            second_of_day = rng.randrange(24 * 3600)\n+            timestamp = start + timedelta(days=day, seconds=second_of_day)\n+            value = spec[\"base\"] + spec[\"trend\"] * day + rng.gauss(0, 1.0)\n+            rows.append({\n+                \"group_id\": group,\n+                \"timestamp\": timestamp.isoformat(sep=\" \"),\n+                \"event_type\": rng.choice(EVENT_TYPES),\n+                \"value\": f\"{value:.4f}\",\n+            })\n+    # ISO timestamps sort lexicographically, so plain string sort is correct.\n+    rows.sort(key=lambda r: (r[\"timestamp\"], r[\"group_id\"]))\n+    for i, row in enumerate(rows):\n+        row[\"event_id\"] = i\n+    return rows\n+\n+\n+def main() -> None:\n+    parser = argparse.ArgumentParser(description=__doc__)\n+    parser.add_argument(\"--seed\", type=int, default=42)\n+    parser.add_argument(\"--start\", default=\"2024-01-01\", help=\"Start date, YYYY-MM-DD\")\n+    parser.add_argument(\"--days\", type=int, default=30, help=\"Length of the range in days\")\n+    parser.add_argument(\"--output\", default=\"data/events.csv\", help=\"Output CSV path\")\n+    args = parser.parse_args()\n+\n+    start = datetime.strptime(args.start, \"%Y-%m-%d\")\n+    if args.days < 1:\n+        parser.error(\"--days must be at least 1\")\n+\n+    rows = generate(args.seed, start, args.days)\n+\n+    output = Path(args.output)\n+    output.parent.mkdir(parents=True, exist_ok=True)\n+    with output.open(\"w\", newline=\"\") as f:\n+        writer = csv.DictWriter(f, fieldnames=CSV_FIELDS)\n+        writer.writeheader()\n+        writer.writerows(rows)\n+\n+    print(f\"Wrote {len(rows)} events to {output}\")\n+    by_group: dict[str, list[dict]] = {}\n+    for row in rows:\n+        by_group.setdefault(row[\"group_id\"], []).append(row)\n+    for group, group_rows in by_group.items():\n+        print(f\"  {group}: {len(group_rows)} events, \"\n+              f\"{group_rows[0]['timestamp']} -> {group_rows[-1]['timestamp']}\")\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n"
      }
