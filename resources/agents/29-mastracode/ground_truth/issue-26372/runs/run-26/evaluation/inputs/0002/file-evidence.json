\r\n+333,alpha,2024-01-29 11:27:25,click,12.2931\r\n+334,gamma,2024-01-29 12:08:33,purchase,7.8210\r\n+335,alpha,2024-01-29 13:01:38,click,13.3994\r\n+336,gamma,2024-01-29 13:52:48,purchase,6.6860\r\n+337,alpha,2024-01-29 14:47:44,purchase,10.5901\r\n+338,gamma,2024-01-29 18:29:10,purchase,7.7923\r\n+339,alpha,2024-01-29 18:50:39,view,11.3559\r\n+340,alpha,2024-01-29 19:33:01,view,11.4094\r\n+341,alpha,2024-01-29 20:39:24,view,11.7999\r\n+342,alpha,2024-01-29 21:14:44,view,10.9980\r\n+343,beta,2024-01-29 21:15:56,purchase,24.6273\r\n+344,alpha,2024-01-30 00:01:14,purchase,10.2087\r\n+345,gamma,2024-01-30 03:09:19,view,7.7021\r\n+346,gamma,2024-01-30 05:10:43,click,8.4609\r\n+347,gamma,2024-01-30 05:36:21,purchase,6.3121\r\n+348,gamma,2024-01-30 07:04:03,view,7.6289\r\n+349,gamma,2024-01-30 09:48:45,click,6.3939\r\n+350,beta,2024-01-30 13:39:52,view,24.5589\r\n+351,beta,2024-01-30 14:20:45,click,23.1842\r\n+352,gamma,2024-01-30 17:32:36,view,8.7189\r\n+353,gamma,2024-01-30 17:34:02,purchase,8.6417\r\n+354,gamma,2024-01-30 17:54:11,click,9.1058\r\n+355,alpha,2024-01-30 19:20:15,click,11.9157\r\n+356,alpha,2024-01-30 20:47:27,view,10.7878\r\n"
