.append(f.get(\\\"SPDXID\\\"))\\nids.append(doc.get(\\\"SPDXID\\\"))\\n\\ndups = {i for i in ids if ids.count(i) > 1}\\nif dups:\\n    errors.append(f\\\"duplicate SPDXIDs: {dups}\\\")\\nelse:\\n    print(f\\\"3. Element IDs unique and well-formed: {sorted(i for i in ids if i)}\\\")\\n\\n# Relationships reference known elements\\nknown = set(ids)\\nfor r in doc.get(\\\"relationships\\\", []):\\n    for side in (\\\"spdxElementId\\\", \\\"relatedSpdxElement\\\"):\\n        if r.get(side) not in known:\\n            errors.append(f\\\"relationship references unknown element: {r.get(side)}\\\")\\nn_rel = len(doc.get(\\\"relationships\\\", []))\\nif not errors:\\n    print(f\\\"4. All {n_rel} relationships resolve to defined elements\\\")\\n\\n# DESCRIBES + DEPENDS_ON spot checks\\nrel_triples = {(r[\\\"spdxElementId\\\"], r[\\\"relationshipType\\\"], r[\\\"relatedSpdxElement\\\"]) for r in doc.get(\\\"relationships\\\", [])}\\nfor want in [(\\\"SPDXRef-DOCUMENT\\\", \\\"DESCRIBES\\\", \\\"SPDXRef-Package-samplepkg\\\"),\\n             (\\\"SPDXRef-Package-samplepkg\\\", \\\"DEPENDS_ON\\\", \\\"SPDXRef-Package-requests\\\")]:\\n    if want not in rel_triples:\\n        errors.append(f\\\"expected relationship missing: {want}\\\")\\nif not errors:\\n    print(\\\"5. DESCRIBES (root) and DEPENDS_ON (requests) relationships present\\\")\\n\\nif errors:\\n    print(\\\"\\\\nFAILURES:\\\")\\n    for e in errors:\\n        print(f\\\"- {e}\\\")\\n    sys.exit(1)\\nprint(\\\"\\\\nVALIDATION PASSED: sbom.spdx.json is a structurally valid SPDX 2.3 document\\\")\\nEOF\"}",
