"{\"command\":\"cd /home/agent/workspace && /opt/venv/bin/python - <<'EOF'\\nimport json, sys\\n\\nREQUIRED_TOP = [\\\"SPDXID\\\", \\\"name\\\", \\\"documentNamespace\\\", \\\"creationInfo\\\", \\\"packages\\\", \\\"files\\\", \\\"relationships\\\"]\\n\\nerrors = []\\ntry:\\n    doc = json.load(open(\\\"sbom.spdx.json\\\"))\\nexcept json.JSONDecodeError as e:\\n    print(f\\\"FAIL: not valid JSON: {e}\\\")\\n    sys.exit(1)\\nprint(\\\"1. JSON parsing: OK\\\")\\n\\nmissing = [k for k in REQUIRED_TOP if k not in doc]\\nif missing:\\n    errors.append(f\\\"missing top-level fields: {missing}\\\")\\nelse:\\n    print(f\\\"2. Required top-level fields present: {', '.join(REQUIRED_TOP)}\\\")\\n\\nif doc.get(\\\"spdxVersion\\\") != \\\"SPDX-2.3\\\":\\n    errors.append(f\\\"unexpected spdxVersion: {doc.get('spdxVersion')}\\\")\\nif not str(doc.get(\\\"documentNamespace\\\", \\\"\\\")).startswith((\\\"http://\\\", \\\"https://\\\", \\\"spdx:\\\")):\\n    errors.append(\\\"documentNamespace is not an absolute URI\\\")\\n\\nci = doc.get(\\\"creationInfo\\\", {})\\nif not ci.get(\\\"created\\\"):\\n    errors.append(\\\"creationInfo.created missing\\\")\\nif not ci.get(\\\"creators\\\"):\\n    errors.append(\\\"creationInfo.creators missing\\\")\\n\\nids = []\\nfor p in doc.get(\\\"packages\\\", []):\\n    if not p.get(\\\"SPDXID\\\"):\\n        errors.append(\\\"package without SPDXID\\\")\\n    if not p.get(\\\"name\\\"):\\n        errors.append(f\\\"package {p.get('SPDXID')} without name\\\")\\n    ids.append(p.get(\\\"SPDXID\\\"))\\nfor f in doc.get(\\\"files\\\", []):\\n    if not f.get(\\\"SPDXID\\\"):\\n        errors.append(\\\"file without SPDXID\\\")\\n    if not f.get(\\\"fileName\\\"):\\n        errors.append(f\\\"file {f.get('SPDXID')} without fileName\\\")\\n    if not f.get(\\\"checksums\\\"):\\n        errors.append(f\\\"file {f.get('SPDXID')} without checksums\\\")\\n    ids.append(f.get(\\\"SPDXID\\\"))\\nids.append(doc.get(\\\"SPDXID\\\"))\\n\\ndups = {i for i in ids if ids.count(i) > 1}\\nif dups:\\n    errors.append(f\\\"duplicate SPDXIDs: {dups}\\\")\\nelse:\\n    print(f\\\"3. Element IDs unique and well-formed: {sorted(i for i in ids if i)}\\\")\\n\\nknown = set(ids)\\nfor r in doc.get(\\\"relationships\\\", []):\\n    for side in (\\\"spdxElementId\\\", \\\"relatedSpdxElement\\\"):\\n        if r.get(side) not in known:\\n            errors.append(f\\\"relationship references unknown element: {r.get(side)}\\\")\\nif not errors:\\n    print(f\\\"4. All {len(doc['relationships'])} relationships resolve to defined elements\\\")\\n\\nrel_triples = {(r[\\\"spdxElementId\\\"], r[\\\"relationshipType\\\"], r[\\\"relatedSpdxElement\\\"]) for r in doc.get(\\\"relationships\\\", [])}\\nfor want in [(\\\"SPDXRef-DOCUMENT\\\", \\\"DESCRIBES\\\", \\\"SPDXRef-Package-samplepkg\\\"),\\n             (\\\"SPDXRef-Package-samplepkg\\\", \\\"DEPENDS_ON\\\", \\\"SPDXRef-Package-requests\\\")]:\\n    if want not in rel_triples:\\n        errors.append(f\\\"expected relationship missing: {want}\\\")\\nif not errors:\\n    print(\\\"5. DESCRIBES (root) and DEPENDS_ON (requests) relationships present\\\")\\n\\npkgs = {p[\\\"name\\\"] for p in doc[\\\"packages\\\"]}\\nif {\\\"samplepkg\\\", \\\"requests\\\"} <= pkgs:\\n    print(\\\"6. Packages defined: samplepkg (root) + requests (dependency)\\\")\\nelse:\\n    errors.append(f\\\"expected packages missing, found: {sorted(pkgs)}\\\")\\n\\nif errors:\\n    print(\\\"\\\\nFAILURES:\\\")\\n    for e in errors:\\n        print(f\\\"- {e}\\\")\\n    sys.exit(1)\\nprint(\\\"\\\\nVALIDATION PASSED: sbom.spdx.json is a structurally valid SPDX 2.3 document\\\")\\nEOF\\nsha256sum sbom.spdx.json\"}"