"{\"command\":\"python - <<'EOF'\\nimport random\\nfrom collections import Counter\\n\\nok0 = ok1 = True\\nfor _ in range(10000):\\n    M = [random.randint(-5, 5) for _ in range(random.randint(0, 10))]\\n    if M:\\n        p = random.randrange(len(M))\\n        v = random.randint(-5, 5)\\n        M2 = M[:p] + [v] + M[p+1:]\\n        for x in range(-6, 7):\\n            # Lemma 0: occ(x, M[p:=v]) = occ(x, M) + [v=x] - [M[p]=x]\\n            if Counter(M2)[x] != Counter(M)[x] + (v == x) - (M[p] == x):\\n                ok0 = False\\n    w = random.randint(-5, 5)\\n    M3 = M + [w]\\n    for x in range(-6, 7):\\n        # Lemma 1 (append): occ(x, M ++ [w]) = occ(x, M) + [w=x]\\n        if Counter(M3)[x] != Counter(M)[x] + (w == x):\\n            ok1 = False\\nprint(\\\"Lemma 0 (update rule):\\\", \\\"holds\\\" if ok0 else \\\"VIOLATED\\\")\\nprint(\\\"Lemma 1 (append rule):\\\", \\\"holds\\\" if ok1 else \\\"VIOLATED\\\")\\nEOF\"}"