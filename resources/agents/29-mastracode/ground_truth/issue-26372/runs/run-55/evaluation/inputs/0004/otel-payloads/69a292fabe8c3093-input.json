"{\"command\":\"python - <<'EOF'\\nfrom collections import Counter\\nfrom sorting_verification.sort import sort_list\\n\\ndef sort_list_checked(items):\\n    result = list(items)\\n    L = list(items)\\n    msL = Counter(L)\\n    assert Counter(result) == msL                       # INV-OUT(1).A\\n    assert all(result[p] == L[p] for p in range(len(result)))  # INV-OUT(1).C\\n    for i in range(1, len(result)):\\n        key = result[i]\\n        prefix = list(result[:i])                       # b_0..b_{i-1}, sorted\\n        assert all(prefix[p] <= prefix[p+1] for p in range(len(prefix)-1))\\n        j = i - 1\\n        # OB2: INV-IN(i-1), relative to prefix\\n        hole = result[j+1]\\n        assert Counter(result) == msL - Counter({key}) + Counter({hole})   # (1)\\n        assert all(result[p] == prefix[p] for p in range(j+1))             # (2)\\n        assert all(result[p] <= result[p+1] for p in range(j))\\n        assert not result[j+2:i+1] or True                                 # (3) empty\\n        assert all(result[p] == L[p] for p in range(i+1, len(result)))     # (4)\\n        while j >= 0 and result[j] > key:\\n            result[j + 1] = result[j]\\n            j -= 1\\n            # OB3: INV-IN(j) after shift\\n            hole = result[j+1]\\n            assert Counter(result) == msL - Counter({key}) + Counter({hole})\\n            assert all(result[p] == prefix[p] for p in range(j+1))\\n            assert all(result[p] <= result[p+1] for p in range(j))\\n            disp = result[j+2:i+1]\\n            assert disp == prefix[j+1:i] and all(v > key for v in disp)    # (3)\\n            assert all(result[p] == L[p] for p in range(i+1, len(result)))\\n        # OB4: exit\\n        result[j + 1] = key\\n        assert Counter(result) == msL                                      # (A)\\n        assert all(result[p] <= result[p+1] for p in range(i))             # (B)\\n        assert all(result[p] == L[p] for p in range(i+1, len(result)))     # (C)\\n    assert Counter(result) == msL                                          # OB7\\n    assert all(result[p] <= result[p+1] for p in range(len(result)-1))\\n    return result\\n\\nimport itertools, random\\ncases = [[], [1], [2,1], [5,2,9,1,7,3], [3,3,1,2,1], [9,8,7,6,5],\\n         [-4,10,0,-9,2], list(range(20)), list(range(20,0,-1))]\\ncases += [random.sample(range(-50,50), random.randint(0,15)) for _ in range(200)]\\ncases += [list(p) for p in itertools.permutations([1,2,3,4])]\\nfor c in cases:\\n    assert sort_list_checked(c) == sort_list(c)\\nprint(\\\"all\\\", len(cases), \\\"cases: invariants hold, checked == actual\\\")\\nEOF\"}"