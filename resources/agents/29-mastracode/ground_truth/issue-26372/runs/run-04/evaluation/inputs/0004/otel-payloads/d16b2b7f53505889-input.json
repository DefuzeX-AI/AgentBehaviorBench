"{\"new_string\":\"        sql = path.read_text()\\n        try:\\n            # Scripts that manage their own BEGIN/COMMIT run as-is;\\n            # others are wrapped in an explicit transaction. executescript()\\n            # commits any pending BEGIN before running, so the wrapper must\\n            # be part of the script text itself to be atomic.\\n            if \\\"COMMIT\\\" not in sql.upper():\\n                sql = \\\"BEGIN;\\\\n\\\" + sql + \\\"\\\\nCOMMIT;\\\"\\n            con.executescript(sql)\",\"old_string\":\"        sql = path.read_text()\\n        try:\\n            # Scripts that manage their own BEGIN/COMMIT run via executescript;\\n            # others are wrapped in an explicit transaction.\\n            if \\\"COMMIT\\\" in sql.upper():\\n                con.executescript(sql)\\n            else:\\n                con.execute(\\\"BEGIN\\\")\\n                con.executescript(sql)\\n                con.commit()\",\"path\":\"scripts/run_migration.py\"}"