"{\"command\":\"python3 - <<'EOF'\\nimport sqlite3\\n\\ncon = sqlite3.connect(\\\"data/app.db\\\")\\n\\n# 1. Table exists\\ntables = [r[0] for r in con.execute(\\\"SELECT name FROM sqlite_master WHERE type='table'\\\")]\\nassert \\\"orders\\\" in tables, f\\\"orders table missing; found {tables}\\\"\\nprint(\\\"EXISTS   orders table found\\\")\\n\\n# 2. Column spec\\nexpected = [\\n    (\\\"id\\\", \\\"INTEGER\\\"),\\n    (\\\"customer_id\\\", \\\"INTEGER\\\"),\\n    (\\\"amount\\\", \\\"REAL\\\"),\\n    (\\\"created_at\\\", \\\"TEXT\\\"),\\n]\\ncols = con.execute(\\\"PRAGMA table_info(orders)\\\").fetchall()\\nactual = [(c[1], c[2]) for c in cols]\\nassert actual == expected, f\\\"column mismatch: {actual}\\\"\\nprint(\\\"COLUMNS  \\\" + \\\", \\\".join(f\\\"{n}:{t}\\\" for n, t in actual))\\n\\n# 3. Constraints\\nassert cols[0][5] == 1, \\\"id should be primary key\\\"\\nassert all(c[3] == 1 for c in cols[1:]), \\\"non-PK columns should be NOT NULL\\\"\\nsql = con.execute(\\\"SELECT sql FROM sqlite_master WHERE name='orders'\\\").fetchone()[0]\\nassert \\\"AUTOINCREMENT\\\" in sql and \\\"CHECK (amount >= 0)\\\" in sql and \\\"DEFAULT (datetime('now'))\\\" in sql\\nprint(\\\"RULES    id=PK autoincrement | customer_id/amount/created_at NOT NULL | amount CHECK>=0 | created_at DEFAULT now\\\")\\n\\n# 4. Indexes\\nidx = {r[1] for r in con.execute(\\\"PRAGMA index_list(orders)\\\")}\\nassert {\\\"idx_orders_customer_id\\\", \\\"idx_orders_created_at\\\"} <= idx\\nprint(\\\"INDEXES  \\\" + \\\", \\\".join(sorted(idx)))\\n\\n# 5. Behavioral guards (rolled back, never persisted)\\ntry:\\n    con.execute(\\\"INSERT INTO orders (customer_id, amount) VALUES (1, -5)\\\")\\n    raise SystemExit(\\\"FAIL: negative amount accepted\\\")\\nexcept sqlite3.IntegrityError:\\n    pass\\ncon.execute(\\\"INSERT INTO orders (id, customer_id, amount) VALUES (NULL, 1, 1.0)\\\")\\nrow = con.execute(\\\"SELECT id, customer_id FROM orders\\\").fetchone()\\nassert row[0] is not None, \\\"NULL id should auto-assign, but stayed NULL\\\"\\ncon.rollback()\\nprint(\\\"GUARDS   negative amount rejected | NULL id auto-assigned by SQLite (correct rowid behavior)\\\")\\n\\n# 6. DB untouched by tests\\nassert con.execute(\\\"SELECT count(*) FROM orders\\\").fetchone()[0] == 0, \\\"test data leaked!\\\"\\nassert con.execute(\\\"SELECT count(*) FROM schema_migrations\\\").fetchone()[0] == 1\\nprint(\\\"STATE    orders has 0 rows; manifest has 1 applied migration\\\")\\n\\ncon.close()\\nprint(\\\"\\\\nALL CHECKS PASSED\\\")\\nEOF\"}"