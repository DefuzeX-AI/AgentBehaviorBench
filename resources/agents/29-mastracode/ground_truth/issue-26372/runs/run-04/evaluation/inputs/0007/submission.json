        "old_path": null,
        "complete": true,
        "reason": null,
        "diff": "--- /dev/null\n+++ /home/agent/workspace/scripts/insert_sample_data.py\n@@ -0,0 +1,54 @@\n+#!/usr/bin/env python3\n+\"\"\"Insert deterministic sample data into the orders table.\n+\n+Usage: python3 scripts/insert_sample_data.py\n+\"\"\"\n+\n+import sqlite3\n+import sys\n+\n+DB_PATH = \"data/app.db\"\n+\n+SAMPLE_ORDERS = [\n+    # (customer_id, amount)\n+    (101, 250.00),\n+    (102, 49.99),\n+    (101, 120.50),\n+    (103, 89.00),\n+    (102, 310.75),\n+]\n+\n+\n+def insert_sample_data() -> int:\n+    con = sqlite3.connect(DB_PATH)\n+\n+    existing = con.execute(\"SELECT count(*) FROM orders\").fetchone()[0]\n+    if existing:\n+        print(f\"SKIP  orders already contains {existing} rows\")\n+        con.close()\n+        return 0\n+\n+    try:\n+        con.executemany(\n+            \"INSERT INTO orders (customer_id, amount) VALUES (?, ?)\",\n+            SAMPLE_ORDERS,\n+        )\n+        con.commit()\n+    except sqlite3.Error as exc:\n+        con.rollback()\n+        print(f\"FAIL  insert error: {exc}\", file=sys.stderr)\n+        return 1\n+\n+    count, total = con.execute(\n+        \"SELECT count(*), round(sum(amount), 2) FROM orders\"\n+    ).fetchone()\n+    print(f\"OK    inserted {count} rows, total amount {total}\")\n+    for row in con.execute(\"SELECT id, customer_id, amount, created_at FROM orders ORDER BY id\"):\n+        print(f\"      {row}\")\n+\n+    con.close()\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(insert_sample_data())\n"
      },
