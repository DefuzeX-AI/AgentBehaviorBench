"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Back up the SQLite database via the online backup API and verify integrity.\\n\\nUsage: python3 scripts/backup_database.py\\n\\\"\\\"\\\"\\n\\nimport sqlite3\\nimport sys\\nfrom pathlib import Path\\n\\nDB_PATH = \\\"data/app.db\\\"\\nBACKUP_PATH = Path(\\\"data/backups/app_backup.db\\\")\\n\\n\\ndef backup_database() -> int:\\n    BACKUP_PATH.parent.mkdir(parents=True, exist_ok=True)\\n\\n    src = sqlite3.connect(DB_PATH)\\n    dst = sqlite3.connect(BACKUP_PATH)\\n\\n    # Online backup API: safe with active WAL (unlike a raw file copy)\\n    src.backup(dst)\\n\\n    # Integrity of the backup copy\\n    check = dst.execute(\\\"PRAGMA integrity_check\\\").fetchone()[0]\\n    ok = check == \\\"ok\\\"\\n\\n    # Consistency: row counts and schema must match between live and backup\\n    counts_ok = True\\n    for table in (\\\"orders\\\", \\\"schema_migrations\\\"):\\n        n_src = src.execute(f\\\"SELECT count(*) FROM {table}\\\").fetchone()[0]\\n        n_dst = dst.execute(f\\\"SELECT count(*) FROM {table}\\\").fetchone()[0]\\n        if n_src != n_dst:\\n            print(f\\\"FAIL  {table}: live={n_src} backup={n_dst}\\\", file=sys.stderr)\\n            counts_ok = False\\n        else:\\n            print(f\\\"MATCH {table}: {n_src} rows in live and backup\\\")\\n\\n    src.close()\\n    dst.close()\\n\\n    if not ok:\\n        print(f\\\"FAIL  backup integrity_check: {check}\\\", file=sys.stderr)\\n        return 1\\n    print(f\\\"OK    integrity_check on backup: ok\\\")\\n\\n    if not counts_ok:\\n        return 1\\n\\n    print(f\\\"OK    backup written to {BACKUP_PATH} ({BACKUP_PATH.stat().st_size} bytes)\\\")\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(backup_database())\\n\",\"path\":\"scripts/backup_database.py\"}"