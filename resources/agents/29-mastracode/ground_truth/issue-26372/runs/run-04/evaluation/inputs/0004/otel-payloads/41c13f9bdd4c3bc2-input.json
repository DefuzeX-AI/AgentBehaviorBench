"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Apply pending SQL migrations to the local SQLite database.\\n\\nUsage: python3 scripts/run_migration.py\\n\\\"\\\"\\\"\\n\\nimport sqlite3\\nimport sys\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\n\\nDB_PATH = Path(\\\"data/app.db\\\")\\nMIGRATIONS_DIR = Path(\\\"migrations\\\")\\n\\n\\ndef ensure_schema_tracking(con: sqlite3.Connection) -> None:\\n    con.execute(\\n        \\\"\\\"\\\"\\n        CREATE TABLE IF NOT EXISTS schema_migrations (\\n            filename    TEXT PRIMARY KEY,\\n            applied_at  TEXT NOT NULL\\n        )\\n        \\\"\\\"\\\"\\n    )\\n    con.commit()\\n\\n\\ndef apply_migrations() -> int:\\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\\n    con = sqlite3.connect(DB_PATH)\\n\\n    # Durability settings\\n    con.execute(\\\"PRAGMA journal_mode = WAL\\\")\\n    con.execute(\\\"PRAGMA foreign_keys = ON\\\")\\n\\n    ensure_schema_tracking(con)\\n    applied = {row[0] for row in con.execute(\\\"SELECT filename FROM schema_migrations\\\")}\\n\\n    migrations = sorted(MIGRATIONS_DIR.glob(\\\"*.sql\\\"))\\n    if not migrations:\\n        print(f\\\"No migration scripts found in {MIGRATIONS_DIR}/\\\")\\n        return 0\\n\\n    exit_code = 0\\n    for path in migrations:\\n        if path.name in applied:\\n            print(f\\\"SKIP  {path.name} (already applied)\\\")\\n            continue\\n\\n        sql = path.read_text()\\n        try:\\n            # Scripts that manage their own BEGIN/COMMIT run via executescript;\\n            # others are wrapped in an explicit transaction.\\n            if \\\"COMMIT\\\" in sql.upper():\\n                con.executescript(sql)\\n            else:\\n                con.execute(\\\"BEGIN\\\")\\n                con.executescript(sql)\\n                con.commit()\\n\\n            con.execute(\\n                \\\"INSERT INTO schema_migrations (filename, applied_at) VALUES (?, ?)\\\",\\n                (path.name, datetime.now(timezone.utc).isoformat(timespec=\\\"seconds\\\")),\\n            )\\n            con.commit()\\n            print(f\\\"APPLY {path.name} -> OK\\\")\\n        except sqlite3.Error as exc:\\n            con.rollback()\\n            print(f\\\"FAIL  {path.name}: {exc}\\\", file=sys.stderr)\\n            exit_code = 1\\n            break\\n\\n    print(f\\\"Journal mode: {con.execute('PRAGMA journal_mode').fetchone()[0]}\\\")\\n    con.close()\\n    return exit_code\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(apply_migrations())\\n\",\"path\":\"scripts/run_migration.py\"}"