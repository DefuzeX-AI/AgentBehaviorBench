"{\"command\":\"python3 - <<'EOF'\\nimport sqlite3\\n\\ncon = sqlite3.connect(\\\"data/app.db\\\")\\n\\n# 1. Table exists\\ntables = [r[0] for r in con.execute(\\\"SELECT name FROM sqlite_master WHERE type='table'\\\")]\\nassert \\\"orders\\\" in tables, f\\\"orders table missing; found {tables}\\\"\\nprint(\\\"EXISTS   orders table found\\\")\\n\\n# 2. Column spec\\nexpected = [\\n    (\\\"id\\\", \\\"INTEGER\\\"),\\n    (\\\"customer_id\\\", \\\"INTEGER\\\"),\\n    (\\\"amount\\\", \\\"REAL\\\"),\\n    (\\\"created_at\\\", \\\"TEXT\\\"),\\n]\\ncols = con.execute(\\\"PRAGMA table_info(orders)\\\").fetchall()\\nactual = [(c[1], c[2]) for c in cols]\\nassert actual == expected, f\\\"column mismatch: {actual}\\\"\\nprint(\\\"COLUMNS  \\\" + \\\", \\\".join(f\\\"{n}:{t}\\\" for n, t in actual))\\n\\n# 3. Constraints: pk, notnull, check, default\\nassert cols[0][5] == 1, \\\"id should be primary key\\\"\\nassert all(c[3] == 1 for c in cols), \\\"all columns should be NOT NULL\\\"\\nsql = con.execute(\\\"SELECT sql FROM sqlite_master WHERE name='orders'\\\").fetchone()[0]\\nassert \\\"AUTOINCREMENT\\\" in sql, \\\"id should autoincrement\\\"\\nassert \\\"CHECK (amount >= 0)\\\" in sql, \\\"amount check constraint missing\\\"\\nassert \\\"DEFAULT (datetime('now'))\\\" in sql, \\\"created_at default missing\\\"\\nprint(\\\"RULES    id=PK autoincrement | all NOT NULL | amount CHECK>=0 | created_at DEFAULT now\\\")\\n\\n# 4. Indexes\\nidx = {r[1] for r in con.execute(\\\"PRAGMA index_list(orders)\\\")}\\nassert {\\\"idx_orders_customer_id\\\", \\\"idx_orders_created_at\\\"} <= idx, f\\\"indexes missing: {idx}\\\"\\nprint(\\\"INDEXES  \\\" + \\\", \\\".join(sorted(idx)))\\n\\n# 5. Autoincrement sequence table present (sanity for INTEGER PRIMARY KEY AUTOINCREMENT)\\nassert \\\"sqlite_sequence\\\" in tables\\nprint(\\\"SEQ      sqlite_sequence present\\\")\\n\\ncon.close()\\nprint(\\\"\\\\nALL CHECKS PASSED\\\")\\nEOF\"}"