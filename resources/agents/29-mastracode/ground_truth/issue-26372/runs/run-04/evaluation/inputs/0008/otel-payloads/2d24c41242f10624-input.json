"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Query all orders and save results to a JSON file.\\n\\nUsage: python3 scripts/query_orders.py\\n\\\"\\\"\\\"\\n\\nimport json\\nimport sqlite3\\nimport sys\\n\\nDB_PATH = \\\"data/app.db\\\"\\nEXPORT_PATH = \\\"data/orders_export.json\\\"\\n\\n\\ndef export_orders() -> int:\\n    con = sqlite3.connect(DB_PATH)\\n    rows = con.execute(\\n        \\\"SELECT id, customer_id, amount, created_at FROM orders ORDER BY id\\\"\\n    ).fetchall()\\n    con.close()\\n\\n    orders = [\\n        {\\n            \\\"id\\\": r[0],\\n            \\\"customer_id\\\": r[1],\\n            \\\"amount\\\": r[2],\\n            \\\"created_at\\\": r[3],\\n        }\\n        for r in rows\\n    ]\\n\\n    with open(EXPORT_PATH, \\\"w\\\") as f:\\n        json.dump({\\\"order_count\\\": len(orders), \\\"orders\\\": orders}, f, indent=2)\\n        f.write(\\\"\\\\n\\\")\\n\\n    print(f\\\"OK    exported {len(orders)} orders to {EXPORT_PATH}\\\")\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(export_orders())\\n\",\"path\":\"scripts/query_orders.py\"}"