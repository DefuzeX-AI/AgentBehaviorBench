"{\"command\":\"python3 - <<'EOF'\\nimport sqlite3, tempfile, os\\n\\ndb = tempfile.mktemp(suffix=\\\".db\\\")\\ncon = sqlite3.connect(db)\\nsql = open(\\\"migrations/001_create_orders.sql\\\").read()\\ncon.executescript(sql)\\ncon.execute(\\\"INSERT INTO orders (customer_id, amount) VALUES (42, 19.99)\\\")\\ncon.commit()\\nprint(\\\"columns:\\\", [(r[1], r[2]) for r in con.execute(\\\"PRAGMA table_info(orders)\\\")])\\nprint(\\\"row:\\\", tuple(con.execute(\\\"SELECT id, customer_id, amount, created_at FROM orders\\\").fetchone()))\\nprint(\\\"indexes:\\\", [r[1] for r in con.execute(\\\"PRAGMA index_list(orders)\\\")])\\ncon.close()\\nos.remove(db)\\nEOF\"}"